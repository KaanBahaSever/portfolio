# Cloudflare Pages custom headers: https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# PDF.js data files live in a folder named after the PDF.js version (integrations/pdfjs-assets.mjs).
/vendor/pdfjs/*
  Cache-Control: public, max-age=31536000, immutable

# Hidden route: keep it out of search engines (the page also sets <meta name="robots">).
# '/console' covers the redirect to the trailing-slash URL.
/console
  X-Robots-Tag: noindex, nofollow

/console/*
  X-Robots-Tag: noindex, nofollow

/tr/console
  X-Robots-Tag: noindex, nofollow

/tr/console/*
  X-Robots-Tag: noindex, nofollow
