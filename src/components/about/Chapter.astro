---
/**
 * One chapter of the journey: a mono label ("04 / 2019 – 2022 · Rocket and Space Club"),
 * a serif h3, the prose (default slot) and, beside it on wide screens, a figure (slot "figure").
 * The chapter number is a visual index only; the heading carries the meaning.
 */
import { common } from '../../i18n/messages/common';
import { getLocale } from '../../i18n/server';

interface Props {
  /** Fragment id, e.g. 'journey-avionics'; the heading gets `${id}-heading`. */
  id: string;
  /** Two-digit chapter number, e.g. '02'. */
  number: string;
  label: string;
  /**
   * Language of the label when it differs from the page's: a brand name such as "crowd.inc" is
   * set in capitals, and Turkish capitalisation would turn its i into İ.
   */
  labelLang?: string;
  /** Years shown before the label (only where the dates are known). */
  period?: { start: string; end: string };
  title: string;
}

const { id, number, label, labelLang, period, title } = Astro.props;
const t = common[getLocale(Astro)];
const headingId = `${id}-heading`;
---

<article id={id} aria-labelledby={headingId}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-14 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <div class="min-w-0">
      {/* No ligatures: JetBrains Mono would join the "++" of "C++23" into one glyph. */}
      <p
        class="label-mono flex flex-wrap items-baseline gap-x-2 gap-y-1 text-zinc-600 [font-variant-ligatures:none] dark:text-zinc-400"
      >
        <span class="text-zinc-900 dark:text-zinc-100" aria-hidden="true">{number}</span>
        <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">/</span>
        {
          period && (
            <>
              <span aria-hidden="true">
                <time datetime={period.start}>{period.start}</time> –{' '}
                <time datetime={period.end}>{period.end}</time>
              </span>
              <span class="sr-only">{t.periodSr(period.start, period.end)}</span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <span lang={labelLang}>{label}</span>
      </p>
      <h3 id={headingId} class="mt-3 font-serif text-2xl font-medium tracking-tight text-balance sm:text-3xl">
        {title}
      </h3>
      <div class="mt-5 max-w-[65ch] space-y-4 text-base leading-7 text-zinc-700 dark:text-zinc-300">
        <slot />
      </div>
    </div>
    {
      /*
       * Below lg the figure sits under the text in one column. The 28rem cap keeps the
       * 320-unit drawings at most ~1.4× their size, so hairlines stay hairlines and the figure
       * never outgrows the 65ch text above it. From lg on, the grid column sets the width.
       */
      Astro.slots.has('figure') && (
        <div class="min-w-0 max-w-md lg:max-w-none lg:pt-8">
          <slot name="figure" />
        </div>
      )
    }
  </div>
</article>
