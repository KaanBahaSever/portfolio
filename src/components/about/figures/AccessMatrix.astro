---
/**
 * Role-based access control as a matrix: four roles (rows, least privileged at the bottom) by
 * six permissions (columns: read, write and delete on public data, then the same on private
 * data). accessMatrix() computes the rows from the roles' inheritance, so every row holds the
 * row below it and more, and the granted cells form a staircase; the accent line traces its
 * edge. A dashed line separates the public columns from the private ones, which the lowest role
 * never reaches. The roles and permissions are an example, not crowd.inc's, and the caption
 * says so. Decorative; the labels are visible text, so they come in localized.
 */
import {
  RBAC_PERMISSIONS,
  RBAC_ROLES,
  accessMatrix,
  leadingRuns,
  linePath,
  type Point,
  type RbacPermission,
} from '../geometry';

interface Props {
  /** Short labels in mono capitals: the roles, the actions of the columns and the two kinds of data. */
  labels: {
    roles: Record<(typeof RBAC_ROLES)[number]['role'], string>;
    actions: { read: string; write: string; delete: string };
    scopes: { public: string; private: string };
  };
}

const { labels } = Astro.props;

const grants = accessMatrix<RbacPermission>(
  RBAC_ROLES.map((r) => r.adds),
  RBAC_PERMISSIONS,
);
const steps = leadingRuns(grants);

type Scope = 'public' | 'private';
type Action = 'read' | 'write' | 'delete';

const CELL = 20;
/** Column and row pitch. */
const COL = 34;
const ROW = 26;
/** Extra room between the public and the private columns, for the dashed boundary. */
const DIVIDE = 16;
/**
 * The matrix's top left corner. The role labels sit right-aligned to its left: the longest,
 * "YÖNETİCİ", is about 42 units wide at font size 8, which leaves the drawing centred.
 */
const X0 = 88;
const Y0 = 44;
const ROLE_X = X0 - 12;

const columns = RBAC_PERMISSIONS.map((permission, c) => {
  const [scope = 'public', action = 'read'] = permission.split('.') as [Scope, Action];
  const x = X0 + c * COL + (scope === 'private' ? DIVIDE : 0);
  return { x, mid: x + CELL / 2, scope, action };
});
const privateStart = columns.findIndex((column) => column.scope === 'private');
const lastPublic = columns[privateStart - 1];
const firstPrivate = columns[privateStart];
const divideX = lastPublic && firstPrivate ? (lastPublic.x + CELL + firstPrivate.x) / 2 : 0;

/** Rows from the top: the most privileged role first. */
const top = (role: number) => Y0 + (RBAC_ROLES.length - 1 - role) * ROW;
const rows = RBAC_ROLES.map(({ role }, i) => ({ y: top(i), label: labels.roles[role] }));
const cells = RBAC_ROLES.flatMap((_, i) =>
  columns.map((column, c) => ({ x: column.x, y: top(i), granted: grants[i]?.[c] ?? false })),
);

// The staircase: along the right edge of each row's granted run, from the bottom row up, in
// the gaps between the cells.
const halfGapX = (COL - CELL) / 2;
const halfGapY = (ROW - CELL) / 2;
const edgeX = (run: number) => (columns[run - 1]?.x ?? X0) + CELL + halfGapX;
const stairs: Point[] = steps.flatMap((run, i) => [
  { x: edgeX(run), y: top(i) + CELL + halfGapY },
  { x: edgeX(run), y: top(i) - halfGapY },
]);

const groups = (['public', 'private'] as const).map((scope) => {
  const own = columns.filter((column) => column.scope === scope);
  const left = own[0]?.x ?? 0;
  const right = (own.at(-1)?.x ?? 0) + CELL;
  return { left, right, mid: (left + right) / 2, label: labels.scopes[scope] };
});

const matrixBottom = top(0) + CELL;
const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
const label = 'text-zinc-600 dark:text-zinc-400';
---

<svg
  viewBox="0 0 320 158"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    {/* A bracket under each kind of data, spanning its three columns. */}
    {groups.map((g) => <path d={`M${g.left} 22 V18 H${g.right} V22`} />)}
    {cells.filter((cell) => !cell.granted).map((cell) => <rect x={cell.x} y={cell.y} width={CELL} height={CELL} rx="3" />)}
  </g>

  {/* The boundary between public and private data. */}
  <path
    class={ink}
    d={`M${divideX} 8 V${matrixBottom + 8}`}
    stroke="currentColor"
    stroke-width="1"
    stroke-dasharray="3 3"
  />

  <g class={ink} fill="currentColor" fill-opacity="0.8">
    {cells.filter((cell) => cell.granted).map((cell) => <rect x={cell.x} y={cell.y} width={CELL} height={CELL} rx="3" />)}
  </g>

  <path class="text-accent-600 dark:text-accent-400" d={linePath(stairs)} stroke="currentColor" stroke-width="1.5" />

  <g class={`${label} font-mono`} fill="currentColor" font-size="8" letter-spacing="0.06em">
    {groups.map((g) => <text x={g.mid} y="12" text-anchor="middle">{g.label}</text>)}
    {columns.map((column) => <text x={column.mid} y="36" text-anchor="middle">{labels.actions[column.action]}</text>)}
    {rows.map((row) => <text x={ROLE_X} y={row.y + CELL / 2 + 3} text-anchor="end">{row.label}</text>)}
  </g>
</svg>
