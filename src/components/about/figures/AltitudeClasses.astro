---
/**
 * The Rocket and Space Club's two altitude classes on one scale: an idealised flight to 5,000 ft (one
 * low-altitude rocket) and one to 10,000 ft (two high-altitude rockets), both from
 * flightProfile() with the same motor acceleration; burnForApogee() picks each burn time, so
 * each apogee lands exactly on its target line. The powered phases are drawn heavier, dots are
 * evenly spaced samples like a telemetry log, and the 10,000 ft apogee is the accent.
 * Decorative: the caption says the same in words. Tick labels and counts come in localized.
 */
import { burnForApogee, flightProfile, linePath, round, type Point } from '../geometry';
import { aboutMessages } from '../../../i18n/messages/about';
import { formatters } from '../../../i18n/format';
import { getLocale } from '../../../i18n/server';

const locale = getLocale(Astro);
const fmt = formatters(locale);
const labels = aboutMessages[locale].journey.chapters.avionics.figureLabels;

const THRUST = 4;
const GRAVITY = 1;
/** Model height units per foot: 10 units stand for 10,000 ft. */
const UNITS_PER_FOOT = 10 / 10_000;
const classes = [
  { feet: 5_000, rockets: 1 },
  { feet: 10_000, rockets: 2 },
].map((c) => ({
  ...c,
  profile: flightProfile({
    thrust: THRUST,
    burn: burnForApogee(c.feet * UNITS_PER_FOOT, THRUST, GRAVITY),
    gravity: GRAVITY,
    descentRate: 1.1,
    tau: 0.8,
    step: 0.125,
  }),
}));

const tMax = Math.max(...classes.map((c) => c.profile.samples.at(-1)?.x ?? 1));
const hMax = 10;
const origin = { x: 58, y: 158 };
const plot = { width: 248, height: 122 };
const toScreen = (p: Point): Point => ({
  x: origin.x + (p.x / tMax) * plot.width,
  y: origin.y - (p.y / hMax) * plot.height,
});

const flights = classes.map((c, i) => {
  const { samples, burnout, apogee } = c.profile;
  const screen = samples.map(toScreen);
  return {
    key: c.feet,
    high: i === classes.length - 1,
    path: linePath(screen),
    powered: linePath(samples.filter((p) => p.x <= burnout.x).map(toScreen)),
    // Every fourth sample (0.5 time units apart) stands for a logged telemetry sample.
    logged: screen.filter((_, j) => j % 4 === 0 && j > 0),
    apogee: toScreen(apogee),
    lineY: round(toScreen({ x: 0, y: c.feet * UNITS_PER_FOOT }).y),
    tick: labels.feet(fmt.number(c.feet)),
    count: labels.rockets(c.rockets),
  };
});

const xAxisEnd = origin.x + plot.width + 6;
const yAxisTop = 16;

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
const label = 'text-zinc-600 dark:text-zinc-400';
---

<svg
  viewBox="0 0 320 176"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    <path d={`M${origin.x} ${origin.y} H${xAxisEnd}`} />
    <path d={`M${xAxisEnd - 4} ${origin.y - 3} L${xAxisEnd} ${origin.y} L${xAxisEnd - 4} ${origin.y + 3}`} />
    <path d={`M${origin.x} ${origin.y} V${yAxisTop}`} />
    <path d={`M${origin.x - 3} ${yAxisTop + 4} L${origin.x} ${yAxisTop} L${origin.x + 3} ${yAxisTop + 4}`} />
    {flights.map((f) => <path d={`M${origin.x} ${f.lineY} H${origin.x + plot.width}`} stroke-dasharray="2 3" />)}
    {flights.map((f) => <path d={`M${origin.x - 3} ${f.lineY} H${origin.x}`} />)}
  </g>

  <g class={`${label} font-mono tabular-nums`} fill="currentColor" font-size="8" letter-spacing="0.02em">
    {flights.map((f) => <text x={origin.x - 6} y={f.lineY + 3} text-anchor="end">{f.tick}</text>)}
    {flights.map((f) => <text x={round(f.apogee.x) + 9} y={f.lineY - 6}>{f.count}</text>)}
  </g>

  <g class={`${ink} font-serif italic`} fill="currentColor" font-size="12">
    <text x={xAxisEnd - 4} y={origin.y + 15} text-anchor="middle">t</text>
    <text x={origin.x + 8} y={yAxisTop + 6}>h</text>
  </g>

  <g class={ink} stroke="currentColor">
    {
      flights.map((f) => (
        <>
          <path d={f.path} stroke-width="1" stroke-opacity={f.high ? 1 : 0.7} />
          <path d={f.powered} stroke-width="2.25" />
        </>
      ))
    }
  </g>

  <g class={ink} fill="currentColor" fill-opacity="0.55">
    {flights.flatMap((f) => f.logged.map((p) => <circle cx={round(p.x)} cy={round(p.y)} r="1.3" />))}
  </g>

  {
    flights.map((f) =>
      f.high ? (
        <g class="text-accent-600 dark:text-accent-400">
          <circle cx={round(f.apogee.x)} cy={round(f.apogee.y)} r="3.25" fill="currentColor" />
          <circle cx={round(f.apogee.x)} cy={round(f.apogee.y)} r="7" stroke="currentColor" stroke-width="1" />
        </g>
      ) : (
        <g class={ink}>
          <circle cx={round(f.apogee.x)} cy={round(f.apogee.y)} r="3" fill="currentColor" />
        </g>
      ),
    )
  }
</svg>
