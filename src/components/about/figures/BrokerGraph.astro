---
/**
 * Publish/subscribe fan-out: three publishers feed one broker (the accent node), which delivers
 * to five subscribers. Small squares are messages in flight, placed along the curves with
 * curvePoint() so they sit exactly on the edges. Decorative, but its three column labels are
 * visible text, so they come in localized (and match the caption's terms).
 */
import { curvePath, curvePoint, round, sCurve, type Curve, type Point } from '../geometry';

interface Props {
  /** Short labels under the publisher, broker and subscriber columns (set in mono capitals). */
  labels: { publisher: string; broker: string; subscriber: string };
}

const { labels } = Astro.props;

const broker: Point = { x: 160, y: 86 };
const publishers: Point[] = [48, 86, 124].map((y) => ({ x: 40, y }));
const subscribers: Point[] = [22, 54, 86, 118, 150].map((y) => ({ x: 280, y }));

const inbound = publishers.map((p) => sCurve({ x: p.x + 5, y: p.y }, { x: broker.x - 10, y: broker.y }));
const outbound = subscribers.map((s) => sCurve({ x: broker.x + 10, y: broker.y }, { x: s.x - 5, y: s.y }));

// A few messages in flight: two on their way in, a burst on its way out.
const inFlight: [Curve | undefined, number][] = [
  [inbound[0], 0.55],
  [inbound[2], 0.3],
  [outbound[0], 0.62],
  [outbound[2], 0.62],
  [outbound[4], 0.62],
];
const messages: Point[] = inFlight.flatMap(([curve, t]) => (curve ? [curvePoint(curve, t)] : []));

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
---

<svg
  viewBox="0 0 320 172"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    {[...inbound, ...outbound].map((curve) => <path d={curvePath(curve)} />)}
  </g>

  <g class={ink}>
    <g stroke="currentColor" stroke-width="1">
      {publishers.map((p) => <circle cx={p.x} cy={p.y} r="5" />)}
      {subscribers.map((s) => <circle cx={s.x} cy={s.y} r="4" />)}
    </g>
    <g fill="currentColor">
      {messages.map((p) => <rect x={round(p.x - 2)} y={round(p.y - 2)} width="4" height="4" rx="0.5" />)}
    </g>
  </g>

  <g class="text-accent-600 dark:text-accent-400">
    <circle cx={broker.x} cy={broker.y} r="10" stroke="currentColor" stroke-width="1.25" />
    <circle cx={broker.x} cy={broker.y} r="4" fill="currentColor" />
  </g>

  <g
    class="font-mono text-zinc-600 dark:text-zinc-400"
    fill="currentColor"
    font-size="8"
    letter-spacing="0.06em"
    text-anchor="middle"
  >
    <text x={publishers[0].x} y="166">{labels.publisher}</text>
    <text x={broker.x} y="166">{labels.broker}</text>
    <text x={subscribers[0].x} y="166">{labels.subscriber}</text>
  </g>
</svg>
