---
/**
 * A schematic 1U CubeSat on its orbit (cubesatScene() in ../cubesat.ts): a 10 cm cube drawn in
 * 3D as a line drawing (its nine visible edges), two solar cells outlined on each visible face and
 * two antenna whips on top. Below it, the Earth with a ground station at the top
 * (accent dot) and its line of sight to the satellite (dashed); the accent arc is the part of the
 * orbit the station sees at least 10° above its horizon, the dotted rest of the orbit it cannot
 * see. Not to scale; the caption says so. Decorative: the caption says in words what is drawn.
 */
import { arrowHead, linePath, round, type Point } from '../geometry';
import { EARTH, ORBIT, VIEW, cubesatScene, onCircle } from '../cubesat';

const scene = cubesatScene();
const { cube } = scene;
const closed = (points: readonly Point[]) => `${linePath(points)} Z`;

// A direction tick on the visible arc, a little before the satellite sets on the right.
const tickAngle = scene.halfAngle * 0.6;
const tick = onCircle(ORBIT, tickAngle);
const beforeTick = onCircle(ORBIT, tickAngle - 2);

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
const paper = 'fill-white dark:fill-zinc-900';
---

<svg
  viewBox={`0 0 ${VIEW.width} ${VIEW.height}`}
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    {/* The orbit where the station cannot see the satellite. */}
    <path d={linePath(scene.hiddenArc)} stroke-dasharray="1 3" />
  </g>

  <g class={ink} stroke="currentColor" stroke-width="1">
    <circle cx={EARTH.centre.x} cy={EARTH.centre.y} r={EARTH.radius} />
    {/* The station's line of sight; the cube, painted next, covers its far end. */}
    <path d={linePath(scene.link)} stroke-dasharray="2 3" />
  </g>

  <g class="text-accent-600 dark:text-accent-400" stroke="currentColor">
    <path d={linePath(scene.visibleArc)} stroke-width="1.5" />
    <path d={arrowHead(tick, { x: tick.x - beforeTick.x, y: tick.y - beforeTick.y }, 4.5)} stroke-width="1.5" />
    <circle cx={round(scene.station.x)} cy={round(scene.station.y)} r="3" fill="currentColor" stroke="none" />
  </g>

  {/* The cube: its outline filled with the panel colour, so the orbit passes behind it. */}
  <path d={closed(cube.silhouette)} class={paper} />
  <g class={ink} stroke="currentColor">
    <g stroke-width="0.75" stroke-opacity="0.55">
      {cube.faces.flatMap((face) => face.cells.map((cell) => <path d={closed(cell)} />))}
    </g>
    <g stroke-width="1.25">
      {cube.edges.map((edge) => <path d={linePath(edge)} />)}
    </g>
    <g stroke-width="1">
      {cube.whips.map((whip) => <path d={linePath(whip)} />)}
    </g>
  </g>
</svg>
