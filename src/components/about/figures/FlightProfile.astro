---
/**
 * Altitude over time for an idealised flight (see flightProfile()): the powered phase drawn
 * heavier, the coast to apogee, and the slower descent under the parachute. Dots are evenly
 * spaced samples, like a telemetry log. Apogee, where dh/dt = 0 and the recovery system acts,
 * is the one accent mark. Decorative.
 */
import { arrowHead, flightProfile, linePath, round, type Point } from '../geometry';

const profile = flightProfile({ thrust: 4, burn: 1, gravity: 1, descentRate: 1.1, tau: 0.8, step: 0.125 });
const tMax = profile.samples.at(-1)?.x ?? 1;

const origin = { x: 36, y: 146 };
const plot = { width: 262, height: 112 };
const toScreen = (p: Point): Point => ({
  x: origin.x + (p.x / tMax) * plot.width,
  y: origin.y - (p.y / profile.apogee.y) * plot.height,
});

const screen = profile.samples.map(toScreen);
const powered = profile.samples.filter((p) => p.x <= profile.burnout.x).map(toScreen);
// Every fourth point (0.5 time units apart) stands for a logged sample.
const logged = screen.filter((_, i) => i % 4 === 0);
const apogee = toScreen(profile.apogee);
const xAxisEnd = { x: 312, y: origin.y };
const yAxisEnd = { x: origin.x, y: 12 };

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
---

<svg
  viewBox="0 0 320 172"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    <path d={`M${origin.x} ${origin.y} H${xAxisEnd.x}`} />
    <path d={arrowHead(xAxisEnd, { x: 1, y: 0 })} />
    <path d={`M${origin.x} ${origin.y} V${yAxisEnd.y}`} />
    <path d={arrowHead(yAxisEnd, { x: 0, y: -1 })} />
    <path d={`M${origin.x} ${round(apogee.y)} H${round(apogee.x)}`} stroke-dasharray="2 3" />
    <path d={`M${round(apogee.x)} ${round(apogee.y)} V${origin.y}`} stroke-dasharray="1 3" />
  </g>

  <g class={`${ink} font-serif italic lining-nums`} fill="currentColor" font-size="12">
    <text x={xAxisEnd.x - 4} y={origin.y + 16} text-anchor="middle">t</text>
    <text x={origin.x - 8} y={yAxisEnd.y + 8} text-anchor="end">h</text>
    <text x={origin.x - 6} y={round(apogee.y) + 4} text-anchor="end" font-size="11">
      h<tspan font-size="7.5" dy="2.5">max</tspan>
    </text>
    <text x={round(apogee.x) + 12} y={round(apogee.y) - 10} font-size="11">dh/dt = 0</text>
  </g>

  <g class={ink} stroke="currentColor">
    <path d={linePath(screen)} stroke-width="1" />
    <path d={linePath(powered)} stroke-width="2.25" />
  </g>

  <g class={ink} fill="currentColor" fill-opacity="0.55">
    {logged.map((p) => <circle cx={round(p.x)} cy={round(p.y)} r="1.4" />)}
  </g>

  <g class="text-accent-600 dark:text-accent-400">
    <circle cx={round(apogee.x)} cy={round(apogee.y)} r="3.25" fill="currentColor" />
    <circle cx={round(apogee.x)} cy={round(apogee.y)} r="7" stroke="currentColor" stroke-width="1" />
  </g>
</svg>
