---
/**
 * A ground-station pass, seen edge-on to the orbital plane: Earth, a low circular orbit, the
 * station on the surface with its local horizon (dashed) and its elevation mask (the two lines
 * ε above the horizon), and the arc of the orbit the station can see (accent), with the CubeSat
 * on it. The arc ends are visibleHalfAngle() for the drawn radii, so the mask lines meet the
 * orbit exactly where the highlighted arc stops; only the altitude is exaggerated (about seven
 * times), which the caption says. Decorative: the caption carries the numbers.
 */
import { MIN_ELEVATION, arrowHead, linePath, round, visibleHalfAngle, type Point } from '../geometry';

/**
 * Earth's centre and the two radii, in SVG units. Not to scale. The bottom of the orbit runs off
 * the panel: the pass happens at the top, so the drawing gives that part the room.
 */
const centre: Point = { x: 160, y: 124 };
const EARTH = 72;
const ORBIT = 104;

/** The point at `angle` degrees (mathematical orientation, 90° straight up) on a circle of radius r. */
const polar = (r: number, angle: number): Point => {
  const a = (angle * Math.PI) / 180;
  return { x: centre.x + r * Math.cos(a), y: centre.y - r * Math.sin(a) };
};
const arc = (r: number, from: number, to: number, steps = 48): Point[] =>
  Array.from({ length: steps + 1 }, (_, i) => polar(r, from + ((to - from) * i) / steps));

/** The Earth-central half-angle of the visible arc, for the drawn radii and the real mask. */
const lambda = visibleHalfAngle(EARTH, ORBIT - EARTH, MIN_ELEVATION);
const station = polar(EARTH, 90);
const rise = polar(ORBIT, 90 + lambda);
const set = polar(ORBIT, 90 - lambda);

// The visible arc runs from rise (left) to set (right): the satellite moves clockwise here.
const visible = arc(ORBIT, 90 + lambda, 90 - lambda);
const hidden = arc(ORBIT, 90 - lambda, -270 + lambda, 96);

// The CubeSat, a little after rise; a direction tick a little before set.
const satellite = polar(ORBIT, 90 + lambda * 0.4);
const tickAngle = 90 - lambda * 0.55;
const tick = polar(ORBIT, tickAngle);
const beforeTick = polar(ORBIT, tickAngle + 2);

/** A small cube in isometric view, centred on `p`, edge `s`: its outline and three inner edges. */
function cube(p: Point, s: number): { outline: string; edges: string } {
  const dx = s * Math.cos(Math.PI / 6);
  const dy = s / 2;
  const top: Point = { x: p.x, y: p.y - s };
  const outline = [
    top,
    { x: p.x + dx, y: p.y - dy },
    { x: p.x + dx, y: p.y + dy },
    { x: p.x, y: p.y + s },
    { x: p.x - dx, y: p.y + dy },
    { x: p.x - dx, y: p.y - dy },
  ];
  const middle: Point = { x: p.x, y: p.y };
  return {
    outline: `${linePath(outline)} Z`,
    edges: [
      linePath([{ x: p.x - dx, y: p.y - dy }, middle, { x: p.x + dx, y: p.y - dy }]),
      linePath([middle, { x: p.x, y: p.y + s }]),
    ].join(' '),
  };
}
const sat = cube(satellite, 6);

// Angle marks: ε at the station, between the horizon and the right mask line; λ at the centre,
// between the vertical and the radius to the set point.
const epsilonArc = linePath(
  Array.from({ length: 9 }, (_, i) => {
    const a = ((MIN_ELEVATION * i) / 8) * (Math.PI / 180);
    return { x: station.x + 26 * Math.cos(a), y: station.y - 26 * Math.sin(a) };
  }),
);
// The wedge is too thin for a letter, so ε sits just above the mask line, beside its arc.
const epsilonLabel = { x: station.x + 28, y: station.y - 9 };
const lambdaArc = linePath(arc(16, 90, 90 - lambda, 12));
const lambdaLabel = polar(23, 90 - lambda / 2);

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
const paper = 'fill-white dark:fill-zinc-900';
---

<svg
  viewBox="0 0 320 200"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    {/* The orbit where the station cannot see the satellite. */}
    <path d={linePath(hidden)} stroke-dasharray="1 3" />
    {/* The station's local horizon: the tangent to Earth at the station. */}
    <path d={`M${station.x - 104} ${round(station.y)} H${station.x + 104}`} stroke-dasharray="2 3" />
    {/* Earth-central angles: the vertical through the station, and the radii to rise and set. */}
    <path d={linePath([centre, rise])} stroke-dasharray="2 3" />
    <path d={linePath([centre, set])} stroke-dasharray="2 3" />
    <path d={linePath([centre, station])} stroke-dasharray="2 3" />
    <path d={lambdaArc} />
    <path d={epsilonArc} />
  </g>

  <g class={ink} stroke="currentColor" stroke-width="1">
    <circle cx={centre.x} cy={centre.y} r={EARTH} />
    {/* The elevation mask: from the station, ε above the horizon, out to the orbit. */}
    <path d={linePath([station, rise])} />
    <path d={linePath([station, set])} />
  </g>

  <g class={`${ink} font-serif italic`} fill="currentColor" font-size="12">
    <text x={round(epsilonLabel.x)} y={round(epsilonLabel.y)}>ε</text>
    <text x={round(lambdaLabel.x)} y={round(lambdaLabel.y + 4)} text-anchor="middle">λ</text>
  </g>

  <g class="text-accent-600 dark:text-accent-400" stroke="currentColor">
    <path d={linePath(visible)} stroke-width="1.5" />
    <path d={arrowHead(tick, { x: tick.x - beforeTick.x, y: tick.y - beforeTick.y }, 4.5)} stroke-width="1.5" />
    <path d={sat.outline} stroke-width="1.25" class={paper} />
    <path d={sat.edges} stroke-width="1" />
    <circle cx={round(station.x)} cy={round(station.y)} r="3" fill="currentColor" stroke="none" />
  </g>
</svg>
