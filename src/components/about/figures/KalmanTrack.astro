---
/**
 * A Kalman filter following a rocket's altitude on the way up: the ascent of the avionics
 * figure's 10,000 ft flight (idealAscent()), noisy altimeter readings around it (dots), and the
 * estimate kalmanAltitude() makes from those readings and a noisy accelerometer (the accent
 * line). The noise comes from a fixed seed, so every build draws the same picture. An
 * illustration, not club flight data; the caption says so. Decorative.
 */
import { CONTROL_FIGURE, idealAscent, kalmanAltitude, linePath, round, type Point } from '../geometry';

const ascent = idealAscent(CONTROL_FIGURE.ascent);
const track = kalmanAltitude({
  step: CONTROL_FIGURE.ascent.step,
  altitude: ascent.altitude,
  acceleration: ascent.acceleration,
  ...CONTROL_FIGURE.kalman,
});

const tMax = ascent.time.at(-1) ?? 1;
// A little room below h = 0: on the pad, a noisy altimeter can read slightly below the ground.
const hMin = -1;
const hMax = 11;
const origin = { x: 18, y: 124 };
const plot = { width: 128, height: 100 };
const toScreen = (t: number, h: number): Point => ({
  x: origin.x + (t / tMax) * plot.width,
  y: origin.y - ((h - hMin) / (hMax - hMin)) * plot.height,
});

const truth = linePath(ascent.time.map((t, i) => toScreen(t, ascent.altitude[i] ?? 0)));
const estimate = linePath(ascent.time.map((t, i) => toScreen(t, track.estimate[i] ?? 0)));
const readings = ascent.time.map((t, i) => toScreen(t, track.measured[i] ?? 0));

const xAxisEnd = origin.x + plot.width + 8;
const yAxisTop = 12;

const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
---

<svg
  viewBox="0 0 160 140"
  class="block h-auto w-full"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g class={muted} stroke="currentColor" stroke-width="1">
    <path d={`M${origin.x} ${origin.y} H${xAxisEnd}`} />
    <path d={`M${xAxisEnd - 4} ${origin.y - 3} L${xAxisEnd} ${origin.y} L${xAxisEnd - 4} ${origin.y + 3}`} />
    <path d={`M${origin.x} ${origin.y} V${yAxisTop}`} />
    <path d={`M${origin.x - 3} ${yAxisTop + 4} L${origin.x} ${yAxisTop} L${origin.x + 3} ${yAxisTop + 4}`} />
  </g>

  <g class={`${ink} font-serif italic`} fill="currentColor" font-size="12">
    <text x={xAxisEnd - 4} y={origin.y + 14} text-anchor="middle">t</text>
    <text x={origin.x + 7} y={yAxisTop + 6}>h</text>
  </g>

  <path class={ink} d={truth} stroke="currentColor" stroke-width="1" stroke-opacity="0.7" />

  <g class={ink} fill="currentColor" fill-opacity="0.55">
    {readings.map((p) => <circle cx={round(p.x)} cy={round(p.y)} r="1.5" />)}
  </g>

  <path class="text-accent-600 dark:text-accent-400" d={estimate} stroke="currentColor" stroke-width="1.5" />
</svg>
