---
/**
 * A two-ply minimax tree: the maximiser (▲) chooses among three replies of the minimiser (▽),
 * each backed up from two leaf scores. The values and the highlighted line are computed by
 * minimax() itself, so the picture is a real search, not a drawing of one. Decorative.
 */
import { minimax } from '../geometry';

/** The minimiser's replies, each with the scores of the two positions that can follow. */
const tree: readonly (readonly number[])[] = [
  [3, 12],
  [2, 8],
  [14, 5],
];
const root = { x: 92, y: 26 };
const MIN_Y = 80;
const LEAF_Y = 128;
const minX = [44, 92, 140];
const LEAF_SPREAD = 12;

const best = minimax(tree, true);
const [bestMove = 0, bestReply = 0] = best.line;

const branches = tree.map((leaves, i) => {
  const reply = minimax(leaves, false);
  return {
    x: minX[i] ?? 0,
    value: reply.value,
    chosen: i === bestMove,
    leaves: leaves.map((score, j) => ({
      x: (minX[i] ?? 0) + (j === 0 ? -LEAF_SPREAD : LEAF_SPREAD),
      score,
      chosen: i === bestMove && j === bestReply,
    })),
  };
});

/** An equilateral-ish triangle centred on (x, y), pointing up (max) or down (min). */
function triangle(x: number, y: number, up: boolean, r = 6): string {
  const h = r * 0.9;
  return up
    ? `M${x} ${y - h} L${x + r} ${y + h} L${x - r} ${y + h} Z`
    : `M${x} ${y + h} L${x + r} ${y - h} L${x - r} ${y - h} Z`;
}
const ink = 'text-zinc-900 dark:text-zinc-100';
const muted = 'text-zinc-400 dark:text-zinc-600';
const accent = 'text-accent-600 dark:text-accent-400';
---

<svg viewBox="0 0 164 164" class="block h-auto w-full" fill="none" aria-hidden="true" focusable="false">
  <g class="font-mono text-zinc-500" fill="currentColor" font-size="8" letter-spacing="0.06em">
    <text x="4" y={root.y + 3}>MAX</text>
    <text x="4" y={MIN_Y + 3}>MIN</text>
  </g>

  {/* Edges: the principal variation is drawn last, in the accent colour. */}
  <g class={muted} stroke="currentColor" stroke-width="1">
    {
      branches.map((branch) => (
        <>
          {!branch.chosen && <line x1={root.x} y1={root.y + 7} x2={branch.x} y2={MIN_Y - 7} />}
          {branch.leaves.map(
            (leaf) => !leaf.chosen && <line x1={branch.x} y1={MIN_Y + 7} x2={leaf.x} y2={LEAF_Y - 4} />,
          )}
        </>
      ))
    }
  </g>

  <g class={ink} stroke="currentColor" stroke-width="1" stroke-linejoin="round">
    {branches.map((branch) => !branch.chosen && <path d={triangle(branch.x, MIN_Y, false)} />)}
    {branches.flatMap((branch) => branch.leaves.filter((leaf) => !leaf.chosen).map((leaf) => <circle cx={leaf.x} cy={LEAF_Y} r="2.5" />))}
  </g>

  <g class={`${ink} font-mono`} fill="currentColor" font-size="9" text-anchor="middle">
    {branches.flatMap((branch) => branch.leaves.filter((leaf) => !leaf.chosen).map((leaf) => <text x={leaf.x} y={LEAF_Y + 16}>{leaf.score}</text>))}
    {branches.map((branch) => !branch.chosen && <text x={branch.x + 12} y={MIN_Y + 3} text-anchor="start" fill-opacity="0.6">{branch.value}</text>)}
  </g>

  <g class={accent}>
    {
      branches
        .filter((branch) => branch.chosen)
        .map((branch) => (
          <>
            <g stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
              <line x1={root.x} y1={root.y + 7} x2={branch.x} y2={MIN_Y - 7} />
              <path d={triangle(root.x, root.y, true)} fill="currentColor" />
              <path d={triangle(branch.x, MIN_Y, false)} fill="currentColor" />
              {branch.leaves
                .filter((leaf) => leaf.chosen)
                .map((leaf) => (
                  <>
                    <line x1={branch.x} y1={MIN_Y + 7} x2={leaf.x} y2={LEAF_Y - 4} />
                    <circle cx={leaf.x} cy={LEAF_Y} r="2.5" fill="currentColor" />
                  </>
                ))}
            </g>
            <g class="font-mono" fill="currentColor" font-size="9" text-anchor="middle">
              <text x={root.x + 12} y={root.y + 3} text-anchor="start">{best.value}</text>
              <text x={branch.x + 12} y={MIN_Y + 3} text-anchor="start">{branch.value}</text>
              {branch.leaves
                .filter((leaf) => leaf.chosen)
                .map((leaf) => (
                  <text x={leaf.x} y={LEAF_Y + 16}>{leaf.score}</text>
                ))}
            </g>
          </>
        ))
    }
  </g>
</svg>
