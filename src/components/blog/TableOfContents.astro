---
/**
 * A post's table of contents: one collapsible "Contents" block between the post's header and its
 * body, at every width (the reading column has nothing beside it).
 *
 * - Native <details>/<summary>: Enter or Space opens it, assistive technology announces it as
 *   expanded or collapsed, and it works without JavaScript. The <nav> goes around the
 *   disclosure, so the landmark stays in the page's landmark list while the list is closed.
 * - Closed by default. The article is what the reader came for: the long posts list 15 to 17
 *   headings, which open would fill more than a phone screen before the first paragraph. The
 *   summary says how many entries there are, so the outline's size is clear before opening it.
 * - Entries are numbered like the post's structure: sections 1, 2, 3 and their subsections 1.1,
 *   1.2. The numbers are visual only (aria-hidden); the nested ordered lists give screen readers
 *   the same structure.
 * - It stays open after a link is followed, so going back (or scrolling up) returns to the list.
 *   There is no marker for the section being read: the list sits above the article, out of view
 *   while reading, so a scroll listener would update a highlight nobody sees.
 */
import { countEntries, type TocEntry } from './toc';
import { blogMessages } from '../../i18n/messages/blog';
import { getLocale } from '../../i18n/server';

interface Props {
  entries: TocEntry[];
  /** lang of the heading texts, when it differs from the element around the list. */
  contentLang?: string;
  /** lang of the label, when the component sits inside an article in another language. */
  lang?: string;
  class?: string;
}

const { entries, contentLang, lang, class: className } = Astro.props;
const m = blogMessages[getLocale(Astro)].post;
const labelId = 'toc-label';

// Rows are compact for a mouse and at least 44 px tall for touch: taller padding (12 + 20 + 12),
// not centring, so a title that wraps keeps its number on its first line. The number column
// (w-10) is wide enough for "10.10"; subsection lists are indented by that column plus the gap
// (ps-12), so their numbers line up under their section's title.
const row =
  'flex gap-2 rounded-lg px-2 py-2 text-sm leading-snug text-zinc-700 transition-colors hover:bg-zinc-100 hover:text-zinc-950 pointer-coarse:min-h-11 pointer-coarse:py-3 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-50';
const number = 'w-10 shrink-0 font-mono text-xs leading-5 text-zinc-500 tabular-nums dark:text-zinc-400';
---

<nav aria-labelledby={labelId} lang={lang} class={className}>
  <details class="group rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
    <summary
      class="flex min-h-12 list-none items-center gap-3 rounded-xl px-4 transition-colors hover:bg-zinc-50 dark:hover:bg-zinc-800/60 [&::-webkit-details-marker]:hidden"
    >
      {/* The spaces keep "Contents" and the count apart in the summary's accessible name. */}
      <span id={labelId} class="label-mono text-zinc-700 dark:text-zinc-300">{m.contents}</span>{' '}
      <span class="text-sm text-zinc-600 tabular-nums dark:text-zinc-400">
        <span aria-hidden="true" class="me-1 text-zinc-400 dark:text-zinc-600">·</span>{' '}
        {m.contentsCount(countEntries(entries))}
      </span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="ms-auto size-4 shrink-0 text-zinc-500 transition-transform duration-200 group-open:rotate-180 dark:text-zinc-400"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <ol lang={contentLang} class="border-t border-zinc-200 px-2 py-2 dark:border-zinc-800">
      {
        entries.map((entry, index) => (
          <li>
            <a href={`#${entry.slug}`} class={row}>
              <span aria-hidden="true" class={number}>
                {index + 1}
              </span>
              <span class="min-w-0">{entry.text}</span>
            </a>
            {entry.children.length > 0 && (
              <ol class="ps-12">
                {entry.children.map((child, childIndex) => (
                  <li>
                    <a href={`#${child.slug}`} class={row}>
                      <span aria-hidden="true" class={number}>
                        {`${index + 1}.${childIndex + 1}`}
                      </span>
                      <span class="min-w-0">{child.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))
      }
    </ol>
  </details>
</nav>
