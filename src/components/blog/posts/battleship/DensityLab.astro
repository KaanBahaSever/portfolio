---
/**
 * The density lab: a board where the reader marks misses, hits and sunk cells, ticks off sunk
 * ships, and watches the game's probability density (the Hard computer's aim) update. The page
 * is rendered with the empty-board density, so it reads correctly before (or without) the script;
 * density-lab.ts then keeps it live. All state lives in a closure per [data-density-lab] root.
 *
 * The board follows the ARIA grid pattern of the game's boards: one Tab stop, arrow keys to move,
 * Enter or Space to mark; each cell button's name says its coordinate, state and density.
 */
import type { Locale } from '../../../../i18n/config.ts';
import { formatters } from '../../../../i18n/format.ts';
import { COLUMN_LETTERS, coordinateLabel } from '../../../../lib/games/battleship/rules.ts';
import { gameUi } from '../../../games/styles.ts';
import { ui } from '../../../ui/styles.ts';
import { battleshipPostMessages } from './messages.ts';
import { BOARD_SIZE, FLEET, densityMap, knowledgeOf } from './model.ts';
import { weightDigits, weightFormula } from './format.ts';

interface Props {
  lang: Locale;
  /** Prefix for element ids; give each instance on a page its own. */
  id?: string;
}

const { lang, id = 'density-lab' } = Astro.props;
const m = battleshipPostMessages[lang];
const f = formatters(lang);
const TOOLS = ['miss', 'hit', 'sunk', 'clear'] as const;

// The initial render: an empty board.
const map = densityMap(knowledgeOf({}));
const peakSet = new Set(map.peaks);
const lines = Array.from({ length: BOARD_SIZE }, (_, i) => i);
const ids = { help: `${id}-help` };
const listedPeaks = (peaks: readonly number[]) =>
  peaks.length > 4
    ? f.list([...peaks.slice(0, 3).map((c) => coordinateLabel(c)), m.lab.more(peaks.length - 3)])
    : f.list(peaks.map((c) => coordinateLabel(c)));
const cellLabel = (index: number) =>
  m.lab.cell(coordinateLabel(index), m.cellState.unknown, f.number(map.density[index] ?? 0), peakSet.has(index));
---

<figure class="bs-figure not-prose my-10">
  <section
    data-density-lab
    data-lang={lang}
    aria-label={m.lab.region}
    class="rounded-xl border border-zinc-200 bg-white p-2 min-[22rem]:p-3 sm:p-5 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_13rem] md:gap-6">
      <div class="min-w-0">
        <fieldset class="min-w-0">
          <legend class={gameUi.legend}>{m.lab.tool}</legend>
          <div class:list={[gameUi.segmented, 'grid-cols-4']}>
            {
              TOOLS.map((tool, i) => (
                <label class={gameUi.segment}>
                  <input type="radio" class="sr-only" name={`${id}-tool`} value={tool} checked={i === 0} data-tool />
                  {m.lab.tools[tool]}
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="lab-board mt-4" data-lab-board>
          <div class="corner" aria-hidden="true"></div>
          <div class="columns" aria-hidden="true">
            {lines.map((col) => <span>{COLUMN_LETTERS[col]}</span>)}
          </div>
          <div class="rows" aria-hidden="true">
            {lines.map((row) => <span>{row + 1}</span>)}
          </div>
          <div role="grid" aria-label={m.lab.grid} aria-describedby={ids.help} class="cells" data-grid>
            {
              lines.map((row) => (
                <div role="row" class="row">
                  {lines.map((col) => {
                    const index = row * BOARD_SIZE + col;
                    const level = (map.density[index] ?? 0) / map.max;
                    return (
                      <div role="gridcell" class="gridcell">
                        <button
                          type="button"
                          class="cell"
                          data-cell={index}
                          data-peak={peakSet.has(index) ? '' : undefined}
                          tabindex={index === 0 ? 0 : -1}
                          aria-label={cellLabel(index)}
                          style={`--heat:${level.toFixed(4)}`}
                        >
                          <span class="heat" />
                          <span class="mark" />
                        </button>
                      </div>
                    );
                  })}
                </div>
              ))
            }
          </div>
        </div>
        <p id={ids.help} class={gameUi.hint}>{m.lab.help}</p>
      </div>

      <div class="flex min-w-0 flex-col gap-5">
        <fieldset class="min-w-0">
          <legend class={gameUi.legend}>{m.lab.fleet}</legend>
          <ul class="mt-1 grid grid-cols-1 gap-x-4 min-[26rem]:grid-cols-2 md:grid-cols-1">
            {
              FLEET.map((ship) => (
                <li>
                  <label class={gameUi.toggle}>
                    <input type="checkbox" class={gameUi.checkbox} value={ship.id} checked data-ship />
                    <span class="min-w-0 flex-1">{m.ships[ship.id]}</span>
                    <span class="font-mono text-xs text-zinc-500 tabular-nums dark:text-zinc-400">
                      <span aria-hidden="true">{ship.length}</span>
                      <span class="sr-only">{m.fleet.cellsCount(ship.length)}</span>
                    </span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <dl class="grid gap-3 text-sm">
          <div>
            <dt class={gameUi.legend}>{m.lab.best}</dt>
            <dd class="mt-1 font-mono text-zinc-900 tabular-nums dark:text-zinc-100" data-best>
              {m.lab.bestValue(listedPeaks(map.peaks), f.number(map.max))}
            </dd>
          </div>
          <div>
            <dt class={gameUi.legend}>{m.lab.inspect}</dt>
            <dd class="mt-1 font-mono text-zinc-900 tabular-nums dark:text-zinc-100" data-inspect>
              {m.lab.inspectValue(coordinateLabel(0), weightFormula(weightDigits(map.density[0] ?? 0, map.weight), map.weight, f))}
            </dd>
          </div>
          <div>
            <dt class={gameUi.legend}>{m.lab.weight}</dt>
            <dd class="mt-1 font-mono text-zinc-900 tabular-nums dark:text-zinc-100" data-weight>
              w = {f.number(map.weight)}
            </dd>
          </div>
        </dl>

        <button type="button" class:list={[ui.buttonSecondary, 'w-full']} data-reset>
          {m.lab.reset}
        </button>
      </div>
    </div>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-status></p>
  </section>
  <figcaption class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><slot /></figcaption>
</figure>

<script>
  import { initDensityLab } from './density-lab.ts';

  document.querySelectorAll<HTMLElement>('[data-density-lab]').forEach(initDensityLab);
</script>

<style>
  .lab-board {
    --sea: white;
    --miss: var(--color-zinc-500);
    --hit: var(--color-rose-600);
    --heat-color: var(--color-accent-500);
    --heat-strength: 0.6;
    --peak: var(--color-zinc-900);
    --hover: var(--color-zinc-500);
    --graph-line-strong: color-mix(in oklab, var(--color-zinc-900) 17%, transparent);
    --label: var(--color-zinc-600);
    --frame: var(--color-zinc-300);

    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    grid-template-rows: 1.25rem auto;
    gap: 0.25rem;
    width: 100%;
    max-width: 30rem;
  }

  @media (min-width: 40rem) {
    .lab-board {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      grid-template-rows: 1.5rem auto;
    }
  }

  /* Dark theme: the visitor's choice, or the OS preference when JavaScript is off (global.css). */
  :global(:where([data-theme='dark'])) .lab-board {
    --sea: var(--color-zinc-950);
    --miss: var(--color-zinc-400);
    --hit: var(--color-rose-400);
    --heat-color: var(--color-accent-400);
    --heat-strength: 0.45;
    --peak: white;
    --hover: var(--color-zinc-400);
    --graph-line-strong: color-mix(in oklab, white 15%, transparent);
    --label: var(--color-zinc-400);
    --frame: var(--color-zinc-700);
  }

  @media (prefers-color-scheme: dark) {
    :global(:where(:root:not([data-theme]))) .lab-board {
      --sea: var(--color-zinc-950);
      --miss: var(--color-zinc-400);
      --hit: var(--color-rose-400);
      --heat-color: var(--color-accent-400);
      --heat-strength: 0.45;
      --peak: white;
      --hover: var(--color-zinc-400);
      --graph-line-strong: color-mix(in oklab, white 15%, transparent);
      --label: var(--color-zinc-400);
      --frame: var(--color-zinc-700);
    }
  }

  .columns,
  .rows {
    display: grid;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--label);
    user-select: none;
  }

  .columns {
    grid-template-columns: repeat(10, minmax(0, 1fr));
    align-items: end;
    justify-items: center;
    padding-bottom: 0.125rem;
  }

  .rows {
    grid-template-rows: repeat(10, minmax(0, 1fr));
    align-items: center;
    justify-items: end;
    padding-right: 0.25rem;
  }

  .cells {
    display: grid;
    grid-template-rows: repeat(10, minmax(0, 1fr));
    aspect-ratio: 1;
    border: 1px solid var(--frame);
    border-radius: 0.375rem;
    background-color: var(--sea);
    background-image:
      linear-gradient(to right, var(--graph-line-strong) 1px, transparent 1px),
      linear-gradient(to bottom, var(--graph-line-strong) 1px, transparent 1px);
    background-size: 10% 10%;
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
  }

  .gridcell {
    position: relative;
    min-width: 0;
  }

  .cell {
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    touch-action: manipulation;
  }

  .cell:focus-visible {
    z-index: 2;
    outline-offset: -2px;
  }

  .heat,
  .mark {
    position: absolute;
    pointer-events: none;
  }

  .heat {
    inset: 1px;
    background-color: var(--heat-color);
    opacity: calc(var(--heat, 0) * var(--heat-strength));
    transition: opacity 200ms ease-out;
  }

  @media (hover: hover) {
    .cell:hover {
      box-shadow: inset 0 0 0 1.5px var(--hover);
    }
  }

  .cell[data-peak]::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1.5px dashed var(--peak);
    border-radius: 3px;
    pointer-events: none;
  }

  /* Miss: an ink dot. */
  .cell[data-state='miss'] .mark {
    left: 50%;
    top: 50%;
    width: 22%;
    height: 22%;
    margin: -11% 0 0 -11%;
    border-radius: 9999px;
    background-color: var(--miss);
  }

  /* Hit and sunk: a cross; sunk cells also get a hatched fill, like the game's sunk ships. */
  .cell[data-state='hit'] .mark,
  .cell[data-state='sunk'] .mark {
    inset: 0;
  }

  .cell[data-state='hit'] .mark::before,
  .cell[data-state='hit'] .mark::after,
  .cell[data-state='sunk'] .mark::before,
  .cell[data-state='sunk'] .mark::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background-color: var(--hit);
    transform: rotate(45deg);
  }

  .cell[data-state='hit'] .mark::after,
  .cell[data-state='sunk'] .mark::after {
    transform: rotate(-45deg);
  }

  .cell[data-state='sunk'] {
    background-image: repeating-linear-gradient(
      135deg,
      color-mix(in oklab, currentColor 30%, transparent) 0 1px,
      transparent 1px 5px
    );
  }

  .cell[data-state] .mark {
    animation: lab-pop 200ms ease-out;
  }

  @keyframes lab-pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }
</style>
