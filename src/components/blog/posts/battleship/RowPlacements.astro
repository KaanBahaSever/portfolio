---
/**
 * One row of the board with every horizontal position of a cruiser (L = 3), as the game's
 * allPlacements() lists them: the n − L + 1 starting columns j = 0 … n − L, one strip each, and
 * under each column c the number f_L(c) of those positions that cover it. The highlighted column
 * shows which positions a single cell collects.
 *
 * The counting section of the post derives these numbers in closed form; the build fails if the
 * game's placements ever stop matching them (n − L + 1 positions per row and n(n − L + 1) in all,
 * f_L(c) = min(c, n − L) − max(0, c − L + 1) + 1, Σ_c f_L(c) = L(n − L + 1)), or if the
 * highlighted column stops being covered by the starts the captions name.
 *
 * Its few strings live here rather than in messages.ts: they belong to this figure alone.
 */
import type { Locale, Localized } from '../../../../i18n/config.ts';
import { formatters } from '../../../../i18n/format.ts';
import { allPlacements, colOf, placementCells, rowOf } from '../../../../lib/games/battleship/rules.ts';
import Figure from './Figure.astro';
import { BOARD_SIZE, FLEET } from './model.ts';

interface Props {
  lang: Locale;
}

const en = {
  aria: (positions: number, length: number, last: number, counts: string, column: number, starts: string) =>
    `One row of the board: the ${positions} horizontal positions of a ship ${length} cells long, one for each starting column j = 0, 1, …, ${last}. Under each column c, the number of positions that cover it: ${counts}. Column ${column}, highlighted, is covered by the positions that start at columns ${starts}.`,
};
type RowPlacementsMessages = typeof en;
const tr: RowPlacementsMessages = {
  aria: (positions, length, last, counts, column, starts) =>
    `Tahtanın tek bir satırı: ${length} hücrelik bir geminin bu satırdaki ${positions} yatay konumu; j = 0, 1, …, ${last} başlangıç sütunlarının her biri için bir tane. Her c sütununun altında o sütunu kaplayan konumların sayısı yazılı: ${counts}. Vurgulanan ${column} numaralı sütunu, ${starts} numaralı sütunlarda başlayan konumlar kaplıyor.`,
};
const messages = { en, tr } as const satisfies Localized<RowPlacementsMessages>;

const { lang } = Astro.props;
const m = messages[lang];
const f = formatters(lang);

const n = BOARD_SIZE;
const ship = FLEET.find((spec) => spec.id === 'cruiser');
if (!ship) throw new Error('RowPlacements: the fleet has no cruiser');
const L = ship.length;
/** The column the figure and its captions single out ("column 4 … j = 2, 3 and 4"). */
const COLUMN = 4;
const EXPECTED_STARTS = [2, 3, 4];

const horizontal = allPlacements(ship, n).filter((p) => p.orientation === 'horizontal');
const inRow = horizontal.filter((p) => rowOf(p.start, n) === 0);
const starts = inRow.map((p) => colOf(p.start, n)).sort((a, b) => a - b);
const cover = Array.from({ length: n }, (_, c) =>
  inRow.filter((p) => placementCells(p, n).some((index) => colOf(index, n) === c)).length,
);
const closedForm = (c: number) => Math.min(c, n - L) - Math.max(0, c - L + 1) + 1;
const covering = inRow
  .filter((p) => placementCells(p, n).some((index) => colOf(index, n) === COLUMN))
  .map((p) => colOf(p.start, n))
  .sort((a, b) => a - b);

if (starts.length !== n - L + 1 || starts.some((j, i) => j !== i)) {
  throw new Error('RowPlacements: a row should hold n − L + 1 positions, starting at j = 0 … n − L');
}
if (horizontal.length !== n * (n - L + 1)) throw new Error('RowPlacements: expected n(n − L + 1) horizontal positions');
if (cover.some((count, c) => count !== closedForm(c))) throw new Error('RowPlacements: f_L(c) differs from its closed form');
if (cover.reduce((sum, count) => sum + count, 0) !== L * (n - L + 1)) throw new Error('RowPlacements: Σ f_L(c) ≠ L(n − L + 1)');
if (covering.join() !== EXPECTED_STARTS.join()) throw new Error('RowPlacements: the highlighted column changed');

const label = m.aria(
  starts.length,
  L,
  n - L,
  f.list(cover.map((count) => f.number(count))),
  COLUMN,
  f.list(covering.map((j) => f.number(j))),
);

/* Geometry, in SVG units: row labels on the left, one strip per position, the counts below. */
const LABEL = 46;
const CELL = 24;
const STRIP = 18;
const PITCH = 24;
const TOP = 18;
const left = LABEL;
const right = LABEL + n * CELL;
const rowsBottom = TOP + starts.length * PITCH - (PITCH - STRIP);
const ruleY = rowsBottom + 7;
const countY = ruleY + 16;
const width = right + 2;
const height = countY + 6;
const cx = (c: number) => left + c * CELL + CELL / 2;
---

<Figure class="max-w-sm">
  <svg
    slot="graphic"
    class="block h-auto w-full text-zinc-900 dark:text-zinc-100"
    viewBox={`0 0 ${width} ${height}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={label}
    focusable="false"
  >
    {/* The highlighted column: a faint accent band behind every strip, down to its count. */}
    <rect
      class="fill-accent-500 dark:fill-accent-400"
      fill-opacity="0.14"
      x={left + COLUMN * CELL}
      y={TOP - 13}
      width={CELL}
      height={countY + 5 - (TOP - 13)}
      rx="3"
    />

    {/* Column indices c = 0 … n − 1, counted from zero as in the text. */}
    <g class="font-mono" font-size="9" text-anchor="middle">
      <text class="fill-zinc-500 dark:fill-zinc-400" x={left - 10} y={TOP - 5} text-anchor="end">
        <tspan class="font-serif italic" font-size="11">c</tspan>
      </text>
      {
        Array.from({ length: n }, (_, c) => (
          <text
            class:list={[
              c === COLUMN ? 'fill-accent-700 font-medium dark:fill-accent-400' : 'fill-zinc-500 dark:fill-zinc-400',
            ]}
            x={cx(c)}
            y={TOP - 5}
          >
            {f.number(c)}
          </text>
        ))
      }
    </g>

    {
      starts.map((j, i) => {
        const y = TOP + i * PITCH;
        return (
          <g>
            <text class="fill-zinc-600 font-mono dark:fill-zinc-400" font-size="9.5" x={left - 10} y={y + STRIP / 2 + 3.5} text-anchor="end">
              {/* One expression, so the HTML compressor cannot drop the space after the variable. */}
              <tspan class="font-serif italic" font-size="11">j</tspan>{` = ${f.number(j)}`}
            </text>
            <rect x={left} y={y} width={n * CELL} height={STRIP} rx="2" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="0.75" />
            {Array.from({ length: n - 1 }, (_, k) => (
              <line x1={left + (k + 1) * CELL} y1={y} x2={left + (k + 1) * CELL} y2={y + STRIP} stroke="currentColor" stroke-opacity="0.12" stroke-width="0.75" />
            ))}
            <rect
              x={left + j * CELL + 2.5}
              y={y + 2.5}
              width={L * CELL - 5}
              height={STRIP - 5}
              rx={(STRIP - 5) / 2}
              fill="currentColor"
              fill-opacity="0.08"
              stroke="currentColor"
              stroke-opacity="0.75"
              stroke-width="1.25"
            />
            {Array.from({ length: L - 1 }, (_, k) => (
              <line
                x1={left + (j + k + 1) * CELL}
                y1={y + 5.5}
                x2={left + (j + k + 1) * CELL}
                y2={y + STRIP - 5.5}
                stroke="currentColor"
                stroke-opacity="0.35"
              />
            ))}
          </g>
        );
      })
    }

    <line x1={left} y1={ruleY} x2={right} y2={ruleY} stroke="currentColor" stroke-opacity="0.45" stroke-width="0.75" />

    {/* f_L(c): how many of the positions above cover column c. */}
    <g class="font-mono" font-size="10.5" text-anchor="middle">
      <text class="fill-zinc-600 dark:fill-zinc-400" x={left - 10} y={countY} text-anchor="end">
        <tspan class="font-serif italic" font-size="11.5">f</tspan><tspan font-size="7.5" dy="2.5">{f.number(L)}</tspan><tspan dy="-2.5" font-size="10.5">(</tspan><tspan class="font-serif italic" font-size="11.5">c</tspan><tspan font-size="10.5">)</tspan>
      </text>
      {
        cover.map((count, c) => (
          <text
            class:list={[c === COLUMN ? 'fill-accent-700 font-semibold dark:fill-accent-400' : 'fill-current']}
            x={cx(c)}
            y={countY}
          >
            {f.number(count)}
          </text>
        ))
      }
    </g>
  </svg>
  <slot />
</Figure>
