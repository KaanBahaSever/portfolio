---
/**
 * The frame shared by the fusion post's figures: a hairline card over faint graph paper, the
 * drawing, an optional legend, and the caption written in the MDX (the default slot), so captions
 * can use Markdown and math. The post page numbers captions itself ("Fig. 3" / "Şekil 3",
 * post-prose.css). Same frame as the Battleship post's figures.
 *
 * not-prose: the drawings bring their own typography; the caption is styled here to match the
 * captions of ordinary Markdown figures.
 */
interface Props {
  /** Extra classes for the drawing area (e.g. a max width for small diagrams). */
  class?: string;
  id?: string;
}

const { class: className, id } = Astro.props;
---

<figure id={id} class="fusion-figure not-prose my-10">
  <div
    class="relative overflow-hidden rounded-xl border border-zinc-200 bg-white px-2 py-5 sm:px-6 sm:py-6 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <div aria-hidden="true" class="bg-graph mask-fade-b pointer-events-none absolute inset-0"></div>
    <div class:list={['relative mx-auto', className]}>
      <slot name="graphic" />
    </div>
    {Astro.slots.has('legend') && <div class="relative mx-auto mt-4"><slot name="legend" /></div>}
  </div>
  <figcaption class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><slot /></figcaption>
</figure>
