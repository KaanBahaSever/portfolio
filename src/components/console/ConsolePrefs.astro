---
/**
 * Pre-paint script for the console page's <head> (render it with slot="head"): applies the saved
 * font size and phosphor colour before the first frame, so the terminal never flashes the
 * defaults, and paints the browser chrome (theme-color) black to match.
 * The controller (src/scripts/console/controller.ts) owns these settings after load.
 */
import { FONT_SIZES, PHOSPHORS, STORAGE_KEYS } from '../../lib/console/prefs';
---

<script is:inline define:vars={{ storageKeys: STORAGE_KEYS, allowedSizes: FONT_SIZES, allowedColours: PHOSPHORS }}>
  (function () {
    var root = document.documentElement;
    try {
      var storedSize = Number(localStorage.getItem(storageKeys.fontSize));
      if (allowedSizes.indexOf(storedSize) !== -1) root.style.setProperty('--console-font-size', storedSize + 'px');
      var storedColour = localStorage.getItem(storageKeys.phosphor);
      if (allowedColours.indexOf(storedColour) !== -1) root.setAttribute('data-console-phosphor', storedColour);
    } catch (e) {
      // Storage blocked: the defaults apply.
    }
    document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
      meta.setAttribute('content', '#000000');
    });
  })();
</script>
