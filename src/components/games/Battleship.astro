---
/**
 * Battleship: fleet setup, then a battle against the computer. Behaviour lives in
 * src/scripts/games/battleship/controller.ts; every hook is a data-* attribute scoped to the root
 * section, so two games on one page would not interfere (pass a distinct `id` for the ARIA ids).
 *
 * Phases: setup (your board + setup panel) → battle (enemy board + your board + scoreboard and
 * log) → over (a result dialog; the boards stay for review).
 */
import BattleshipBoard from './BattleshipBoard.astro';
import { gameUi } from './styles';
import { ui } from '../ui/styles';
import { DIFFICULTIES, type Difficulty } from '../../lib/games/battleship/ai.ts';
import { FLEET, coordinateLabel } from '../../lib/games/battleship/rules.ts';
import { battleshipMessages } from '../../i18n/games/battleship';
import { gamesHubMessages } from '../../i18n/games/hub';
import { getLocale } from '../../i18n/server';

interface Props {
  /** Prefix for element ids; give each instance on a page its own. */
  id?: string;
}

const { id = 'battleship' } = Astro.props;
const locale = getLocale(Astro);
const m = battleshipMessages[locale];
const hub = gamesHubMessages[locale];

/** The site promises a probability-density admiral, so that is the default opponent. */
const DEFAULT_DIFFICULTY: Difficulty = 'hard';

const ids = {
  heading: `${id}-heading`,
  ownHelp: `${id}-own-help`,
  enemyHelp: `${id}-enemy-help`,
  startHint: `${id}-start-hint`,
  heat: `${id}-heat-caption`,
  log: `${id}-log-title`,
  result: `${id}-result-title`,
  resultSummary: `${id}-result-summary`,
};

const statRows = [
  { key: 'shots', label: m.battle.shots },
  { key: 'hits', label: m.battle.hits },
  { key: 'accuracy', label: m.battle.accuracy },
  { key: 'afloat', label: m.battle.afloat },
] as const;

const pip = 'size-2 shrink-0 rounded-[2px] bg-zinc-400 dark:bg-zinc-500';
const statusPip =
  'size-2 shrink-0 rounded-[2px] border border-zinc-400 data-on:border-rose-600 data-on:bg-rose-600 dark:border-zinc-500 dark:data-on:border-rose-400 dark:data-on:bg-rose-400';
---

<section data-battleship aria-labelledby={ids.heading} class="mt-8 sm:mt-10">
  {/* Keeps the outline h1 → h2 → h3 (boards) → h4 (fleets); the guide sections below are h2 too. */}
  <h2 id={ids.heading} class="sr-only">{m.region}</h2>
  <noscript>
    <p
      class="mb-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"
    >
      {hub.noscript}
    </p>
  </noscript>

  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-zinc-200 pb-3 dark:border-zinc-800"
  >
    <p class="flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1">
      <span data-phase-label class="label-mono text-accent-700 dark:text-accent-400">{m.phases.setup}</span>
      <span data-turn-status class="text-sm text-zinc-700 empty:hidden dark:text-zinc-300"></span>
    </p>
    <button type="button" data-new-game hidden class={ui.buttonSecondary}>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path d="M20 12a8 8 0 1 1-2.35-5.65"></path>
        <path d="M20 4v5h-5"></path>
      </svg>
      {m.battle.newGame}
    </button>
  </div>
  {/*
    The last two log lines (your shot and the reply), repeated next to the boards so they are seen
    without scrolling to the log on a phone. Hidden from assistive technology: the log region
    below already announces them.
  */}
  <p
    data-last-event
    hidden
    aria-hidden="true"
    class="mt-2 min-h-10 font-mono text-xs leading-5 whitespace-pre-line text-zinc-600 dark:text-zinc-400"
  >
  </p>

  <div class="mt-6 grid items-start gap-10 md:grid-cols-2 md:gap-8 lg:gap-10">
    {/* Enemy waters: first in reading order during the battle, hidden during setup. */}
    <div data-enemy-panel hidden class="min-w-0">
      <h3 class="font-serif text-xl font-medium tracking-tight">{m.boards.enemy}</h3>
      <p id={ids.enemyHelp} class="sr-only">{m.boards.help.enemy}</p>
      <div class="mt-3">
        <BattleshipBoard
          side="enemy"
          label={m.boards.enemy}
          helpId={ids.enemyHelp}
          cellLabel={(i) => m.cell.label(coordinateLabel(i), m.cell.unknown)}
        />
      </div>
      <h4 class:list={[gameUi.legend, 'mt-5']}>{m.battle.enemyFleet}</h4>
      <ul data-fleet-status="enemy" class="mt-2 grid max-w-[30rem] gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
        {
          FLEET.map((ship) => (
            <li data-ship-row={ship.id} class="group flex min-h-7 items-center justify-between gap-3">
              <span class="text-zinc-800 group-data-sunk:text-zinc-500 group-data-sunk:line-through dark:text-zinc-200 dark:group-data-sunk:text-zinc-400">
                {m.ships[ship.id].name}
              </span>
              <span class="flex gap-0.5" aria-hidden="true">
                {Array.from({ length: ship.length }, () => (
                  <span data-pip class={statusPip} />
                ))}
              </span>
              <span data-ship-state class="sr-only">
                {m.battle.shipAfloat}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div data-own-panel class="min-w-0">
      <h3 class="font-serif text-xl font-medium tracking-tight">{m.boards.own}</h3>
      <p id={ids.ownHelp} data-own-help class="sr-only">{m.boards.help.setup}</p>
      <div class="mt-3">
        <BattleshipBoard
          side="own"
          label={m.boards.own}
          helpId={ids.ownHelp}
          cellLabel={(i) => m.cell.label(coordinateLabel(i), m.cell.empty)}
        />
      </div>
      <p data-preview class="mt-3 min-h-5 max-w-[30rem] font-mono text-xs leading-5 text-zinc-600 dark:text-zinc-400">
      </p>

      <div data-heat-panel hidden class="mt-2 max-w-[30rem]">
        <label class={gameUi.toggle}>
          <input type="checkbox" data-heat-toggle class={gameUi.checkbox} aria-describedby={ids.heat} />
          {m.heat.toggle}
        </label>
        <div data-heat-details hidden class="pb-2">
          <p id={ids.heat} class={gameUi.hint}>{m.heat.caption}</p>
          <div class="mt-3 flex items-center gap-2 font-mono text-xs text-zinc-600 dark:text-zinc-400" aria-hidden="true">
            <span>{m.heat.low}</span>
            <span
              class="h-2 w-28 rounded-full border border-zinc-300 bg-linear-to-r from-accent-500/0 to-accent-500/60 dark:border-zinc-700 dark:from-accent-400/0 dark:to-accent-400/60"
            ></span>
            <span>{m.heat.high}</span>
          </div>
          <p data-heat-peaks class="mt-2 font-mono text-xs text-zinc-700 dark:text-zinc-300"></p>
        </div>
      </div>

      <div data-own-fleet hidden>
        <h4 class:list={[gameUi.legend, 'mt-5']}>{m.battle.ownFleet}</h4>
        <ul data-fleet-status="own" class="mt-2 grid max-w-[30rem] gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
          {
            FLEET.map((ship) => (
              <li data-ship-row={ship.id} class="group flex min-h-7 items-center justify-between gap-3">
                <span class="text-zinc-800 group-data-sunk:text-zinc-500 group-data-sunk:line-through dark:text-zinc-200 dark:group-data-sunk:text-zinc-400">
                  {m.ships[ship.id].name}
                </span>
                <span class="flex gap-0.5" aria-hidden="true">
                  {Array.from({ length: ship.length }, () => (
                    <span data-pip class={statusPip} />
                  ))}
                </span>
                <span data-ship-state class="sr-only">
                  {m.battle.shipAfloat}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div data-setup-panel class="flex min-w-0 flex-col gap-6 md:pt-10">
      <fieldset class="min-w-0">
        <legend class={gameUi.legend}>{m.setup.difficulty}</legend>
        <div class:list={[gameUi.segmented, 'grid-cols-3']}>
          {
            DIFFICULTIES.map((difficulty) => (
              <label class={gameUi.segment}>
                <input
                  type="radio"
                  class="sr-only"
                  name={`${id}-difficulty`}
                  value={difficulty}
                  checked={difficulty === DEFAULT_DIFFICULTY}
                  data-difficulty
                />
                {m.setup.difficulties[difficulty]}
              </label>
            ))
          }
        </div>
        <p data-difficulty-hint class={gameUi.hint}>{m.setup.difficultyHints[DEFAULT_DIFFICULTY]}</p>
      </fieldset>

      <fieldset class="min-w-0">
        <legend class={gameUi.legend}>{m.setup.fleet}</legend>
        <ul class="mt-2 flex flex-col gap-1.5">
          {
            FLEET.map((ship, index) => (
              <li>
                <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-zinc-200 bg-white px-3 transition-colors hover:border-zinc-400 has-checked:border-accent-600 has-checked:bg-accent-50 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-600 dark:has-checked:border-accent-500/70 dark:has-checked:bg-accent-500/10">
                  <input
                    type="radio"
                    name={`${id}-ship`}
                    value={ship.id}
                    checked={index === 0}
                    data-ship-choice
                    class={gameUi.checkbox}
                  />
                  <span class="min-w-0 flex-1 text-sm font-medium text-zinc-900 sm:text-base dark:text-zinc-100">
                    {m.ships[ship.id].name}
                  </span>
                  <span class="flex gap-0.5" aria-hidden="true">
                    {Array.from({ length: ship.length }, () => (
                      <span class={pip} />
                    ))}
                  </span>
                  <span class="sr-only">{`, ${m.cells(ship.length)}, `}</span>
                  <span
                    data-placed-label
                    class="w-28 shrink-0 text-right font-mono text-[0.6875rem] tracking-wide text-zinc-500 uppercase data-placed:text-accent-700 dark:text-zinc-400 dark:data-placed:text-accent-400"
                  >
                    {m.setup.notPlaced}
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>

      <div class="flex flex-col gap-3">
        <div class="grid grid-cols-3 gap-2">
          <button type="button" data-rotate class:list={[ui.buttonSecondary, 'px-2']}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0 max-[22rem]:hidden"
              aria-hidden="true"
            >
              <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.5"></path>
              <path d="M20 4v4.5h-4.5"></path>
              <path d="M8 16h8M8 16v-4"></path>
            </svg>
            {m.setup.rotate}
            <kbd class:list={[ui.kbd, 'hidden sm:pointer-fine:inline']} aria-hidden="true">R</kbd>
          </button>
          <button type="button" data-randomize class:list={[ui.buttonSecondary, 'px-2']}>{m.setup.random}</button>
          <button type="button" data-clear class:list={[ui.buttonGhost, 'px-2']}>{m.setup.clear}</button>
        </div>
        <p class="font-mono text-xs text-zinc-600 dark:text-zinc-400">
          <span data-orientation-label>{m.setup.orientations.horizontal}</span>
        </p>
        <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{m.setup.rule}</p>
      </div>

      <div class="border-t border-zinc-200 pt-5 dark:border-zinc-800">
        <button
          type="button"
          data-start
          aria-disabled="true"
          aria-describedby={ids.startHint}
          class:list={[
            ui.buttonPrimary,
            'min-h-12 w-full text-base aria-disabled:cursor-not-allowed aria-disabled:opacity-50 aria-disabled:hover:bg-accent-700 dark:aria-disabled:hover:bg-accent-500',
          ]}
        >
          {m.setup.start}
        </button>
        <p id={ids.startHint} data-start-hint class={gameUi.hint}>{m.setup.startHint}</p>
      </div>
    </div>
  </div>

  <div data-battle-panel hidden class="mt-10 grid gap-4 md:grid-cols-2">
    <div class={gameUi.panel}>
      <h3 class={gameUi.legend}>{m.battle.scoreboard}</h3>
      <table class="mt-3 w-full text-sm">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="pb-2 text-right font-medium text-zinc-900 dark:text-zinc-100">{m.battle.you}</th>
            <th scope="col" class="pb-2 text-right font-medium text-zinc-900 dark:text-zinc-100">{m.battle.computer}</th>
          </tr>
        </thead>
        <tbody class="font-mono tabular-nums">
          {
            statRows.map((row) => (
              <tr class="border-t border-zinc-200 dark:border-zinc-800">
                <th scope="row" class="py-2 text-left font-sans font-normal text-zinc-600 dark:text-zinc-400">
                  {row.label}
                </th>
                <td data-stat={`player-${row.key}`} class="py-2 text-right">
                  0
                </td>
                <td data-stat={`computer-${row.key}`} class="py-2 text-right">
                  0
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class={gameUi.panel}>
      <h3 id={ids.log} class={gameUi.legend}>{m.battle.log}</h3>
      {/*
        A log region: each new line is read once; old lines drop off silently. Newest first. The
        role sits on a wrapper so the <ol> keeps its list semantics for the <li> lines inside it.
      */}
      <div role="log" aria-live="polite" aria-relevant="additions" aria-labelledby={ids.log}>
        <ol
          data-log
          class="mt-3 flex flex-col gap-1.5 font-mono text-[0.8125rem] leading-snug text-zinc-500 dark:text-zinc-400 [&>li:first-child]:text-zinc-900 dark:[&>li:first-child]:text-zinc-100"
        >
        </ol>
      </div>
    </div>
  </div>

  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <dialog
    data-result
    aria-labelledby={ids.result}
    aria-describedby={ids.resultSummary}
    class="m-auto w-[min(calc(100%-2rem),28rem)] rounded-xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-xl backdrop:bg-zinc-950/40 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:backdrop:bg-black/60"
  >
    <div class="p-6 sm:p-7">
      <p class="label-mono text-accent-700 dark:text-accent-400">{m.result.eyebrow}</p>
      <h2 id={ids.result} data-result-title class="mt-2 font-serif text-3xl font-medium tracking-tight"></h2>
      <p id={ids.resultSummary} data-result-summary class="mt-3 leading-relaxed text-zinc-600 dark:text-zinc-400"></p>
      <p class="label-mono mt-5 border-t border-zinc-200 pt-4 text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
        {m.battle.you}
      </p>
      <dl class="mt-2 grid grid-cols-3 gap-3">
        <div>
          <dt class="text-xs text-zinc-600 dark:text-zinc-400">{m.battle.shots}</dt>
          <dd data-result-stat="shots" class="mt-1 font-mono text-lg tabular-nums"></dd>
        </div>
        <div>
          <dt class="text-xs text-zinc-600 dark:text-zinc-400">{m.battle.hits}</dt>
          <dd data-result-stat="hits" class="mt-1 font-mono text-lg tabular-nums"></dd>
        </div>
        <div>
          <dt class="text-xs text-zinc-600 dark:text-zinc-400">{m.battle.accuracy}</dt>
          <dd data-result-stat="accuracy" class="mt-1 font-mono text-lg tabular-nums"></dd>
        </div>
      </dl>
      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" data-result-action="review" class={ui.buttonSecondary}>{m.result.review}</button>
        <button type="button" data-result-action="replay" class={ui.buttonPrimary} autofocus>{m.result.replay}</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { initBattleship } from '../../scripts/games/battleship/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-battleship]').forEach(initBattleship);
</script>
