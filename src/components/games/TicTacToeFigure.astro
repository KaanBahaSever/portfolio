---
/**
 * Thin-line illustration for the tic-tac-toe card: a position on the board and the first level
 * of its game tree, with minimax scores computed at build time by the game's own search. The best
 * reply (a draw; both corners lose to a fork) is the one accent, on the board and in the tree.
 * Decorative (aria-hidden): the card text says what the game is.
 */
import { evaluateMoves } from '../../lib/games/tictactoe/ai.ts';
import type { Cell } from '../../lib/games/tictactoe/board.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// X in opposite corners, O in the centre, O to move: an edge draws, a corner loses.
const board: Cell[] = ['X', null, null, null, 'O', null, null, null, 'X'];
const scores = new Map(evaluateMoves(board, 'O').map((s) => [s.index, s.score]));
const shown = [2, 1, 6].map((index) => ({ index, score: scores.get(index) ?? 0 }));
const best = Math.max(...shown.map((s) => s.score));

const CELL = 34;
const BX = 20;
const BY = 24;
const centre = (index: number) => ({ x: BX + (index % 3) * CELL + CELL / 2, y: BY + Math.floor(index / 3) * CELL + CELL / 2 });
const R = 9;

const ROOT = { x: 204, y: 34 };
const CHILD_Y = 86;
const childX = [162, 204, 246];
const formatScore = (score: number) => (score > 0 ? `+${score}` : score < 0 ? `−${Math.abs(score)}` : '0');
const bestIndex = shown.findIndex((s) => s.score === best);
const bestChild = { x: childX[bestIndex] ?? ROOT.x, y: CHILD_Y };
const grandchildX = [-18, 0, 18].map((dx) => bestChild.x + dx);
---

<svg
  class={className}
  viewBox="0 0 280 150"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {/* The board: two vertical and two horizontal strokes. */}
  <g stroke-width="1.25">
    <line x1={BX + CELL} y1={BY + 3} x2={BX + CELL} y2={BY + 3 * CELL - 3} />
    <line x1={BX + 2 * CELL} y1={BY + 3} x2={BX + 2 * CELL} y2={BY + 3 * CELL - 3} />
    <line x1={BX + 3} y1={BY + CELL} x2={BX + 3 * CELL - 3} y2={BY + CELL} />
    <line x1={BX + 3} y1={BY + 2 * CELL} x2={BX + 3 * CELL - 3} y2={BY + 2 * CELL} />
  </g>
  {
    board.map((mark, index) => {
      const { x, y } = centre(index);
      if (mark === 'X') return <path d={`M${x - R} ${y - R}l${2 * R} ${2 * R}M${x + R} ${y - R}l${-2 * R} ${2 * R}`} stroke-width="1.5" />;
      if (mark === 'O') return <circle cx={x} cy={y} r={R + 1} stroke-width="1.5" />;
      return null;
    })
  }
  {/* The best reply, drawn as a dashed accent O. */}
  <circle
    cx={centre(shown[bestIndex]?.index ?? 1).x}
    cy={centre(shown[bestIndex]?.index ?? 1).y}
    r={R + 1}
    stroke-width="1.5"
    stroke-dasharray="3 2.5"
    class="text-accent-600 dark:text-accent-400"
  />

  {/* Game tree: the position, three replies with their scores, and the replies to the best one. */}
  <g stroke-width="0.9" stroke-opacity="0.55">
    {childX.map((x) => <line x1={ROOT.x} y1={ROOT.y + 5} x2={x} y2={CHILD_Y - 5} />)}
    {grandchildX.map((x) => <line x1={bestChild.x} y1={CHILD_Y + 5} x2={x} y2={124} />)}
  </g>
  <circle cx={ROOT.x} cy={ROOT.y} r="5" stroke-width="1.25" />
  {
    shown.map((child, i) => (
      <g class:list={[child.score === best && 'text-accent-600 dark:text-accent-400']}>
        <circle
          cx={childX[i]}
          cy={CHILD_Y}
          r="5"
          stroke-width="1.25"
          fill={child.score === best ? 'currentColor' : 'none'}
        />
        <text
          x={(childX[i] ?? 0) + (i === 0 ? -9 : 9)}
          y={CHILD_Y + 3.5}
          text-anchor={i === 0 ? 'end' : 'start'}
          fill="currentColor"
          stroke="none"
          font-size="10"
          class="font-mono"
        >
          {formatScore(child.score)}
        </text>
      </g>
    ))
  }
  {grandchildX.map((x) => <circle cx={x} cy={127} r="3" stroke-width="1" />)}
</svg>
