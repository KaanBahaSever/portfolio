---
/**
 * Home page hero: headline role, name, a three-sentence introduction, the two primary actions,
 * contact links and location, with Fig. 1 beside the text from lg: up (under it on smaller
 * screens). `data-hero` marks the area whose pointer position nudges the figure's phase.
 */
import HeroFigure from './HeroFigure.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import { localizePath, pick } from '../../i18n/config';
import { formatters } from '../../i18n/format';
import { common } from '../../i18n/messages/common';
import { homeMessages } from '../../i18n/messages/home';
import { getLocale } from '../../i18n/server';

const locale = getLocale(Astro);
const t = common[locale];
const h = homeMessages[locale].hero;
const f = formatters(locale);

// The headline has two halves ("Software Developer | Math-Driven Solutions & Algorithms"). Each
// half wraps as a unit; the bar becomes a quiet slash on screen and a comma for screen readers.
const [role = '', ...rest] = pick(SITE.role, locale).split(' | ');
const specialty = rest.join(' | ');

// Istanbul, written the way each language writes decimals (41.01 / 41,01).
const coordinate = (value: number) => f.number(value, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const coordinates = h.coordinates(coordinate(41.01), coordinate(28.98));

// Hero-sized versions of ui.buttonPrimary / ui.buttonSecondary (48 px tall, slightly larger text).
const button =
  'group inline-flex min-h-12 items-center justify-center gap-2 rounded-lg px-5 text-[0.9375rem] font-semibold transition-colors';
const primary = `${button} bg-accent-700 text-white shadow-sm hover:bg-accent-800 dark:bg-accent-500 dark:text-zinc-950 dark:hover:bg-accent-400`;
const secondary = `${button} border border-zinc-300 bg-white text-zinc-900 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800`;
const contactLink =
  'inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-700 transition-colors hover:text-accent-700 dark:text-zinc-300 dark:hover:text-accent-400';
---

<section aria-labelledby="intro-heading" class="pt-2 sm:pt-6" data-hero>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-14">
    <div class="min-w-0">
      <p class="label-mono text-accent-700 dark:text-accent-400">
        <span class="inline-block">{role}</span>
        {
          specialty && (
            <>
              <span class="mx-1.5 text-zinc-400 dark:text-zinc-600" aria-hidden="true">/</span>
              <span class="sr-only">, </span>
              <span class="inline-block">{specialty}</span>
            </>
          )
        }
      </p>

      <h1
        id="intro-heading"
        class="mt-4 font-serif text-5xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl lg:text-7xl"
      >
        {SITE.name}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">{h.intro}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a href={localizePath('/projects/', locale)} class={primary}>
          {h.selectedWork}
          <Icon name="arrow-right" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
        </a>
        {/* The CV is an English PDF: hreflang/type say so to machines, the mono note to people. */}
        <a href={SITE.cvPath} download hreflang="en" type="application/pdf" class={secondary}>
          <Icon name="download" class="size-4 transition-transform duration-200 group-hover:translate-y-0.5" />
          {t.labels.downloadCv}{' '}
          {/* The space above keeps the accessible name "Download CV PDF", not "Download CVPDF". */}
          <span class="font-mono text-xs font-medium text-zinc-600 dark:text-zinc-400">{h.cvFormat}</span>
        </a>
      </div>

      <ul class="mt-6 -mx-2 flex flex-wrap items-center gap-x-1" aria-label={h.contactLabel}>
        <li>
          <a href={`mailto:${SITE.email}`} class={contactLink}>
            <Icon name="mail" class="size-4" />
            {t.footer.email}
          </a>
        </li>
        {
          SITE.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="me noopener noreferrer" class={contactLink}>
                {social.label}
                <Icon name="arrow-up-right" class="size-3.5 text-zinc-400 dark:text-zinc-500" />
                <span class="sr-only"> {t.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <Icon name="map-pin" class="size-4 shrink-0" />
        <span class="sr-only">{h.locationLabel}:</span>
        <span>{pick(SITE.location, locale)}</span>
        <span class="font-mono text-xs text-zinc-500 tabular-nums dark:text-zinc-400" aria-hidden="true">
          {coordinates}
        </span>
      </p>
    </div>

    <HeroFigure class="min-w-0" />
  </div>
</section>
