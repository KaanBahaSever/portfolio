---
/**
 * Small line drawings for the four journey chapters, in the same hand as Fig. 1: thin
 * currentColor strokes and exactly one accent node that marks the point of each story.
 *   foundations a game tree with the chosen line of play (accent: the chosen leaf)
 *   avionics    a flight profile: sampled ascent, dashed descent, the accent at apogee
 *               (where the parachute deploys)
 *   guidance    a canopy steering along a descent path onto a target (accent: the landing point)
 *   simulation  a smooth curve and the discrete integration steps that approximate it
 * Decorative: the chapter title carries the meaning.
 */
import type { JourneyChapter } from '../../i18n/messages/home';

interface Props {
  kind: JourneyChapter;
  class?: string;
}

const { kind, class: className = 'h-11 w-[4.5rem]' } = Astro.props;
const accent = 'fill-accent-600 dark:fill-accent-400';
const muted = 'text-zinc-300 dark:text-zinc-700';
const paper = 'fill-white dark:fill-zinc-900';
---

<svg
  viewBox="0 0 72 44"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === 'avionics' && (
      <>
        <path d="M4 40H68" class={muted} />
        {/* y = 40 − 128t + 128t², split at the apex t = ½. */}
        <path d="M8 40Q22 8 36 8" />
        <path d="M36 8Q50 8 64 40" stroke-dasharray="2 3" />
        <g fill="currentColor" stroke="none">
          <circle cx="15" cy="26" r="1.3" />
          <circle cx="22" cy="16" r="1.3" />
          <circle cx="29" cy="10" r="1.3" />
        </g>
        <circle cx="36" cy="8" r="2.75" class={accent} stroke="none" />
      </>
    )
  }
  {
    kind === 'guidance' && (
      <>
        <path d="M4 43H68" class={muted} />
        <path d="M5 9a7 7 0 0 1 14 0z" />
        <path d="M5 9 12 17M19 9 12 17" />
        <path d="M12 17C18 32 38 18 50 30" stroke-dasharray="2 3" />
        <circle cx="56" cy="35" r="7" />
        <path d="M56 24v3M45 35h3M64 35h3" />
        <circle cx="56" cy="35" r="2.25" class={accent} stroke="none" />
      </>
    )
  }
  {
    kind === 'simulation' && (
      <>
        <path d="M6 4V38H68" class={muted} />
        <path d="M6 34C26 34 40 10 66 7" />
        <path d="M6 34 18 33 30 26 42 17 54 12 66 10" class="text-zinc-400 dark:text-zinc-500" />
        <g fill="currentColor" stroke="none" class="text-zinc-500 dark:text-zinc-400">
          <circle cx="18" cy="33" r="1.4" />
          <circle cx="30" cy="26" r="1.4" />
          <circle cx="42" cy="17" r="1.4" />
          <circle cx="54" cy="12" r="1.4" />
        </g>
        <circle cx="66" cy="10" r="2.5" class={accent} stroke="none" />
      </>
    )
  }
  {
    kind === 'foundations' && (
      <>
        <g class={muted}>
          <path d="M36 6 52 22M52 22 44 38M52 22 60 38M20 22 12 38" />
        </g>
        <path d="M36 6 20 22 28 38" />
        <g class={paper}>
          <circle cx="36" cy="6" r="2.75" />
          <circle cx="20" cy="22" r="2.75" />
          <circle cx="52" cy="22" r="2.75" class={muted} />
          <circle cx="12" cy="38" r="2.75" class={muted} />
          <circle cx="44" cy="38" r="2.75" class={muted} />
          <circle cx="60" cy="38" r="2.75" class={muted} />
        </g>
        <circle cx="28" cy="38" r="3" class={accent} stroke="none" />
      </>
    )
  }
</svg>
