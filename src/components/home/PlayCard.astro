---
/**
 * A playground card (game, tool or the console): mono kind label, title as a stretched link,
 * an optional mono detail line (e.g. the algorithm behind a game) and a short description.
 * Content after the description goes in the default slot (the console's prompt line).
 */
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
  href: string;
  /** Mono label above the title: "Game", "Tool", "Terminal". */
  kind: string;
  title: string;
  description: string;
  /** Mono line under the title, e.g. "Minimax · alpha–beta pruning". */
  detail?: string;
  icon: IconName;
  headingLevel?: 'h3' | 'h4';
}

const { href, kind, title, description, detail, icon, headingLevel: Heading = 'h3' } = Astro.props;
---

<article
  class="group relative flex h-full flex-col rounded-xl border border-zinc-200 bg-white p-5 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-600"
>
  <div class="flex items-center justify-between gap-3">
    <span class="label-mono text-zinc-600 dark:text-zinc-400">{kind}</span>
    <Icon
      name={icon}
      class="size-5 text-zinc-400 transition-colors group-hover:text-accent-700 dark:text-zinc-500 dark:group-hover:text-accent-400"
    />
  </div>
  <Heading class="mt-3 text-lg leading-snug font-semibold">
    <a
      href={href}
      class="rounded-sm text-zinc-900 transition-colors group-hover:text-accent-700 after:absolute after:inset-0 after:rounded-xl dark:text-zinc-100 dark:group-hover:text-accent-400"
    >
      {title}
    </a>
  </Heading>
  {detail && <p class="mt-1 font-mono text-xs leading-5 text-zinc-600 dark:text-zinc-400">{detail}</p>}
  <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>
  <slot />
  <span class="mt-auto flex justify-end pt-4 text-zinc-400 dark:text-zinc-500" aria-hidden="true">
    <Icon
      name="arrow-right"
      class="size-4 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent-700 dark:group-hover:text-accent-400"
    />
  </span>
</article>
