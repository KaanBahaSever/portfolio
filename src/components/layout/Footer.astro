---
import BrandMark from '../ui/BrandMark.astro';
import { SITE } from '../../config/site';
import { common } from '../../i18n/messages/common';
import { getLocale } from '../../i18n/server';

const t = common[getLocale(Astro)];
const year = new Date().getFullYear();

const linkClass =
  'flex min-h-11 items-center rounded-lg px-2 font-medium transition-colors hover:text-accent-700 dark:hover:text-accent-400';
---

<footer class="mt-16 border-t border-zinc-200 sm:mt-24 dark:border-zinc-800">
  <div
    class="px-safe mx-auto flex max-w-6xl flex-col gap-4 py-8 pb-[max(2rem,env(safe-area-inset-bottom))] text-sm text-zinc-600 sm:flex-row sm:items-center sm:justify-between dark:text-zinc-400"
  >
    <div class="flex items-start gap-3">
      <BrandMark class="mt-0.5 size-5 shrink-0 text-zinc-400 dark:text-zinc-600" />
      <div class="space-y-1">
        <p>&copy; {year} {SITE.name}</p>
        <p>{t.footer.tagline}</p>
      </div>
    </div>
    <ul class="-mx-2 flex flex-wrap items-center gap-x-1" aria-label={t.footer.socialLinks}>
      {
        SITE.socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="me noopener noreferrer" class={linkClass}>
              {social.label}
              <span class="sr-only"> {t.newTab}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={`mailto:${SITE.email}`} class={linkClass}>{t.footer.email}</a>
      </li>
      <li>
        <a href={SITE.repositoryUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
          {t.footer.source}
          <span class="sr-only"> {t.newTab}</span>
        </a>
      </li>
    </ul>
  </div>
</footer>
