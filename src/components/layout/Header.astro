---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';

/** '/blog/' -> '/blog', '/' stays '/'. */
function normalize(path: string): string {
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
}

const currentPath = normalize(Astro.url.pathname);

function isCurrent(href: string): boolean {
  const target = normalize(href);
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
}

const links = SITE.nav.map((item) => ({
  ...item,
  current: isCurrent(item.href),
  // "page" only for the page itself; a section link on one of its child pages is "true".
  ariaCurrent: currentPath === normalize(item.href) ? ('page' as const) : isCurrent(item.href) ? ('true' as const) : undefined,
}));
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div class="px-safe relative mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 sm:h-16">
    <a
      href="/"
      class="-mx-2 flex min-h-11 items-center rounded-lg px-2 text-base font-semibold tracking-tight text-zinc-900 hover:text-emerald-700 dark:text-zinc-100 dark:hover:text-emerald-400"
    >
      {SITE.name}
    </a>

    {/* md+: inline navigation */}
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.ariaCurrent}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-3 text-sm font-medium transition-colors',
                  link.current
                    ? 'text-emerald-700 dark:text-emerald-400'
                    : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Phones: disclosure menu, works without JavaScript. The nav wraps it so the landmark exists while closed. */}
    <nav aria-label="Main" class="md:hidden">
      <details class="group">
        <summary
          class="-mr-2 flex size-11 list-none items-center justify-center rounded-lg text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900 [&::-webkit-details-marker]:hidden"
        >
          <Icon name="menu" class="size-6 group-open:hidden" />
          <Icon name="close" class="hidden size-6 group-open:block" />
          <span class="sr-only">Menu</span>
        </summary>
        <div
          class="absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem)] overflow-y-auto overscroll-contain border-b border-zinc-200 bg-zinc-50 shadow-sm sm:max-h-[calc(100dvh-4rem)] dark:border-zinc-800 dark:bg-zinc-950"
        >
          <ul class="px-safe flex flex-col py-2">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.ariaCurrent}
                    class:list={[
                      '-mx-3 flex min-h-12 items-center rounded-lg px-3 text-base font-medium',
                      link.current
                        ? 'bg-emerald-50 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-300'
                        : 'text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  // A page restored from the back/forward cache keeps the menu open after following one of its links.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    document.querySelectorAll('header details[open]').forEach((menu) => menu.removeAttribute('open'));
  });
</script>
