---
import BrandMark from '../ui/BrandMark.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import { LOCALES, LOCALE_META, localizePath, stripLocale, type Locale } from '../../i18n/config';
import { common } from '../../i18n/messages/common';
import { getLocale } from '../../i18n/server';

interface Props {
  /** This page in each locale (site paths), for the language switch. */
  alternates: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;
// One width on every page, whatever the content column below: the brand, navigation and
// language switch stay in the same place from page to page (full-width tools included).
const container = 'max-w-6xl';
const locale = getLocale(Astro);
const t = common[locale];

/** '/blog/' -> '/blog', '/' stays '/'. */
function normalize(path: string): string {
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
}

// Compare locale-free paths, so /tr/blog/x/ marks "Blog" as current too.
const currentPath = normalize(stripLocale(Astro.url.pathname).path);

function isCurrent(href: string): boolean {
  const target = normalize(href);
  return currentPath === target || currentPath.startsWith(`${target}/`);
}

const links = SITE.nav.map((item) => ({
  label: t.nav[item.key],
  href: localizePath(item.href, locale),
  current: isCurrent(item.href),
  // "page" only for the page itself; a section link on one of its child pages is "true".
  ariaCurrent: currentPath === normalize(item.href) ? ('page' as const) : isCurrent(item.href) ? ('true' as const) : undefined,
}));

const consoleHref = localizePath('/console/', locale);
const consoleCurrent = isCurrent('/console/');

// Language switch: the current language as plain text, the other one as a link to this page in it.
const languages = LOCALES.map((l) => ({
  locale: l,
  short: LOCALE_META[l].short,
  htmlLang: LOCALE_META[l].htmlLang,
  // Named in its own language ("Türkçe oku" / "Read in English").
  label: common[l].language.switchTo,
  href: alternates[l] ?? localizePath('/', l),
  current: l === locale,
}));
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200/80 bg-zinc-50/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/80"
>
  <div class:list={['px-safe relative mx-auto flex h-14 items-center justify-between gap-3 sm:h-16', container]}>
    <a
      href={localizePath('/', locale)}
      class="group -mx-2 flex min-h-11 min-w-0 items-center gap-2.5 rounded-lg px-2 text-zinc-900 dark:text-zinc-100"
    >
      <BrandMark class="size-7 shrink-0 transition-transform duration-300 group-hover:-rotate-6" />
      <span class="truncate text-[0.9375rem] font-semibold tracking-tight">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {/* lg+: inline navigation */}
      <nav aria-label={t.nav.label} class="hidden lg:block">
        <ul class="flex items-center gap-0.5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={link.ariaCurrent}
                  class:list={[
                    'relative flex min-h-11 items-center rounded-lg px-3 text-sm font-medium transition-colors',
                    link.current
                      ? 'text-zinc-900 after:absolute after:inset-x-3 after:bottom-1.5 after:h-px after:bg-accent-600 dark:text-zinc-100 dark:after:bg-accent-400'
                      : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href={consoleHref}
        aria-current={consoleCurrent ? 'page' : undefined}
        title={t.nav.consoleHint}
        class:list={[
          'hidden size-11 items-center justify-center rounded-lg font-mono text-sm transition-colors lg:flex',
          consoleCurrent
            ? 'text-accent-700 dark:text-accent-400'
            : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100',
        ]}
      >
        <Icon name="terminal" class="size-5" />
        <span class="sr-only">{t.nav.console}</span>
      </a>

      {/*
        Theme toggle, at every width (outside the menu). A toggle button: its name stays "Dark
        theme" and aria-pressed says whether that theme is on; the tooltip says what a press does
        (both set by src/scripts/theme.ts). It needs JavaScript, so the styles below show it only
        once BaseLayout's pre-paint script has set <html data-theme>; the icon follows that
        attribute, so it is right from the first paint, before this page's scripts run.
      */}
      <button
        type="button"
        data-theme-toggle
        class="theme-toggle size-11 shrink-0 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
      >
        <svg
          class="theme-icon size-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <g class="theme-sun">
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.64 5.64l1.77 1.77M16.6 16.6l1.77 1.77M5.64 18.36l1.77-1.77M16.6 7.4l1.77-1.77"
            ></path>
          </g>
          <path class="theme-moon" d="M19.97 12.7A8 8 0 1 1 11.3 4.03a6.22 6.22 0 0 0 8.67 8.67z"></path>
        </svg>
        <span class="sr-only">{t.theme.toggle}</span>
      </button>

      {/*
        Language switch: works without JavaScript; the script below remembers the choice. The
        pill is 36px tall, so the link's hit area reaches past it (::after, 4px sideways and 7px
        up and down) to 44×44 without covering the menu button beside it.
      */}
      <div
        role="group"
        aria-label={t.language.label}
        class="flex h-9 items-center rounded-full border border-zinc-300 p-0.5 font-mono text-xs font-medium dark:border-zinc-700"
      >
        {
          languages.map((language) =>
            language.current ? (
              <span
                lang={language.htmlLang}
                class="flex h-full min-w-9 items-center justify-center rounded-full bg-zinc-900 px-2 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900"
              >
                {language.short}
              </span>
            ) : (
              <a
                href={language.href}
                hreflang={language.htmlLang}
                lang={language.htmlLang}
                data-set-locale={language.locale}
                class="relative flex h-full min-w-9 items-center justify-center rounded-full px-2 text-zinc-600 transition-colors after:absolute after:-inset-x-1 after:-inset-y-[7px] hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
              >
                {language.short}
                <span class="sr-only">{`, ${language.label}`}</span>
              </a>
            ),
          )
        }
      </div>

      {/*
        Below lg: disclosure menu, works without JavaScript. The nav wraps it so the landmark
        exists while closed. The script below closes it when focus leaves it, on Esc and on a
        press outside, since the open panel covers the top of the page.
      */}
      <nav aria-label={t.nav.label} class="lg:hidden">
        <details class="group">
          <summary
            class="-mr-2 flex size-11 list-none items-center justify-center rounded-lg text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900 [&::-webkit-details-marker]:hidden"
          >
            <Icon name="menu" class="size-6 group-open:hidden" />
            <Icon name="close" class="hidden size-6 group-open:block" />
            <span class="sr-only">{t.nav.menu}</span>
          </summary>
          <div
            class="absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem)] overflow-y-auto overscroll-contain border-b border-zinc-200 bg-zinc-50 shadow-sm sm:max-h-[calc(100dvh-4rem)] dark:border-zinc-800 dark:bg-zinc-950"
          >
            <ul class:list={['px-safe mx-auto flex flex-col py-2', container]}>
              {
                links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.ariaCurrent}
                      class:list={[
                        '-mx-3 flex min-h-12 items-center rounded-lg px-3 text-base font-medium',
                        link.current
                          ? 'bg-accent-50 text-accent-800 dark:bg-accent-500/10 dark:text-accent-300'
                          : 'text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900',
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
              <li class="mt-1 border-t border-zinc-200 pt-1 dark:border-zinc-800">
                <a
                  href={consoleHref}
                  aria-current={consoleCurrent ? 'page' : undefined}
                  class="-mx-3 flex min-h-12 items-center gap-3 rounded-lg px-3 text-base font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900"
                >
                  <Icon name="terminal" class="size-5 text-zinc-500" />
                  {t.nav.console}
                </a>
              </li>
            </ul>
          </div>
        </details>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Without JavaScript the theme follows the operating system and there is nothing to toggle. */
  .theme-toggle {
    display: none;
  }

  :global(:root[data-theme]) .theme-toggle {
    display: flex;
  }

  /*
   * Sun on the light theme, moon on the dark one: the outgoing icon turns and shrinks away as the
   * other one turns in (transform and opacity only; global.css shortens it to nothing for reduced
   * motion, and keeps it running while the rest of the page switches without transitions).
   */
  .theme-sun,
  .theme-moon {
    transform-box: view-box;
    transform-origin: center;
    transition:
      transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms ease-out;
  }

  :global(:root[data-theme='dark']) .theme-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global(:root:not([data-theme='dark'])) .theme-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
</style>

<script>
  import { LOCALE_STORAGE_KEY, isLocale } from '../../i18n/config';
  import { initThemeToggle } from '../../scripts/theme.ts';

  document.querySelectorAll<HTMLButtonElement>('button[data-theme-toggle]').forEach(initThemeToggle);

  const menus = () => document.querySelectorAll<HTMLDetailsElement>('header details');

  // A page restored from the back/forward cache keeps the menu open after following one of its links.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    menus().forEach((menu) => (menu.open = false));
  });

  // The open menu is a panel over the top of the page, and native <details> stays open until its
  // button is pressed again. Close it whenever it stops being where the visitor is, so the next
  // focused control is never hidden underneath it (WCAG 2.4.11).
  menus().forEach((menu) => {
    // Tab or Shift+Tab out of the menu. A null relatedTarget (switching windows, a click on
    // empty space inside the panel) is not a move elsewhere on the page: the menu stays open.
    menu.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (menu.open && next instanceof Node && !menu.contains(next)) menu.open = false;
    });
    // Esc closes it and returns focus to the button. preventDefault marks the key as handled
    // for page-level Esc shortcuts (the notepad's zen mode ignores a handled Esc).
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open || event.defaultPrevented) return;
      event.preventDefault();
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });

  // A press anywhere outside the menu (the page under the panel, the language switch) closes it.
  document.addEventListener('pointerdown', (event) => {
    const target = event.target;
    menus().forEach((menu) => {
      if (menu.open && !(target instanceof Node && menu.contains(target))) menu.open = false;
    });
  });

  // Remember an explicit language choice (also for middle-click / new-tab opens).
  function remember(event: MouseEvent) {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-set-locale]');
    const locale = link?.dataset.setLocale;
    if (!isLocale(locale)) return;
    try {
      localStorage.setItem(LOCALE_STORAGE_KEY, locale);
    } catch {
      // Storage blocked (private mode, disabled cookies): the link still switches the page, and
      // BaseLayout's language script treats a visit from another page of this site as a choice,
      // so the English home page does not send the visitor back to Turkish.
    }
  }
  document.addEventListener('click', remember);
  document.addEventListener('auxclick', remember);
</script>
