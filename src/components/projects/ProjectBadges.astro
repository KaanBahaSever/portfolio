---
/**
 * A project's status badges: its stage (when set) and whether the code is open.
 * "In production" is the only accented one, so a grid of cards shows one green mark at most
 * per card, and only where it means something.
 */
import Badge from '../ui/Badge.astro';
import { common } from '../../i18n/messages/common';
import { projectsMessages } from '../../i18n/messages/projects';
import { getLocale } from '../../i18n/server';
import type { LocalizedProject } from '../../utils/content';

interface Props {
  data: Pick<LocalizedProject['data'], 'stage' | 'isOpenSource'>;
  class?: string;
}

const { data, class: className } = Astro.props;
const locale = getLocale(Astro);
const t = common[locale];
const m = projectsMessages[locale];

const stageLabel = {
  production: m.stage.production,
  'early-access': t.badges.earlyAccess,
  'in-development': t.badges.inDevelopment,
} as const;
---

<div class:list={['flex flex-wrap items-center gap-2', className]}>
  {
    data.stage && (
      <Badge variant={data.stage === 'production' ? 'accent' : 'muted'} dot>
        {stageLabel[data.stage]}
      </Badge>
    )
  }
  {/* Whitespace between the badges (ignored by the flex layout) keeps screen readers from
      running the two labels together. */}
  {' '}
  <Badge variant="outline">{data.isOpenSource ? t.badges.openSource : t.badges.private}</Badge>
</div>
