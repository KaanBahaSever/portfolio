---
/**
 * A project's fact sheet (year started, tech stack) as a horizontal band in the page's header,
 * between the lead and the links: hairline rules above and below, mono labels, in the same
 * style as a blog post's date and reading-time row. It used to be a sticky column beside the
 * write-up, which narrowed the text; the reading column now has nothing beside it.
 *
 * The facts wrap as a row of label/value pairs: side by side while they fit, the tech stack on a
 * line of its own when it is too long to share one. The stage and whether the code is open are
 * the badges above the title, and the site and repository are the buttons below, so the band
 * does not repeat them.
 */
import TagList from '../ui/TagList.astro';
import { common } from '../../i18n/messages/common';
import { projectsMessages } from '../../i18n/messages/projects';
import { getLocale } from '../../i18n/server';
import type { LocalizedProject } from '../../utils/content';

interface Props {
  project: LocalizedProject;
  class?: string;
}

const { project, class: className } = Astro.props;
const locale = getLocale(Astro);
const t = common[locale];
const m = projectsMessages[locale];
const { since, techStack } = project.data;
---

<aside aria-label={m.detail.facts} class={className}>
  <dl class="flex flex-wrap gap-x-10 gap-y-3 border-y border-zinc-200 py-3.5 dark:border-zinc-800">
    {
      since && (
        <div>
          <dt class="label-mono text-zinc-600 dark:text-zinc-400">{m.detail.started}</dt>
          <dd class="mt-1 font-mono text-sm text-zinc-900 tabular-nums dark:text-zinc-100">{since}</dd>
        </div>
      )
    }
    <div class="min-w-0">
      <dt class="label-mono text-zinc-600 dark:text-zinc-400">{t.labels.techStack}</dt>
      <dd class="mt-1.5">
        <TagList items={techStack} label={t.labels.techStack} />
      </dd>
    </div>
  </dl>
</aside>
