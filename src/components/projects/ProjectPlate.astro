---
/**
 * The figure at the top of a project page, between the title block and the write-up: the
 * project's line drawing on a plate of graph paper, numbered and captioned ("Fig. 1 …"). A
 * project without a drawing shows its cover image here instead; with neither, nothing renders.
 * The page passes `reading-wide` (src/components/reading/reading.css): the plate reaches a
 * little past the text column on both sides, and the caption keeps the column's measure.
 *
 * The plate is wider than the drawing (2 : 1 on phones, 5 : 2 from sm, 3 : 1 from lg, against
 * the drawing's 12 : 5), so the drawing sits centred on the paper with room around it and the
 * plate stays a moderate height on wide screens. Strokes thicken a little as the plate grows,
 * so the hairlines keep their weight next to the page's text. Corner ticks mark the plate like
 * a drawing sheet; they, the paper and the drawing are decorative, and the caption says in
 * words what the figure shows.
 */
import { Image } from 'astro:assets';
import ProjectFigure from './ProjectFigure.astro';
import { readingImageSizes } from '../reading/layout';
import { hasFigure } from './figures';
import { projectsMessages } from '../../i18n/messages/projects';
import { getLocale } from '../../i18n/server';
import type { LocalizedProject } from '../../utils/content';

interface Props {
  project: LocalizedProject;
  class?: string;
}

const { project, class: className } = Astro.props;
const m = projectsMessages[getLocale(Astro)];
const figureId = hasFigure(project.id) ? project.id : undefined;
const { cover, coverAlt } = project.data;

const tick = 'pointer-events-none absolute size-2.5 border-zinc-300 dark:border-zinc-700';
---

{
  figureId ? (
    <figure class:list={['min-w-0', className]}>
      <div class="relative isolate overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
        <div
          class="bg-graph-fine pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_center,#000_40%,transparent_85%)]"
          aria-hidden="true"
        />
        <span class:list={[tick, 'top-3 left-3 border-t border-l']} aria-hidden="true" />
        <span class:list={[tick, 'top-3 right-3 border-t border-r']} aria-hidden="true" />
        <span class:list={[tick, 'bottom-3 left-3 border-b border-l']} aria-hidden="true" />
        <span class:list={[tick, 'right-3 bottom-3 border-r border-b']} aria-hidden="true" />
        <ProjectFigure
          id={figureId}
          class="aspect-[2/1] w-full px-4 py-5 sm:aspect-[5/2] sm:px-10 sm:py-8 sm:[stroke-width:1.4] lg:aspect-[3/1] lg:py-10 lg:[stroke-width:1.5]"
        />
      </div>
      <figcaption class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        {/* The space keeps "Fig. 1" and the caption apart for screen readers, not just visually. */}
        <span class="label-mono mr-1 text-accent-700 dark:text-accent-400">{m.detail.figure(1)}</span>{' '}
        {m.figures[figureId]}
      </figcaption>
    </figure>
  ) : (
    cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[480, 960, 1440, 2160]}
        sizes={readingImageSizes('wide')}
        class:list={['h-auto w-full rounded-xl border border-zinc-200 dark:border-zinc-800', className]}
      />
    )
  )
}
