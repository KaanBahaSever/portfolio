---
/**
 * Typeset container for a project's Markdown body: <ProjectProse><Content /></ProjectProse>.
 *
 * Bodies link to other pages with locale-free paths ('/about/#journey'). On English pages the
 * body renders as is; on other locales the rendered HTML gets the locale prefix on those links
 * (localizeProseLinks), so the Turkish text sends readers to Turkish pages without hard-coding
 * '/tr/' in the content. The HTML is the site's own rendered Markdown, not translated strings.
 */
import { localizeProseLinks } from './links';
import { DEFAULT_LOCALE } from '../../i18n/config';
import { getLocale } from '../../i18n/server';

interface Props {
  /** Language of the body when it differs from the page (an untranslated fallback). */
  lang?: string;
  class?: string;
}

const { lang, class: className } = Astro.props;
const locale = getLocale(Astro);
const html = locale === DEFAULT_LOCALE ? undefined : localizeProseLinks(await Astro.slots.render('default'), locale);
const classes = [
  // The page's reading column sets the measure (max-w-none here), and the text is set like a
  // blog post's (18 px from sm), the size that measure is chosen for. prose-zinc would turn
  // links ink-coloured; links stay in the accent, as everywhere else.
  'prose prose-zinc max-w-none sm:prose-lg dark:prose-invert prose-a:text-accent-700 prose-a:underline-offset-4 dark:prose-a:text-accent-400 prose-table:text-sm',
  // Inline code: the typography plugin wraps it in literal backticks (code::before/::after).
  // Bodies name components and types (`asion-agent`, `std::span`), so a quiet chip reads
  // cleaner. Scoped to code outside <pre> so fenced blocks keep their Shiki frame; the
  // clone keeps the padding and rounding on both halves when a long name wraps.
  'prose-code:before:content-none prose-code:after:content-none',
  '[&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-zinc-100 [&_:not(pre)>code]:px-1 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-medium [&_:not(pre)>code]:box-decoration-clone dark:[&_:not(pre)>code]:bg-zinc-800',
  className,
];
---

{
  html === undefined ? (
    <div class:list={classes} lang={lang}>
      <slot />
    </div>
  ) : (
    <div class:list={classes} lang={lang} set:html={html} />
  )
}
