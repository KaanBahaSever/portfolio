---
/**
 * Thin-line figure for a tool card (24×24 grid): the object the tool works on, drawn in
 * currentColor, with one accent mark for what the tool does to it (the picture set on a page,
 * the caret that writes, the cut that splits, the arrows that compress, the key bit that locks,
 * the primes a number splits into, the arrows that convert, the route between two places).
 * Decorative: the card names the tool in text. Unknown slugs get a neutral page.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = 'size-6' } = Astro.props;

interface Glyph {
  /** Paths in the ink colour. */
  ink: string[];
  /** The one accent mark (stroked). */
  accent: string[];
  /** Accent dots (filled circles: cx, cy, r). */
  dots?: Array<[number, number, number]>;
  /** Dashed accent strokes. */
  dashed?: boolean;
}

const page = 'M6 3h8.5L18 6.5V21H6z';
const fold = 'M14.5 3v3.5H18';

const glyphs: Record<string, Glyph> = {
  // A stack of pages; a picture (frame, hill, sun) set on the top one.
  'images-to-pdf': {
    ink: [page, fold, 'M6 5H3.5v18h12v-2', 'M8.5 18.5h5'],
    accent: ['M8.5 9.5h7v6h-7z', 'm8.5 15.5 3-3 4 3'],
    dots: [[13.4, 11.6, 0.85]],
  },
  // A ruled page and a text caret.
  notepad: { ink: [page, fold, 'M9 10h6', 'M9 13h6', 'M9 16h3'], accent: ['M13.75 14.75v2.75'] },
  // Two pages parted by a dashed cut.
  'pdf-split': {
    ink: ['M3.5 5h6v14h-6z', 'M14.5 5h6v14h-6z', 'M5.5 9h2', 'M16.5 9h2'],
    accent: ['M12 2.5v19'],
    dashed: true,
  },
  // A picture inside crop marks that close in on it.
  'image-compressor': {
    ink: ['M7.5 7.5h9v9h-9z', 'm7.5 15 3-3 2.5 2.5 1-1 2.5 2.5'],
    accent: ['M3 6V3h3', 'M21 6V3h-3', 'M3 18v3h3', 'M21 18v3h-3'],
  },
  // A page squeezed from top and bottom.
  'pdf-compress': {
    ink: [page, fold, 'M9 13h6'],
    accent: ['m10 8.5 2 2 2-2', 'm10 17.5 2-2 2 2'],
  },
  // A padlock with one filled key bit.
  'password-generator': {
    ink: ['M5.5 11h13v9.5h-13z', 'M8.5 11V7.5a3.5 3.5 0 0 1 7 0V11'],
    accent: ['M12 17v1.25'],
    dots: [[12, 15.5, 1.35]],
  },
  // A factor tree: the number splits until only primes (the accent leaves) are left.
  'prime-factorizer': {
    ink: [
      'M8.25 5a1.75 1.75 0 1 0 3.5 0a1.75 1.75 0 1 0 -3.5 0',
      'M13.25 12.25a1.75 1.75 0 1 0 3.5 0a1.75 1.75 0 1 0 -3.5 0',
      'M8.9 6.67 6.45 10.41',
      'M11.14 6.65 13.86 10.6',
      'M14.06 14.01 12.03 17.81',
      'M15.94 14.01 17.97 17.81',
    ],
    accent: [],
    dots: [
      [5.25, 12.25, 1.6],
      [11, 19.75, 1.6],
      [19, 19.75, 1.6],
    ],
  },
  // A letter and its bits, with the two-way conversion between them.
  'binary-text': {
    ink: [
      'M3.5 16 7 3l3.5 13',
      'M4.75 11.5h4.5',
      'M13.75 4.25 15 3v5',
      'M19.25 3c.88 0 1.6 1.12 1.6 2.5S20.13 8 19.25 8s-1.6-1.12-1.6-2.5.72-2.5 1.6-2.5z',
      'M15 11c.88 0 1.6 1.12 1.6 2.5S15.88 16 15 16s-1.6-1.12-1.6-2.5.72-2.5 1.6-2.5z',
      'M18 12.25 19.25 11v5',
    ],
    accent: ['M5 19.5h14', 'm7 17.5-2 2 2 2', 'm17 17.5 2 2-2 2'],
  },
  // A globe (its rim and the near half of the equator) and a great-circle route between two points.
  'geo-distance': {
    ink: ['M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0', 'M3.5 12a8.5 3 0 0 0 17 0'],
    accent: ['M7 17.5Q8.5 8.5 16.5 7'],
    dots: [
      [7, 17.5, 1.4],
      [16.5, 7, 1.4],
    ],
  },
};

const glyph = glyphs[slug] ?? { ink: [page, fold], accent: ['M9 13h6'] };
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {glyph.ink.map((d) => <path d={d} />)}
  <g class="stroke-accent-600 dark:stroke-accent-400" stroke-dasharray={glyph.dashed ? '1.5 2.25' : undefined}>
    {glyph.accent.map((d) => <path d={d} />)}
  </g>
  {
    glyph.dots?.map(([cx, cy, r]) => (
      <circle cx={cx} cy={cy} r={r} stroke="none" class="fill-accent-600 dark:fill-accent-400" />
    ))
  }
</svg>
