---
/**
 * Gravity simulator UI. Behaviour lives in src/scripts/tools/gravity/controller.ts and the
 * three.js view in scene-view.ts (imported only by this component's script, so no other page
 * loads three.js); every hook is a data-* attribute scoped to the root section. Text comes from
 * src/i18n/tools/gravity.ts through the presenter (src/scripts/tools/gravity/present.ts), which
 * the controller uses too.
 *
 * The view panel is dark in both themes (it is space); everything around it follows the site's
 * theme. The table of bodies under the view is the text equivalent of the picture.
 */
import Icon from '../ui/Icon.astro';
import { ui } from '../ui/styles';
import { getLocale } from '../../i18n/server';
import { gravityMessages } from '../../i18n/tools/gravity';
import {
  BODY_KINDS,
  MASS_SLIDER,
  MASS_UNITS,
  MOON_MASS,
  PRESETS,
  PRESET_IDS,
  TIME_SCALES,
  nearestTimeScaleIndex,
} from '../../lib/physics/gravity';
import { presenter } from '../../scripts/tools/gravity/present';

const locale = getLocale(Astro);
const m = gravityMessages[locale];
const present = presenter(locale);

const startPreset = PRESET_IDS[0];
const startScale = nearestTimeScaleIndex(PRESETS[startPreset].timeScale);
const startKind = 'moon';
const startUnit = 'moon';
const decimal = (text: string) => (locale === 'tr' ? text.replace('.', ',') : text);

const numberFields = [
  { name: 'x', label: m.add.numbers.x, unit: 'km', value: '0' },
  { name: 'y', label: m.add.numbers.y, unit: 'km', value: decimal('-200000').replace('-', '−') },
  { name: 'vx', label: m.add.numbers.vx, unit: 'km/s', value: decimal('1.41') },
  { name: 'vy', label: m.add.numbers.vy, unit: 'km/s', value: '0' },
] as const;

const labelClass = 'text-sm font-medium text-zinc-700 dark:text-zinc-300';
const hintClass = 'text-sm leading-relaxed text-zinc-600 dark:text-zinc-400';
const errorClass = 'text-sm text-rose-700 dark:text-rose-400';
const headingClass = 'label-mono text-zinc-600 dark:text-zinc-400';
const inputClass = `${ui.field} font-mono tabular-nums aria-invalid:border-rose-600 dark:aria-invalid:border-rose-400`;
const unitInputClass = `${inputClass} pr-14`;
const unitClass =
  'pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-zinc-600 dark:text-zinc-400';
/** One option of a segmented control (as in the Image compressor): a visually hidden radio inside its label. */
const segment =
  'relative flex min-h-11 min-w-12 flex-1 cursor-pointer items-center justify-center rounded-md px-3 text-center text-sm font-medium text-zinc-600 transition-colors select-none hover:text-zinc-900 has-checked:bg-white has-checked:text-zinc-900 has-checked:shadow-sm has-checked:ring-1 has-checked:ring-accent-600 has-focus-visible:outline-2 has-focus-visible:outline-offset-1 has-focus-visible:outline-accent-700 dark:text-zinc-400 dark:hover:text-zinc-100 dark:has-checked:bg-zinc-800 dark:has-checked:text-zinc-50 dark:has-checked:ring-accent-500 dark:has-focus-visible:outline-accent-400';
/** The drag-mode options are as wide as their words, which differ in length. */
const modeSegment = `${segment.replace('flex-1 ', '')} whitespace-nowrap`;
const segmentGroup =
  'flex rounded-lg border border-zinc-200 bg-zinc-100/80 p-0.5 dark:border-zinc-800 dark:bg-zinc-950';
/** A checkbox with its label, as a 44 px tall target. */
const toggle =
  'inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg px-1 text-sm font-medium text-zinc-700 select-none has-disabled:cursor-not-allowed has-disabled:opacity-50 dark:text-zinc-300';
const checkbox = 'size-4 shrink-0 cursor-pointer accent-accent-700 disabled:cursor-not-allowed dark:accent-accent-500';
const range = 'h-11 w-full cursor-pointer accent-accent-700 dark:accent-accent-500';
const dt = 'label-mono text-zinc-600 dark:text-zinc-400';
const dd = 'mt-1 font-mono text-sm break-words text-zinc-900 tabular-nums dark:text-zinc-100';
const th =
  'sticky top-0 z-10 bg-white px-3 py-2 text-right align-bottom text-xs font-semibold whitespace-nowrap text-zinc-700 shadow-[inset_0_-1px_0] shadow-zinc-200 first:text-left dark:bg-zinc-900 dark:text-zinc-300 dark:shadow-zinc-800';
---

<section data-gravity aria-label={m.toolLabel} class="mt-8 sm:mt-10">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="mb-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100"
    >
      {m.noscript}
    </p>
  </noscript>

  {/* Phones: view and controls, side panels, table. From lg the panels form a column on the right. */}
  {/* The second row takes any extra height of the side column, so the table sits right under the controls. */}
  <div
    class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:grid-rows-[auto_1fr] lg:items-start"
  >
    <!-- 1. View and transport -->
    <div class="min-w-0 lg:col-start-1 lg:row-start-1">
      <div
        data-stage
        class="relative isolate h-[26rem] overflow-hidden rounded-xl border border-zinc-800 bg-[#05070d] sm:h-[32rem] lg:h-[clamp(30rem,70vh,44rem)] dark:border-zinc-800"
      >
        <canvas
          data-canvas
          role="img"
          tabindex="0"
          aria-label={m.view.canvas}
          aria-describedby="gr-hint"
          class="block size-full touch-none outline-none select-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent-400"
        ></canvas>
        <div data-labels aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden"></div>
        <p
          data-readout
          aria-hidden="true"
          hidden
          class="pointer-events-none absolute top-0 left-0 rounded-md bg-black/75 px-2 py-1 font-mono text-xs whitespace-nowrap text-white tabular-nums"
        >
        </p>
        <p
          aria-hidden="true"
          class="pointer-events-none absolute top-3 left-3 rounded-md bg-black/50 px-2 py-1 font-mono text-xs text-zinc-200 tabular-nums"
        >
          t = <span data-elapsed-overlay>0 {m.units.s}</span>
        </p>
        <div
          class="pointer-events-none absolute inset-x-3 bottom-3 flex flex-col gap-1 text-xs leading-relaxed text-zinc-300 sm:max-w-[34rem]"
        >
          <p id="gr-hint" data-hint>{m.view.hint.add}</p>
          <p class="text-zinc-400">{m.view.notToScale}</p>
        </div>
        <p
          data-no-webgl
          hidden
          class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm leading-relaxed text-zinc-200"
        >
          {m.noWebgl}
        </p>
      </div>

      <div role="group" aria-label={m.transport.label} class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-3">
        <button type="button" data-play class:list={[ui.buttonPrimary, 'min-w-28']}>
          <span data-icon-play hidden><Icon name="play" class="size-4 shrink-0" /></span>
          <svg
            data-icon-pause
            class="size-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"><path d="M8.5 5v14"></path><path d="M15.5 5v14"></path></svg
          >
          <span data-play-label>{m.transport.pause}</span>
        </button>
        <button type="button" data-step aria-describedby="gr-step-hint" class={ui.buttonSecondary}>
          <svg
            class="size-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"><path d="M6 5v14l9-7z"></path><path d="M18.5 5v14"></path></svg
          >
          {m.transport.step}
        </button>
        <p id="gr-step-hint" data-step-hint class="sr-only">
          {m.transport.stepHint(present.duration(TIME_SCALES[startScale] / 10))}
        </p>
        <div class="flex min-w-[min(100%,16rem)] flex-1 flex-col">
          <div class="flex items-baseline justify-between gap-3">
            <label for="gr-speed" class={labelClass}>{m.transport.speed}</label>
            <output for="gr-speed" data-speed-value class="font-mono text-sm text-zinc-700 tabular-nums dark:text-zinc-300">
              {present.timeScale(TIME_SCALES[startScale])}
            </output>
          </div>
          <input
            id="gr-speed"
            data-speed
            type="range"
            min="0"
            max={TIME_SCALES.length - 1}
            step="1"
            value={startScale}
            aria-valuetext={present.timeScale(TIME_SCALES[startScale])}
            class={range}
          />
        </div>
      </div>
      <p
        data-limited
        hidden
        class="mt-2 border-l-2 border-amber-500 pl-3 text-sm leading-relaxed text-zinc-700 dark:border-amber-400 dark:text-zinc-300"
      >
        {m.transport.limited}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
        <fieldset class="min-w-0">
          <legend class="sr-only">{m.transport.mode}</legend>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span aria-hidden="true" class={labelClass}>{m.transport.mode}</span>
            <div class:list={[segmentGroup, 'shrink-0']}>
              {
                (['add', 'camera'] as const).map((mode) => (
                  <label class={modeSegment}>
                    <input type="radio" name="gr-mode" value={mode} data-mode class="sr-only" checked={mode === 'add'} />
                    {m.transport.modes[mode]}
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>
        <div class="flex flex-wrap items-center gap-x-3">
          <label class={toggle}><input type="checkbox" data-trails checked class={checkbox} />{m.transport.trails}</label>
          <label class={toggle}><input type="checkbox" data-labels-toggle checked class={checkbox} />{m.transport.labels}</label>
          <label class={toggle}><input type="checkbox" data-follow disabled class={checkbox} />{m.transport.follow}</label>
        </div>
        <button type="button" data-fit class:list={[ui.buttonGhost, '-ml-3']}>
          <Icon name="maximize" class="size-4 shrink-0" />
          {m.transport.fit}
        </button>
      </div>
    </div>

    <!-- 2. Side panels -->
    <div class="flex min-w-0 flex-col gap-6 lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <section aria-labelledby="gr-preset-heading" class:list={[ui.card, 'p-4 sm:p-5']}>
        <h2 id="gr-preset-heading" class={headingClass}>{m.presets.heading}</h2>
        <div class="mt-3 flex flex-col gap-1.5">
          <label for="gr-preset" class={labelClass}>{m.presets.label}</label>
          <select id="gr-preset" data-preset aria-describedby="gr-preset-detail" class:list={[ui.field, 'cursor-pointer']}>
            {PRESET_IDS.map((id) => <option value={id} selected={id === startPreset}>{m.presets.items[id].label}</option>)}
          </select>
          <p id="gr-preset-detail" data-preset-detail class={hintClass}>{m.presets.items[startPreset].detail}</p>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-reset class={ui.buttonSecondary}>
            <Icon name="refresh" class="size-4 shrink-0" />
            {m.presets.reset}
          </button>
          <button type="button" data-clear class={ui.buttonGhost}>
            <Icon name="trash" class="size-4 shrink-0" />
            {m.presets.clear}
          </button>
        </div>
      </section>

      <section aria-labelledby="gr-add-heading" class:list={[ui.card, 'p-4 sm:p-5']}>
        <h2 id="gr-add-heading" class={headingClass}>{m.add.heading}</h2>
        <div class="mt-3 grid grid-cols-1 gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="gr-kind" class={labelClass}>{m.add.kind}</label>
            <select id="gr-kind" data-kind class:list={[ui.field, 'cursor-pointer']}>
              {
                [...BODY_KINDS, 'custom' as const].map((kind) => (
                  <option value={kind} selected={kind === startKind}>
                    {m.add.kinds[kind]}
                  </option>
                ))
              }
            </select>
          </div>
          <div class="flex flex-col gap-1.5">
            <span id="gr-mass-label" class={labelClass}>{m.add.mass}</span>
            <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,9rem)] gap-2">
              <input
                data-mass
                type="text"
                inputmode="text"
                autocomplete="off"
                spellcheck="false"
                aria-labelledby="gr-mass-label"
                aria-describedby="gr-mass-equals gr-mass-error"
                value="1"
                class={inputClass}
              />
              <label for="gr-mass-unit" class="sr-only">{m.add.unit}</label>
              <select id="gr-mass-unit" data-mass-unit class:list={[ui.field, 'cursor-pointer']}>
                {MASS_UNITS.map((unit) => <option value={unit} selected={unit === startUnit}>{m.add.units[unit]}</option>)}
              </select>
            </div>
            <label for="gr-mass-slider" class="sr-only">{m.add.massSlider}</label>
            <input
              id="gr-mass-slider"
              data-mass-slider
              type="range"
              min={MASS_SLIDER.min}
              max={MASS_SLIDER.max}
              step={MASS_SLIDER.step}
              value={Math.log10(MOON_MASS)}
              aria-valuetext={present.mass(MOON_MASS)}
              class={range}
            />
            <p id="gr-mass-equals" data-mass-equals class="text-sm leading-relaxed text-zinc-600 tabular-nums dark:text-zinc-400">
              {m.add.equals}: {present.equivalents(MOON_MASS, startUnit).join(' · ')}
            </p>
            <p id="gr-mass-error" data-mass-error hidden class={errorClass}></p>
          </div>
          <p class={hintClass}>{m.add.howTo}</p>
          <p data-full hidden class="border-l-2 border-amber-500 pl-3 text-sm leading-relaxed text-zinc-700 dark:border-amber-400 dark:text-zinc-300">
            {m.add.full}
          </p>

          <details class="group rounded-lg border border-zinc-200 dark:border-zinc-800">
            <summary
              class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-3 text-sm font-medium text-zinc-800 dark:text-zinc-200 [&::-webkit-details-marker]:hidden"
            >
              {m.add.orbit.heading}
              <Icon name="chevron-down" class="size-4 shrink-0 transition-transform group-open:rotate-180" />
            </summary>
            <form data-orbit-form novalidate class="flex flex-col gap-3 px-3 pt-1 pb-3">
              <div class="flex flex-col gap-1.5">
                <label for="gr-orbit-around" class={labelClass}>{m.add.orbit.around}</label>
                <select id="gr-orbit-around" data-orbit-around class:list={[ui.field, 'cursor-pointer']}></select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="gr-orbit-distance" class={labelClass}>
                  {m.add.orbit.distance}<span class="sr-only"> (km)</span>
                </label>
                <div class="relative">
                  <input
                    id="gr-orbit-distance"
                    data-orbit-distance
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    spellcheck="false"
                    value="100000"
                    aria-describedby="gr-orbit-hint gr-orbit-error"
                    class={unitInputClass}
                  />
                  <span aria-hidden="true" class={unitClass}>km</span>
                </div>
              </div>
              <p id="gr-orbit-hint" class={hintClass}>{m.add.orbit.hint}</p>
              <p id="gr-orbit-error" data-orbit-error hidden class={errorClass}></p>
              <button type="submit" data-orbit-submit class:list={[ui.buttonSecondary, 'self-start']}>
                {m.add.orbit.submit}
              </button>
            </form>
          </details>

          <details class="group rounded-lg border border-zinc-200 dark:border-zinc-800">
            <summary
              class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-3 text-sm font-medium text-zinc-800 dark:text-zinc-200 [&::-webkit-details-marker]:hidden"
            >
              {m.add.numbers.heading}
              <Icon name="chevron-down" class="size-4 shrink-0 transition-transform group-open:rotate-180" />
            </summary>
            <form data-numbers-form novalidate class="flex flex-col gap-3 px-3 pt-1 pb-3">
              <p id="gr-numbers-hint" class={hintClass}>{m.add.numbers.hint}</p>
              {
                [
                  { legend: m.add.numbers.position, fields: numberFields.slice(0, 2) },
                  { legend: m.add.numbers.velocity, fields: numberFields.slice(2) },
                ].map((group) => (
                  <fieldset class="min-w-0">
                    <legend class={labelClass}>{group.legend}</legend>
                    <div class="mt-1.5 grid grid-cols-2 gap-2">
                      {group.fields.map((field) => (
                        <div class="flex min-w-0 flex-col gap-1">
                          <label for={`gr-num-${field.name}`} class="font-mono text-xs text-zinc-600 dark:text-zinc-400">
                            {field.label}
                            <span class="sr-only"> ({field.unit})</span>
                          </label>
                          <div class="relative">
                            <input
                              id={`gr-num-${field.name}`}
                              data-num={field.name}
                              type="text"
                              autocomplete="off"
                              spellcheck="false"
                              value={field.value}
                              aria-describedby="gr-numbers-hint gr-numbers-error"
                              class:list={[unitInputClass, field.unit === 'km/s' && 'pr-16']}
                            />
                            <span aria-hidden="true" class={unitClass}>
                              {field.unit}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </fieldset>
                ))
              }
              <p id="gr-numbers-error" data-numbers-error hidden class={errorClass}></p>
              <button type="submit" class:list={[ui.buttonSecondary, 'self-start']}>{m.add.numbers.submit}</button>
            </form>
          </details>
        </div>
      </section>

      <section aria-labelledby="gr-selected-heading" class:list={[ui.card, 'p-4 sm:p-5']}>
        <h2 id="gr-selected-heading" class={headingClass}>{m.selected.heading}</h2>
        <p data-selected-none class:list={[hintClass, 'mt-3']}>{m.selected.none}</p>
        <form data-selected-form hidden novalidate class="mt-3 flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="gr-sel-name" class={labelClass}>{m.selected.name}</label>
            <input
              id="gr-sel-name"
              data-sel-name
              type="text"
              maxlength="40"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="gr-sel-error"
              class={ui.field}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <span id="gr-sel-mass-label" class={labelClass}>{m.selected.mass}</span>
            <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,9rem)] gap-2">
              <input
                data-sel-mass
                type="text"
                autocomplete="off"
                spellcheck="false"
                aria-labelledby="gr-sel-mass-label"
                aria-describedby="gr-sel-equals gr-sel-error"
                class={inputClass}
              />
              <label for="gr-sel-unit" class="sr-only">{m.add.unit}</label>
              <select id="gr-sel-unit" data-sel-unit class:list={[ui.field, 'cursor-pointer']}>
                {MASS_UNITS.map((unit) => <option value={unit}>{m.add.units[unit]}</option>)}
              </select>
            </div>
            <p id="gr-sel-equals" data-sel-equals class="text-sm leading-relaxed text-zinc-600 tabular-nums dark:text-zinc-400"></p>
            <p id="gr-sel-error" data-sel-error hidden class={errorClass}></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="submit" class={ui.buttonSecondary}>{m.selected.apply}</button>
            <button type="button" data-sel-remove class={ui.buttonGhost}>
              <Icon name="trash" class="size-4 shrink-0" />
              {m.selected.remove}
            </button>
          </div>
          <dl class="grid grid-cols-1 gap-x-5 gap-y-4 border-t border-zinc-200 pt-4 min-[22rem]:grid-cols-2 dark:border-zinc-800">
            <div class="min-w-0"><dt class={dt}>{m.selected.attractor}</dt><dd data-sel-attractor class={dd}></dd></div>
            <div class="min-w-0"><dt class={dt}>{m.selected.distance}</dt><dd data-sel-distance class={dd}></dd></div>
            <div class="min-w-0"><dt class={dt}>{m.selected.speed}</dt><dd data-sel-speed class={dd}></dd></div>
            <div class="min-w-0"><dt class={dt}>{m.selected.period}</dt><dd data-sel-period class={dd}></dd></div>
            <div class="min-w-0"><dt class={dt}>{m.selected.eccentricity}</dt><dd data-sel-eccentricity class={dd}></dd></div>
          </dl>
        </form>
      </section>

      <section aria-labelledby="gr-stats-heading" class:list={[ui.card, 'p-4 sm:p-5']}>
        <h2 id="gr-stats-heading" class={headingClass}>{m.stats.heading}</h2>
        <dl class="mt-3 grid grid-cols-1 gap-x-5 gap-y-4 min-[22rem]:grid-cols-2">
          <div class="min-w-0"><dt class={dt}>{m.stats.elapsed}</dt><dd data-stat-elapsed class={dd}>0 {m.units.s}</dd></div>
          <div class="min-w-0"><dt class={dt}>{m.stats.count}</dt><dd data-stat-count class={dd}>2</dd></div>
          <div class="min-w-0"><dt class={dt}>{m.stats.energy}</dt><dd data-stat-energy class={dd}>–</dd></div>
          <div class="min-w-0">
            <dt class={dt}>{m.stats.drift}</dt>
            <dd data-stat-drift aria-describedby="gr-drift-note" class={dd}>0</dd>
          </div>
        </dl>
        <p id="gr-drift-note" class="mt-3 text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{m.stats.driftNote}</p>
      </section>
    </div>

    <!-- 3. Bodies, as text -->
    <section aria-labelledby="gr-list-heading" class:list={[ui.card, 'min-w-0 p-4 sm:p-5 lg:col-start-1 lg:row-start-2']}>
      <h2 id="gr-list-heading" class={headingClass}>{m.list.heading}</h2>
      <p data-list-empty hidden class:list={[hintClass, 'mt-3']}>{m.list.empty}</p>
      <div
        data-list-scroll
        role="region"
        aria-labelledby="gr-list-heading"
        tabindex="0"
        class="mt-3 max-h-[24rem] overflow-auto rounded-lg border border-zinc-200 focus-visible:outline-offset-2 dark:border-zinc-800"
      >
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th scope="col" class={th}>{m.list.columns.name}</th>
              <th scope="col" class={th}>{m.list.columns.mass}</th>
              <th scope="col" class={th}>{m.list.columns.attractor}</th>
              <th scope="col" class={th}>{m.list.columns.distance}</th>
              <th scope="col" class={th}>{m.list.columns.speed}</th>
            </tr>
          </thead>
          <tbody data-list-body></tbody>
        </table>
      </div>
    </section>
  </div>
</section>

<script>
  import { initGravity } from '../../scripts/tools/gravity/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-gravity]').forEach(initGravity);
