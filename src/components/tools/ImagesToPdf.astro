---
/**
 * Images to PDF tool UI. Behaviour lives in src/scripts/tools/images-to-pdf/controller.ts;
 * every hook is a data-* attribute scoped to the root section.
 */
const selectClass =
  'min-h-11 w-full rounded-lg border border-zinc-300 bg-white px-3 text-base text-zinc-900 disabled:cursor-not-allowed disabled:opacity-60 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100';
const labelTextClass = 'text-sm font-medium text-zinc-900 dark:text-zinc-100';
// Base classes carry no text color so variants below never compete with each other.
const toolbarButtonBase =
  'inline-flex min-h-11 items-center justify-center rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 dark:disabled:hover:bg-zinc-900';
const toolbarButtonClass = `${toolbarButtonBase} text-zinc-900 dark:text-zinc-100`;
const clearButtonClass = `${toolbarButtonBase} text-rose-700 dark:text-rose-400`;
const cardButtonBase =
  'flex min-h-11 min-w-11 items-center justify-center text-zinc-600 focus-visible:-outline-offset-2 hover:bg-zinc-100 disabled:pointer-events-none disabled:opacity-30 dark:text-zinc-400 dark:hover:bg-zinc-800';
const cardButtonClass = `${cardButtonBase} hover:text-zinc-900 dark:hover:text-zinc-100`;
const removeButtonClass = `${cardButtonBase} hover:text-rose-700 dark:hover:text-rose-400`;
---

<section data-images-to-pdf aria-label="Images to PDF converter" class="mt-8 flex flex-col gap-4">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"
    >
      This tool needs JavaScript. It runs entirely in your browser; nothing is uploaded.
    </p>
  </noscript>

  <!-- 1. Dropzone / file picker -->
  <label
    data-dropzone
    class="group flex min-h-[40vh] cursor-pointer flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-zinc-300 bg-white p-6 text-center transition-colors focus-within:ring-2 focus-within:ring-emerald-700 focus-within:ring-offset-2 focus-within:ring-offset-zinc-50 hover:border-emerald-600 sm:min-h-72 data-[compact]:min-h-12 data-[compact]:flex-row data-[compact]:justify-start data-[compact]:gap-3 data-[compact]:px-4 data-[compact]:py-2 data-[compact]:text-left sm:data-[compact]:min-h-12 data-[disabled]:cursor-not-allowed data-[disabled]:opacity-60 data-[disabled]:hover:border-zinc-300 data-[dragover]:border-emerald-600 data-[dragover]:bg-emerald-50 dark:border-zinc-700 dark:bg-zinc-900 dark:focus-within:ring-emerald-500 dark:focus-within:ring-offset-zinc-950 dark:hover:border-emerald-500 dark:data-[disabled]:hover:border-zinc-700 dark:data-[dragover]:border-emerald-500 dark:data-[dragover]:bg-emerald-500/10"
  >
    <input data-file-input type="file" accept="image/*" multiple class="sr-only" />
    <span
      aria-hidden="true"
      class="flex size-14 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 group-data-[compact]:size-9 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-7 group-data-[compact]:size-5"
      >
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <circle cx="9" cy="9" r="2"></circle>
        <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
      </svg>
    </span>
    <span class="flex flex-col gap-1 group-data-[compact]:flex-row group-data-[compact]:flex-wrap group-data-[compact]:items-baseline group-data-[compact]:gap-x-2">
      <span data-dropzone-title class="text-lg font-semibold text-zinc-900 group-data-[compact]:text-base dark:text-zinc-100">
        Choose images
      </span>
      <span class="text-sm text-zinc-600 dark:text-zinc-400 [@media(pointer:coarse)]:hidden">or drop them here</span>
    </span>
    <span class="max-w-sm text-sm leading-relaxed text-zinc-600 group-data-[compact]:hidden dark:text-zinc-400">
      Your images never leave your device. Supports JPG, PNG, WebP, GIF, AVIF and BMP (HEIC where your browser
      supports it).
    </span>
  </label>

  <p data-import-status aria-hidden="true" hidden class="text-sm text-zinc-600 tabular-nums dark:text-zinc-400"></p>

  <!-- 2. Notices -->
  <div data-notices class="flex flex-col gap-3 empty:hidden"></div>
  <template data-notice-template>
    <div
      data-notice
      class="flex items-start gap-2 rounded-xl border border-zinc-200 bg-white py-2 pr-2 pl-4 text-sm data-[tone=warning]:border-amber-300 data-[tone=warning]:bg-amber-50 data-[tone=warning]:text-amber-950 dark:border-zinc-800 dark:bg-zinc-900 dark:data-[tone=warning]:border-amber-500/30 dark:data-[tone=warning]:bg-amber-500/10 dark:data-[tone=warning]:text-amber-100"
    >
      <div class="min-w-0 flex-1 py-2">
        <p data-notice-message class="font-medium"></p>
        <ul data-notice-list hidden class="mt-1 list-disc space-y-0.5 pl-5 break-words"></ul>
      </div>
      <button
        type="button"
        data-notice-dismiss
        aria-label="Dismiss notice"
        class="flex size-11 shrink-0 items-center justify-center rounded-lg text-current opacity-70 hover:bg-black/5 hover:opacity-100 dark:hover:bg-white/10"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </template>

  <!-- 3. Toolbar -->
  <div data-toolbar hidden class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <p class="min-w-0 text-sm text-zinc-600 dark:text-zinc-400">
      <span data-count class="font-semibold text-zinc-900 dark:text-zinc-100">0 images</span>
      <span aria-hidden="true"> · </span>
      <span class="[@media(pointer:coarse)]:hidden">Drag to reorder</span>
      <span class="hidden [@media(pointer:coarse)]:inline">Long-press and drag to reorder</span>
    </p>
    <div role="group" aria-label="Arrange images" class="flex flex-wrap gap-2">
      <button type="button" data-sort class={toolbarButtonClass}>Sort A–Z</button>
      <button type="button" data-reverse class={toolbarButtonClass}>Reverse</button>
      <button
        type="button"
        data-clear
        class={clearButtonClass}
      >
        Clear all
      </button>
    </div>
    <a
      href="#itp-options"
      class="sr-only rounded-lg text-sm font-medium text-emerald-700 underline underline-offset-4 focus:not-sr-only focus:inline-flex focus:min-h-11 focus:items-center focus:px-2 dark:text-emerald-400"
    >
      Skip to PDF options
    </a>
  </div>

  <!-- 4. Pages grid -->
  <ol data-grid role="list" aria-label="Pages in order" class="grid grid-cols-2 gap-3 empty:hidden sm:grid-cols-3 md:grid-cols-4"></ol>
  <template data-card-template>
    <li
      data-item
      class="relative flex min-w-0 cursor-grab flex-col overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm select-none [-webkit-touch-callout:none] active:cursor-grabbing dark:border-zinc-800 dark:bg-zinc-900"
    >
      <div class="relative bg-zinc-100 dark:bg-zinc-800">
        <img
          data-thumb
          alt=""
          draggable="false"
          decoding="async"
          class="pointer-events-none block aspect-[3/4] w-full object-contain"
        />
        <span
          data-badge
          aria-hidden="true"
          class="absolute top-2 left-2 flex h-7 min-w-7 items-center justify-center rounded-full bg-zinc-900/80 px-2 text-xs font-semibold text-white tabular-nums dark:bg-zinc-100/90 dark:text-zinc-900"
        ></span>
      </div>
      <div class="flex min-w-0 flex-col gap-0.5 px-2.5 pt-2 pb-1.5">
        <p data-name class="truncate text-sm font-medium text-zinc-900 dark:text-zinc-100"></p>
        <p data-meta class="truncate text-xs text-zinc-600 tabular-nums dark:text-zinc-400"></p>
      </div>
      <div class="mt-auto grid grid-cols-3 border-t border-zinc-200 dark:border-zinc-800">
        <button type="button" data-move="earlier" class={cardButtonClass}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
        <button type="button" data-move="later" class={cardButtonClass}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
        <button
          type="button"
          data-remove
          class={removeButtonClass}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
            <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
          </svg>
        </button>
      </div>
    </li>
  </template>

  <!-- 5. Options -->
  <fieldset
    id="itp-options"
    tabindex="-1"
    data-options
    class="min-w-0 rounded-xl border border-zinc-200 bg-white p-4 sm:p-5 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <legend class="float-left mb-4 w-full text-base font-semibold text-zinc-900 dark:text-zinc-100">PDF options</legend>
    <div class="clear-both grid grid-cols-1 gap-4 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5">
        <span class={labelTextClass}>Page size</span>
        <select data-option="pageSize" class={selectClass}>
          <option value="a4" selected>A4</option>
          <option value="letter">US Letter</option>
          <option value="fit">Fit to image</option>
        </select>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class={labelTextClass}>Orientation</span>
        <select data-option="orientation" class={selectClass}>
          <option value="auto" selected>Auto (match each image)</option>
          <option value="portrait">Portrait</option>
          <option value="landscape">Landscape</option>
        </select>
        <span data-orientation-hint hidden class="text-xs text-zinc-600 dark:text-zinc-400">
          Not used with “Fit to image”.
        </span>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class={labelTextClass}>Margin</span>
        <select data-option="margin" class={selectClass}>
          <option value="none">None</option>
          <option value="small" selected>Small (10 mm)</option>
          <option value="large">Large (20 mm)</option>
        </select>
        <span data-margin-hint hidden class="text-xs text-zinc-600 dark:text-zinc-400">
          Added around each image with “Fit to image”.
        </span>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class={labelTextClass}>Quality</span>
        <select data-option="quality" class={selectClass}>
          <option value="original" selected>Original quality</option>
          <option value="compressed">Smaller file</option>
        </select>
      </label>

      <label class="flex flex-col gap-1.5 sm:col-span-2">
        <span class={labelTextClass}>File name</span>
        <input
          data-filename
          type="text"
          value="images.pdf"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="done"
          class={selectClass}
        />
      </label>
    </div>
  </fieldset>

  <!-- 6. Action bar (sticky on phones with enough height; keep it to one row plus status) -->
  <div
    data-action-bar
    class="bottom-0 z-30 flex flex-col gap-3 border-t border-zinc-200 bg-zinc-50/95 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md max-md:[@media(min-height:32rem)]:sticky md:border-t-0 md:bg-transparent md:p-0 md:backdrop-blur-none dark:border-zinc-800 dark:bg-zinc-950/95 md:dark:bg-transparent"
  >
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-3">
      <button
        type="button"
        data-generate
        disabled
        class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-emerald-700 px-6 text-base font-semibold text-white shadow-sm hover:bg-emerald-800 disabled:cursor-not-allowed disabled:bg-zinc-200 disabled:text-zinc-500 disabled:shadow-none md:w-auto dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400 dark:disabled:bg-zinc-800 dark:disabled:text-zinc-500"
      >
        Generate PDF
      </button>
      <button
        type="button"
        data-cancel
        hidden
        class="inline-flex min-h-12 w-full items-center justify-center rounded-lg border border-zinc-300 bg-white px-6 text-base font-medium text-zinc-900 hover:bg-zinc-100 md:w-auto dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
      >
        Cancel
      </button>
    </div>

    <div data-progress-block hidden class="flex flex-col gap-1.5">
      <progress
        data-progress
        max="1"
        value="0"
        aria-label="PDF creation progress"
        class="h-2 w-full appearance-none overflow-hidden rounded-full bg-zinc-200 accent-emerald-600 dark:bg-zinc-800 [&::-moz-progress-bar]:bg-emerald-600 [&::-webkit-progress-bar]:bg-zinc-200 [&::-webkit-progress-value]:bg-emerald-600 dark:[&::-moz-progress-bar]:bg-emerald-500 dark:[&::-webkit-progress-bar]:bg-zinc-800 dark:[&::-webkit-progress-value]:bg-emerald-500"
      ></progress>
      <p data-progress-text aria-hidden="true" class="text-sm text-zinc-600 tabular-nums dark:text-zinc-400"></p>
    </div>

    <p
      data-status
      class="text-sm text-zinc-600 empty:hidden data-[tone=error]:font-medium data-[tone=error]:text-rose-700 dark:text-zinc-400 dark:data-[tone=error]:text-rose-400"
    ></p>
  </div>

  <!-- 7. Result (outside the sticky bar so it never covers the pages) -->
  <div
    data-result
    hidden
    class="flex flex-col gap-3 rounded-xl border border-emerald-600/20 bg-emerald-50 p-3 sm:flex-row sm:items-center sm:p-4 dark:border-emerald-500/25 dark:bg-emerald-500/10"
  >
    <p data-result-text class="text-sm font-medium text-emerald-900 sm:mr-auto dark:text-emerald-200"></p>
    <div class="flex flex-wrap gap-2">
      <a
        data-download-again
        download="images.pdf"
        class="inline-flex min-h-11 flex-1 items-center justify-center rounded-lg border border-zinc-300 bg-white px-4 text-sm font-medium text-zinc-900 hover:bg-zinc-100 sm:flex-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
      >
        Download again
      </a>
      <button
        type="button"
        data-share
        hidden
        class="inline-flex min-h-11 flex-1 items-center justify-center rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white hover:bg-emerald-800 sm:flex-none dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400"
      >
        Share
      </button>
    </div>
  </div>
</section>

<style is:global>
  /* Focus scrolling keeps controls clear of the sticky action bar (height set by the controller). */
  @media (width < 48rem) and (min-height: 32rem) {
    html {
      scroll-padding-bottom: var(--itp-action-bar-height, 0px);
    }
  }

  /* SortableJS adds these classes at runtime, so they cannot be scoped styles. */
  .itp-ghost {
    opacity: 0.35;
    outline: 2px dashed var(--color-emerald-500, #10b981);
    outline-offset: -2px;
    box-shadow: none;
  }

  .itp-chosen:not(.itp-ghost) {
    box-shadow:
      0 0 0 2px var(--color-emerald-500, #10b981),
      0 10px 25px -8px rgb(0 0 0 / 0.25);
  }

  /* The floating clone. Sortable positions it with an inline transform, so use `rotate`. */
  .itp-drag {
    rotate: 2deg;
    cursor: grabbing;
    box-shadow:
      0 0 0 2px var(--color-emerald-500, #10b981),
      0 20px 40px -12px rgb(0 0 0 / 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .itp-drag {
      rotate: none;
    }
  }
</style>

<script>
  import { initImagesToPdf } from '../../scripts/tools/images-to-pdf/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-images-to-pdf]').forEach(initImagesToPdf);
</script>
