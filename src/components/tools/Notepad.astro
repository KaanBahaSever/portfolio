---
/**
 * Notepad tool UI. Behaviour lives in src/scripts/tools/notepad/controller.ts;
 * every hook is a data-* attribute scoped to the root section.
 */

// Base classes carry no text color so variants below never compete with each other.
const buttonBase =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 dark:disabled:hover:bg-zinc-900';
const toolbarButtonClass = `${buttonBase} text-zinc-900 aria-pressed:border-emerald-600/40 aria-pressed:bg-emerald-50 aria-pressed:text-emerald-800 aria-expanded:border-emerald-600/40 aria-expanded:bg-emerald-50 aria-expanded:text-emerald-800 dark:text-zinc-100 dark:aria-pressed:border-emerald-500/40 dark:aria-pressed:bg-emerald-500/15 dark:aria-pressed:text-emerald-300 dark:aria-expanded:border-emerald-500/40 dark:aria-expanded:bg-emerald-500/15 dark:aria-expanded:text-emerald-300`;
const iconButtonClass =
  'inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100';
const toggleBase =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-zinc-200 bg-white px-2.5 text-sm text-zinc-700 hover:bg-zinc-100 aria-pressed:border-emerald-600/50 aria-pressed:bg-emerald-50 aria-pressed:text-emerald-800 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:aria-pressed:border-emerald-500/50 dark:aria-pressed:bg-emerald-500/15 dark:aria-pressed:text-emerald-300';
const toggleClass = `${toggleBase} font-mono`;
const fieldClass =
  'min-h-11 w-full rounded-lg border border-zinc-300 bg-white px-3 text-base text-zinc-900 placeholder:text-zinc-500 sm:pointer-fine:text-sm dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:placeholder:text-zinc-500';
const iconClass = 'size-5 shrink-0';
const statValueClass = 'mt-0.5 text-base font-semibold text-zinc-900 tabular-nums dark:text-zinc-100';
const statLabelClass = 'text-xs text-zinc-600 dark:text-zinc-400';
/**
 * Shared by the textarea and the highlight mirror behind it: both must lay text out
 * identically (the rest lives in .np-surface below). Text fields only go below 16px with a
 * fine pointer: iOS Safari zooms into smaller focused fields (phones in landscape are wider than sm).
 */
const surfaceClass =
  'np-surface border px-3 py-2.5 font-mono text-base leading-6 sm:px-4 sm:py-3 sm:pointer-fine:text-sm sm:pointer-fine:leading-[1.375rem]';
---

<section data-notepad aria-label="Notepad" class="mt-8 flex flex-col gap-3">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"
    >
      This tool needs JavaScript. It runs entirely in your browser; nothing is uploaded.
    </p>
  </noscript>

  <!-- 1. Toolbar -->
  <div class="flex flex-wrap items-center gap-2">
    <div role="group" aria-label="File" class="flex flex-wrap gap-2">
      <button type="button" data-new class={toolbarButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
          <path d="M14 2v4a2 2 0 0 0 2 2h4M9 15h6M12 18v-6"></path>
        </svg>
        New
      </button>
      <button type="button" data-open class={toolbarButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path>
        </svg>
        Open
      </button>
      <input
        data-open-input
        type="file"
        hidden
        tabindex="-1"
        accept="text/*,.md,.txt,.json,.csv,.log,.xml,.yml,.yaml,.ini,.js,.ts,.css,.html,.py,.go,.c,.cpp,.cs,.java,.sql,.sh"
      />
    </div>
    <div role="group" aria-label="Search and view" class="flex flex-wrap gap-2">
      <button type="button" data-find-toggle aria-expanded="false" aria-controls="np-find-panel" class={toolbarButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        Find
      </button>
      <button type="button" data-replace-toggle aria-expanded="false" aria-controls="np-find-panel" class={toolbarButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16"></path>
        </svg>
        Replace
      </button>
      <button type="button" data-wrap-toggle aria-pressed="true" title="Wrap long lines" class={toolbarButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="M3 6h18M3 12h15a3 3 0 1 1 0 6h-4M3 18h7"></path>
          <path d="m16 16-2 2 2 2"></path>
        </svg>
        Wrap lines
      </button>
    </div>
  </div>

  <p
    data-message
    class="text-sm text-zinc-600 empty:hidden data-[tone=error]:font-medium data-[tone=error]:text-rose-700 dark:text-zinc-400 dark:data-[tone=error]:text-rose-400"
  ></p>

  <!-- 2. Find & replace -->
  <div
    id="np-find-panel"
    data-find-panel
    role="search"
    aria-label="Find and replace"
    hidden
    class="flex flex-col gap-2 rounded-xl border border-zinc-200 bg-white p-2 sm:p-3 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <div class="flex items-center gap-1 sm:gap-2">
      <div
        class="flex min-h-11 min-w-0 flex-1 items-center rounded-lg border border-zinc-300 bg-white focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-emerald-700 has-[[aria-invalid=true]]:border-rose-500 dark:border-zinc-700 dark:bg-zinc-950 dark:focus-within:outline-emerald-500 dark:has-[[aria-invalid=true]]:border-rose-400"
      >
        <input
          id="np-find"
          data-find-input
          type="text"
          aria-label="Find"
          aria-describedby="np-find-count np-find-error"
          placeholder="Find"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          class="min-h-11 w-full min-w-0 flex-1 rounded-lg bg-transparent px-3 text-base text-zinc-900 placeholder:text-zinc-500 focus-visible:outline-none sm:pointer-fine:text-sm dark:text-zinc-100"
        />
        <span
          id="np-find-count"
          data-find-count
          class="shrink-0 pr-3 text-xs whitespace-nowrap text-zinc-600 tabular-nums empty:hidden data-[tone=none]:text-rose-700 dark:text-zinc-400 dark:data-[tone=none]:text-rose-400"
        ></span>
      </div>
      <button type="button" data-find-prev aria-label="Previous match" class={iconButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="m18 15-6-6-6 6"></path>
        </svg>
      </button>
      <button type="button" data-find-next aria-label="Next match" class={iconButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>
    </div>

    <p id="np-find-error" data-find-error hidden class="px-1 text-sm break-words text-rose-700 dark:text-rose-400"></p>

    <div class="flex items-start gap-2">
      <div role="group" aria-label="Search options" class="flex min-w-0 flex-1 flex-wrap gap-2">
        <button type="button" data-search-option="matchCase" aria-pressed="false" aria-label="Match case" class={toggleClass}>
          <span aria-hidden="true">Aa</span>
        </button>
        <button type="button" data-search-option="wholeWord" aria-pressed="false" aria-label="Match whole word" class={`${toggleBase} gap-1.5`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
            <path d="M3 17v3h18v-3"></path>
          </svg>
          <span aria-hidden="true">Word</span>
        </button>
        <button type="button" data-search-option="regex" aria-pressed="false" aria-label="Use regular expression" class={toggleClass}>
          <span aria-hidden="true">.*</span>
        </button>
        <button
          type="button"
          data-search-option="multiline"
          data-regex-only
          hidden
          aria-pressed="true"
          aria-label="^ and $ match each line"
          class={toggleClass}
        >
          <span aria-hidden="true">^$</span>
        </button>
        <button
          type="button"
          data-search-option="dotAll"
          data-regex-only
          hidden
          aria-pressed="false"
          aria-label="Dot matches newline"
          class={toggleClass}
        >
          <span aria-hidden="true">.\n</span>
        </button>
      </div>
      <button type="button" data-find-close aria-label="Close find and replace" class={iconButtonClass}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class={iconClass} aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div data-replace-row hidden class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <input
        id="np-replace"
        data-replace-input
        type="text"
        aria-label="Replace with"
        placeholder="Replace with"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="done"
        class={`${fieldClass} sm:flex-1`}
      />
      <div class="flex gap-2">
        <button type="button" data-replace-one class={`${buttonBase} flex-1 text-zinc-900 sm:flex-none dark:text-zinc-100`}>
          Replace
        </button>
        <button type="button" data-replace-all class={`${buttonBase} flex-1 text-zinc-900 sm:flex-none dark:text-zinc-100`}>
          Replace all
        </button>
      </div>
    </div>

    <div
      data-replace-result
      hidden
      class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-emerald-600/20 bg-emerald-50 py-1 pr-1 pl-3 dark:border-emerald-500/25 dark:bg-emerald-500/10"
    >
      <p data-replace-result-text class="mr-auto py-2 text-sm font-medium text-emerald-900 tabular-nums dark:text-emerald-200"></p>
      <button
        type="button"
        data-undo-replace
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-3 text-sm font-semibold text-emerald-800 hover:bg-emerald-600/10 dark:text-emerald-300 dark:hover:bg-emerald-400/10"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
          <path d="M9 14 4 9l5-5"></path>
          <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"></path>
        </svg>
        Undo
      </button>
    </div>

    <details data-preview hidden class="group rounded-lg border border-zinc-200 dark:border-zinc-800">
      <summary
        class="flex min-h-11 list-none items-center justify-between gap-3 rounded-lg px-3 text-sm font-medium text-zinc-900 dark:text-zinc-100 [&::-webkit-details-marker]:hidden"
      >
        <span data-preview-title class="tabular-nums">Preview changes</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <ol
        data-preview-list
        class="max-h-72 divide-y divide-zinc-200 overflow-y-auto overscroll-contain border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800"
      ></ol>
      <p data-preview-note hidden class="border-t border-zinc-200 px-3 py-2 text-xs text-zinc-600 dark:border-zinc-800 dark:text-zinc-400"></p>
    </details>
    <template data-preview-item-template>
      <li class="flex flex-col gap-0.5 px-3 py-2 sm:flex-row sm:gap-3">
        <span data-preview-line class="shrink-0 text-xs font-medium text-zinc-600 tabular-nums sm:w-20 sm:pt-0.5 dark:text-zinc-400"></span>
        {/* One line on purpose: whitespace between these tags would show (pre-wrap). */}
        <span class="min-w-0 font-mono text-[0.8125rem] leading-5 break-all whitespace-pre-wrap text-zinc-600 dark:text-zinc-400"><span data-preview-before></span><span class="sr-only">, replace </span><del data-preview-old class="rounded-sm bg-rose-100 text-rose-900 decoration-rose-600 dark:bg-rose-500/20 dark:text-rose-200 dark:decoration-rose-400"></del><span class="sr-only"> with </span><ins data-preview-new class="rounded-sm bg-emerald-100 text-emerald-900 no-underline dark:bg-emerald-500/20 dark:text-emerald-200"></ins><span data-preview-after></span></span>
      </li>
    </template>
  </div>

  <!-- 3. Editor: a transparent textarea over a mirror that draws the match highlights -->
  <div data-editor-wrap data-wrap="on" class="relative rounded-xl bg-white dark:bg-zinc-900">
    <div data-backdrop aria-hidden="true" translate="no" class="pointer-events-none absolute inset-0 overflow-hidden rounded-xl select-none">
      <div data-mirror class={`${surfaceClass} np-mirror group relative min-h-full w-full border-transparent`}></div>
    </div>
    <textarea
      data-editor
      id="np-editor"
      aria-label="Text"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      autocorrect="off"
      placeholder="Start typing, or open a text file…"
      class={`${surfaceClass} np-editor relative block min-h-[55dvh] w-full rounded-xl border-zinc-200 bg-transparent text-zinc-900 placeholder:text-zinc-400 sm:min-h-[60vh] dark:border-zinc-800 dark:text-zinc-100 dark:placeholder:text-zinc-500`}
    ></textarea>
    <template data-mark-template>
      <mark
        class="rounded-[3px] bg-amber-200/80 text-transparent group-data-[replace]:line-through group-data-[replace]:decoration-rose-600 group-data-[replace]:decoration-2 data-[current]:bg-orange-300 data-[current]:ring-2 data-[current]:ring-orange-500 dark:bg-amber-400/40 dark:group-data-[replace]:decoration-rose-400 dark:data-[current]:bg-orange-500/60 dark:data-[current]:ring-orange-400"
      ></mark>
    </template>
  </div>

  <!-- 4. Status bar -->
  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1 text-sm text-zinc-600 tabular-nums dark:text-zinc-400">
      <span data-caret>Ln 1, Col 1</span>
      <span data-selection-count hidden class="font-medium text-zinc-900 dark:text-zinc-100"></span>
      <span data-summary="characters">0 characters</span>
      <span data-summary="words">0 words</span>
      <span data-summary="sentences" class="max-sm:hidden">0 sentences</span>
      <span data-summary="lines" class="max-sm:hidden">0 lines</span>
      <span data-summary="bytes" title="File size as saved (UTF-8)">0 B</span>
      <span data-save-state class="empty:hidden data-[state=dirty]:text-amber-700 dark:data-[state=dirty]:text-amber-400"></span>
    </div>

    <details class="group rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
      <summary
        class="flex min-h-11 list-none items-center justify-between gap-3 rounded-xl px-4 text-sm font-medium text-zinc-900 dark:text-zinc-100 [&::-webkit-details-marker]:hidden"
      >
        More stats
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 border-t border-zinc-200 px-4 py-3 sm:grid-cols-4 dark:border-zinc-800">
        <div>
          <dt class={statLabelClass}>Characters</dt>
          <dd data-detail="characters" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Characters without spaces</dt>
          <dd data-detail="charactersNoSpaces" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Words</dt>
          <dd data-detail="words" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Sentences</dt>
          <dd data-detail="sentences" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Lines</dt>
          <dd data-detail="lines" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Paragraphs</dt>
          <dd data-detail="paragraphs" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Bytes (UTF-8, as saved)</dt>
          <dd data-detail="bytes" class={statValueClass}>0</dd>
        </div>
        <div>
          <dt class={statLabelClass}>Reading time</dt>
          <dd data-detail="readingMinutes" class={statValueClass}>0 min</dd>
        </div>
      </dl>
    </details>
  </div>

  <!-- 5. Save As (sticky on phones with enough height) -->
  <div
    data-save-bar
    class="bottom-0 z-30 border-t border-zinc-200 bg-zinc-50/95 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md max-md:[@media(min-height:32rem)]:sticky md:border-t-0 md:bg-transparent md:p-0 md:backdrop-blur-none dark:border-zinc-800 dark:bg-zinc-950/95 md:dark:bg-transparent"
  >
    <div class="flex flex-wrap items-center gap-2">
      <label for="np-filename" class="sr-only">File name</label>
      <input
        id="np-filename"
        data-filename
        type="text"
        value="untitled.txt"
        placeholder="File name"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="done"
        class="min-h-11 min-w-0 flex-[999_1_8rem] rounded-lg border border-zinc-300 bg-white px-3 text-base text-zinc-900 placeholder:text-zinc-500 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:placeholder:text-zinc-500"
      />
      <label for="np-line-ending" class="sr-only">Line endings</label>
      <select
        id="np-line-ending"
        data-line-ending
        autocomplete="off"
        class="min-h-11 shrink-0 rounded-lg border border-zinc-300 bg-white px-3 text-base text-zinc-900 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100"
      >
        <option value="lf" selected>LF</option>
        <option value="crlf">CRLF (Windows)</option>
      </select>
      <button
        type="button"
        data-save
        class="inline-flex min-h-12 grow items-center justify-center gap-2 rounded-lg bg-emerald-700 px-6 text-base font-semibold text-white shadow-sm hover:bg-emerald-800 md:grow-0 dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
          <path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path>
        </svg>
        Save As
      </button>
    </div>
  </div>
</section>

<style is:global>
  /* Focus scrolling keeps controls clear of the sticky Save As bar (height set by the controller). */
  @media (width < 48rem) and (min-height: 32rem) {
    html {
      scroll-padding-bottom: var(--np-save-bar-height, 0px);
    }
  }

  /*
   * The textarea and its highlight mirror must break lines at exactly the same places.
   * Font family, size, line height, padding and border come from the shared utility classes;
   * everything else that affects text layout is pinned here for both elements.
   */
  .np-surface {
    box-sizing: border-box;
    margin: 0;
    font-style: normal;
    font-weight: 400;
    font-kerning: none;
    font-variant-ligatures: none;
    letter-spacing: normal;
    word-spacing: normal;
    text-align: start;
    text-indent: 0;
    text-transform: none;
    text-rendering: auto;
    tab-size: 4;
    -moz-tab-size: 4;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: none;
  }

  [data-wrap='off'] .np-surface {
    white-space: pre;
    overflow-wrap: normal;
  }

  .np-editor {
    appearance: none;
    resize: none;
    overflow: auto;
  }

  @media (width >= 48rem) {
    .np-editor {
      resize: vertical;
    }
  }

  /* The textarea draws the text; the mirror only paints highlight backgrounds. */
  .np-mirror {
    color: transparent;
  }

  .np-mirror mark {
    padding: 0;
    margin: 0;
    border: 0;
    font: inherit;
  }
</style>

<script>
  import { initNotepad } from '../../scripts/tools/notepad/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-notepad]').forEach(initNotepad);
</script>
