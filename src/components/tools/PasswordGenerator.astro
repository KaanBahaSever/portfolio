---
/**
 * Password Generator UI. Behaviour lives in src/scripts/tools/password-generator/controller.ts;
 * every hook is a data-* attribute scoped to the root section. Text comes from
 * src/i18n/tools/password-generator.ts, which the controller reads too.
 *
 * The server-rendered HTML never contains a password: the controller generates the first one in
 * the browser and replaces the skeleton.
 */
import Icon from '../ui/Icon.astro';
import { ui } from '../ui/styles';
import { formatters } from '../../i18n/format';
import { getLocale } from '../../i18n/server';
import { passwordMessages } from '../../i18n/tools/password-generator';
import { DEFAULT_LENGTH, MAX_LENGTH, MIN_LENGTH } from '../../lib/password/generate.ts';

const locale = getLocale(Astro);
const m = passwordMessages[locale];
const f = formatters(locale);

const legendClass = 'float-left w-full text-sm font-semibold text-zinc-900 dark:text-zinc-100';
const checkboxClass =
  'size-5 shrink-0 cursor-pointer accent-accent-700 disabled:cursor-not-allowed dark:accent-accent-500';
/** Button icons give way to the label on the narrowest phones. */
const iconClass = 'size-5 shrink-0 max-[22.5rem]:hidden';
// Like ui.buttonPrimary / ui.buttonSecondary, one size up (min-h-12, text-base): these are the page's
// main actions. Written out rather than appended, because conflicting utilities do not override by order.
const primaryButtonClass =
  'inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent-700 px-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-accent-800 sm:px-6 dark:bg-accent-500 dark:text-zinc-950 dark:hover:bg-accent-400';
const secondaryButtonClass =
  'inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white px-3 text-base font-semibold text-zinc-900 transition-colors hover:bg-zinc-100 sm:px-6 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800';

const types = [
  { name: 'uppercase', sample: 'A–Z', sampleHidden: false },
  { name: 'lowercase', sample: 'a–z', sampleHidden: false },
  { name: 'numbers', sample: '0–9', sampleHidden: false },
  // Punctuation read aloud one by one is noise; the label says enough.
  { name: 'symbols', sample: '!#$%*+', sampleHidden: true },
] as const;

const advanced = [
  { option: 'excludeLookAlikes', text: m.lookAlikes, checked: false },
  { option: 'requireEachType', text: m.eachType, checked: true },
] as const;

const segments = [0, 1, 2, 3, 4];
---

<section data-password-generator aria-label={m.regionLabel} class="mt-8 flex flex-col gap-4 sm:mt-10">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"
    >
      {m.noscript}
    </p>
  </noscript>

  <!-- 1. Output -->
  <div class="flex flex-col gap-3">
    <div class:list={[ui.card, 'relative isolate overflow-hidden p-4 sm:p-6']}>
      <!-- Graph paper under the password: the page's notebook motif, faded so it never competes with the text. -->
      <div class="bg-graph mask-fade-b pointer-events-none absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
      <h2 class="sr-only">{m.outputHeading}</h2>
      <!-- Coloured characters for sighted users; tap or click selects the whole password. -->
      <p
        data-password-visual
        data-size="short"
        aria-hidden="true"
        translate="no"
        class="min-h-8 font-mono break-all text-zinc-900 select-all data-[size=long]:text-lg data-[size=short]:text-2xl sm:min-h-9 sm:data-[size=long]:text-xl sm:data-[size=short]:text-3xl dark:text-zinc-100 [&>[data-kind=numbers]]:text-accent-700 dark:[&>[data-kind=numbers]]:text-accent-400 [&>[data-kind=symbols]]:text-rose-700 dark:[&>[data-kind=symbols]]:text-rose-400"
      >
        <span class="block h-8 w-4/5 rounded-md bg-zinc-200 sm:h-9 dark:bg-zinc-800"></span>
      </p>
      <!-- The same value as plain text for screen readers. -->
      <p data-password-text translate="no" class="sr-only"></p>

      <div class="mt-5 flex flex-col gap-2">
        <div class="grid grid-cols-5 gap-1.5" aria-hidden="true">
          {
            segments.map(() => (
              <span
                data-strength-segment
                data-tone="off"
                class="h-1 rounded-full data-[tone=fair]:bg-amber-600 data-[tone=off]:bg-zinc-200 data-[tone=strong]:bg-accent-600 data-[tone=weak]:bg-rose-600 dark:data-[tone=fair]:bg-amber-400 dark:data-[tone=off]:bg-zinc-800 dark:data-[tone=strong]:bg-accent-500 dark:data-[tone=weak]:bg-rose-500"
              />
            ))
          }
        </div>
        <p class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
          <span class="flex items-center gap-1.5">
            <span class="text-zinc-600 dark:text-zinc-400">{m.strengthLabel}</span>
            <span
              data-strength-label
              class="font-semibold empty:inline-block empty:h-4 empty:w-20 empty:rounded empty:bg-zinc-200 data-[tone=fair]:text-amber-700 data-[tone=strong]:text-accent-700 data-[tone=weak]:text-rose-700 dark:empty:bg-zinc-800 dark:data-[tone=fair]:text-amber-400 dark:data-[tone=strong]:text-accent-400 dark:data-[tone=weak]:text-rose-400"
            ></span>
          </span>
          <span class="font-mono text-xs text-zinc-600 tabular-nums dark:text-zinc-400">
            <span aria-hidden="true">≈</span><span class="sr-only">{m.about}</span>{' '}<span
              data-strength-bits
              class="empty:inline-block empty:h-4 empty:w-14 empty:rounded empty:bg-zinc-200 empty:align-middle dark:empty:bg-zinc-800"
            ></span>
          </span>
        </p>
      </div>
    </div>

    <!-- 2. Actions -->
    <div class="grid grid-cols-2 gap-2 sm:flex sm:gap-3">
      <button type="button" data-copy data-state="idle" class:list={['group sm:min-w-40', primaryButtonClass]}>
        <Icon name="copy" class={`${iconClass} group-data-[state=copied]:hidden`} />
        <Icon
          name="check"
          class="hidden size-5 shrink-0 group-data-[state=copied]:block max-[22.5rem]:group-data-[state=copied]:hidden"
        />
        <span data-copy-label>{m.copy}</span>
      </button>
      <button type="button" data-generate class:list={['group', secondaryButtonClass]}>
        <Icon name="refresh" class={`${iconClass} transition-transform duration-300 group-active:rotate-90`} />
        {m.generate}
      </button>
    </div>

    <p
      data-status
      class="text-sm text-zinc-600 empty:hidden data-[tone=error]:font-medium data-[tone=error]:text-rose-700 dark:text-zinc-400 dark:data-[tone=error]:text-rose-400"
    ></p>
  </div>

  <!-- 3. Options -->
  <div class:list={[ui.card, 'flex flex-col gap-6 p-4 sm:p-6']}>
    <h2 class="sr-only">{m.optionsHeading}</h2>

    <div class="flex flex-col gap-1">
      <div class="flex items-center justify-between gap-3">
        <label for="pwg-length" class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">{m.length}</label>
        <input
          id="pwg-length"
          data-length-number
          type="number"
          inputmode="numeric"
          min={MIN_LENGTH}
          max={MAX_LENGTH}
          step="1"
          value={DEFAULT_LENGTH}
          enterkeyhint="done"
          class="min-h-11 w-20 rounded-lg border border-zinc-300 bg-white px-2 text-center font-mono text-base text-zinc-900 tabular-nums dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100"
        />
      </div>
      <input
        data-length-range
        type="range"
        min={MIN_LENGTH}
        max={MAX_LENGTH}
        step="1"
        value={DEFAULT_LENGTH}
        aria-label={m.length}
        aria-valuetext={m.characters(DEFAULT_LENGTH)}
        class="h-11 w-full cursor-pointer accent-accent-700 dark:accent-accent-500"
      />
      <div aria-hidden="true" class="flex justify-between font-mono text-xs text-zinc-600 tabular-nums dark:text-zinc-400">
        <span>{f.number(MIN_LENGTH)}</span>
        <span>{f.number(MAX_LENGTH)}</span>
      </div>
    </div>

    <fieldset class="min-w-0">
      <legend class={legendClass}>{m.typesLegend}</legend>
      <div class="clear-both grid grid-cols-2 gap-2 pt-2 md:grid-cols-4">
        {
          types.map((type) => (
            <label class="flex min-h-14 cursor-pointer items-center gap-2 rounded-lg border border-zinc-200 px-2.5 py-2 transition-colors hover:bg-zinc-50 has-checked:border-accent-600 has-checked:bg-accent-50 has-disabled:cursor-not-allowed sm:gap-3 sm:px-3 dark:border-zinc-800 dark:hover:bg-zinc-800/50 dark:has-checked:border-accent-500/60 dark:has-checked:bg-accent-500/10">
              <input type="checkbox" data-type={type.name} checked class={checkboxClass} />
              <span class="flex min-w-0 flex-col">
                <span class="text-sm font-medium text-zinc-900 sm:text-base dark:text-zinc-100">{m.types[type.name]}</span>
                <span
                  aria-hidden={type.sampleHidden ? 'true' : undefined}
                  translate="no"
                  class="font-mono text-sm text-zinc-600 dark:text-zinc-400"
                >
                  {type.sample}
                </span>
              </span>
            </label>
          ))
        }
      </div>
      <p id="pwg-types-hint" data-types-hint hidden class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
        {m.typesHint}
      </p>
    </fieldset>

    <fieldset class="min-w-0">
      <legend class={legendClass}>{m.advancedLegend}</legend>
      <div class="clear-both flex flex-col gap-1 pt-1">
        {
          advanced.map((item) => (
            <label class="-mx-2 flex min-h-11 cursor-pointer items-start gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-zinc-50 dark:hover:bg-zinc-800/50">
              <input
                type="checkbox"
                data-option={item.option}
                checked={item.checked}
                class:list={[checkboxClass, 'mt-0.5']}
              />
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="text-sm font-medium text-zinc-900 sm:text-base dark:text-zinc-100">{item.text.label}</span>
                <span class="text-sm text-zinc-600 dark:text-zinc-400">{item.text.detail}</span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>
</section>

<script>
  import { initPasswordGenerator } from '../../scripts/tools/password-generator/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-password-generator]').forEach(initPasswordGenerator);
</script>
