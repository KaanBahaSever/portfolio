---
/**
 * Password Generator UI. Behaviour lives in src/scripts/tools/password-generator/controller.ts;
 * every hook is a data-* attribute scoped to the root section.
 *
 * The server-rendered HTML never contains a password: the controller generates the first one in
 * the browser and replaces the skeleton.
 */
import { DEFAULT_LENGTH, MAX_LENGTH, MIN_LENGTH } from '../../lib/password/generate.ts';

const cardClass = 'rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900';
const legendClass = 'float-left w-full text-sm font-semibold text-zinc-900 dark:text-zinc-100';
const checkboxClass = 'size-5 shrink-0 cursor-pointer accent-emerald-700 disabled:cursor-not-allowed dark:accent-emerald-500';
const iconClass = 'size-5 shrink-0 max-[22.5rem]:hidden';

const types = [
  { name: 'uppercase', label: 'Uppercase', sample: 'A–Z', sampleHidden: false },
  { name: 'lowercase', label: 'Lowercase', sample: 'a–z', sampleHidden: false },
  { name: 'numbers', label: 'Numbers', sample: '0–9', sampleHidden: false },
  { name: 'symbols', label: 'Symbols', sample: '!#$%*+', sampleHidden: true },
] as const;

const advanced = [
  {
    option: 'excludeLookAlikes',
    label: 'Avoid look-alike characters',
    detail: 'Leaves out I, l, 1, |, O, o and 0, which are easy to mix up.',
    checked: false,
  },
  {
    option: 'requireEachType',
    label: 'Include every selected type',
    detail: 'At least one character from each type you selected.',
    checked: true,
  },
] as const;

const segments = [0, 1, 2, 3, 4];
---

<section data-password-generator aria-label="Password generator" class="mt-6 flex flex-col gap-4 sm:mt-8">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"
    >
      This tool needs JavaScript. Passwords are generated in your browser; nothing is sent anywhere.
    </p>
  </noscript>

  <!-- 1. Output -->
  <div class="flex flex-col gap-3">
    <div class:list={[cardClass, 'p-4 sm:p-5']}>
      <h2 class="sr-only">Generated password</h2>
      <!-- Colored characters for sighted users; tap or click selects the whole password. -->
      <p
        data-password-visual
        data-size="short"
        aria-hidden="true"
        translate="no"
        class="min-h-8 font-mono break-all text-zinc-900 select-all data-[size=long]:text-lg data-[size=short]:text-2xl sm:data-[size=long]:text-xl sm:data-[size=short]:text-3xl sm:min-h-9 dark:text-zinc-100 [&>[data-kind=numbers]]:text-emerald-700 dark:[&>[data-kind=numbers]]:text-emerald-400 [&>[data-kind=symbols]]:text-rose-700 dark:[&>[data-kind=symbols]]:text-rose-400"
      >
        <span class="block h-8 w-4/5 rounded-md bg-zinc-200 sm:h-9 dark:bg-zinc-800"></span>
      </p>
      <!-- The same value as plain text for screen readers. -->
      <p data-password-text translate="no" class="sr-only"></p>

      <div class="mt-4 flex flex-col gap-2">
        <div class="grid grid-cols-5 gap-1.5" aria-hidden="true">
          {
            segments.map(() => (
              <span
                data-strength-segment
                data-tone="off"
                class="h-1.5 rounded-full data-[tone=fair]:bg-amber-600 data-[tone=off]:bg-zinc-200 data-[tone=strong]:bg-emerald-600 data-[tone=weak]:bg-rose-600 dark:data-[tone=fair]:bg-amber-400 dark:data-[tone=off]:bg-zinc-800 dark:data-[tone=strong]:bg-emerald-500 dark:data-[tone=weak]:bg-rose-500"
              />
            ))
          }
        </div>
        <p class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
          <span class="flex items-center gap-1.5">
            <span class="text-zinc-600 dark:text-zinc-400">Strength:</span>
            <span
              data-strength-label
              class="font-semibold empty:inline-block empty:h-4 empty:w-20 empty:rounded empty:bg-zinc-200 data-[tone=fair]:text-amber-700 data-[tone=strong]:text-emerald-700 data-[tone=weak]:text-rose-700 dark:empty:bg-zinc-800 dark:data-[tone=fair]:text-amber-400 dark:data-[tone=strong]:text-emerald-400 dark:data-[tone=weak]:text-rose-400"
            ></span>
          </span>
          <span class="text-zinc-600 tabular-nums dark:text-zinc-400">
            <span aria-hidden="true">≈</span><span class="sr-only">about</span>
            <span
              data-strength-bits
              class="empty:inline-block empty:h-4 empty:w-14 empty:rounded empty:bg-zinc-200 empty:align-middle dark:empty:bg-zinc-800"
            ></span>
          </span>
        </p>
      </div>
    </div>

    <!-- 2. Actions -->
    <div class="grid grid-cols-2 gap-2 sm:flex sm:gap-3">
      <button
        type="button"
        data-copy
        data-state="idle"
        class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-emerald-700 px-3 text-base font-semibold text-white shadow-sm hover:bg-emerald-800 sm:min-w-40 sm:px-6 dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class:list={[iconClass, 'group-data-[state=copied]:hidden']}
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden size-5 shrink-0 group-data-[state=copied]:block max-[22.5rem]:group-data-[state=copied]:hidden"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
      <button
        type="button"
        data-generate
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white px-3 text-base font-semibold text-zinc-900 hover:bg-zinc-100 sm:px-6 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={iconClass}
          aria-hidden="true"
        >
          <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path>
          <path d="M21 3v5h-5"></path>
          <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path>
          <path d="M3 21v-5h5"></path>
        </svg>
        Generate new
      </button>
    </div>

    <p
      data-status
      class="text-sm text-zinc-600 empty:hidden data-[tone=error]:font-medium data-[tone=error]:text-rose-700 dark:text-zinc-400 dark:data-[tone=error]:text-rose-400"
    ></p>
  </div>

  <!-- 3. Options -->
  <div class:list={[cardClass, 'flex flex-col gap-6 p-4 sm:p-5']}>
    <h2 class="sr-only">Options</h2>

    <div class="flex flex-col gap-1">
      <div class="flex items-center justify-between gap-3">
        <label for="pwg-length" class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Length</label>
        <input
          id="pwg-length"
          data-length-number
          type="number"
          inputmode="numeric"
          min={MIN_LENGTH}
          max={MAX_LENGTH}
          step="1"
          value={DEFAULT_LENGTH}
          enterkeyhint="done"
          class="min-h-11 w-20 rounded-lg border border-zinc-300 bg-white px-2 text-center text-base text-zinc-900 tabular-nums dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100"
        />
      </div>
      <input
        data-length-range
        type="range"
        min={MIN_LENGTH}
        max={MAX_LENGTH}
        step="1"
        value={DEFAULT_LENGTH}
        aria-label="Length"
        class="h-11 w-full cursor-pointer accent-emerald-700 dark:accent-emerald-500"
      />
      <div aria-hidden="true" class="flex justify-between text-xs text-zinc-600 tabular-nums dark:text-zinc-400">
        <span>{MIN_LENGTH}</span>
        <span>{MAX_LENGTH}</span>
      </div>
    </div>

    <fieldset class="min-w-0">
      <legend class={legendClass}>Character types</legend>
      <div class="clear-both grid grid-cols-2 gap-2 pt-2 md:grid-cols-4">
        {
          types.map((type) => (
            <label class="flex min-h-14 cursor-pointer items-center gap-2 rounded-lg border border-zinc-200 px-2.5 py-2 sm:gap-3 sm:px-3 hover:bg-zinc-50 has-checked:border-emerald-600 has-checked:bg-emerald-50 has-disabled:cursor-not-allowed dark:border-zinc-800 dark:hover:bg-zinc-800/50 dark:has-checked:border-emerald-500/60 dark:has-checked:bg-emerald-500/10">
              <input
                type="checkbox"
                data-type={type.name}
                data-label={type.label}
                checked
                class={checkboxClass}
              />
              <span class="flex min-w-0 flex-col">
                <span class="text-sm font-medium text-zinc-900 sm:text-base dark:text-zinc-100">{type.label}</span>
                <span
                  aria-hidden={type.sampleHidden ? 'true' : undefined}
                  class="font-mono text-sm text-zinc-600 dark:text-zinc-400"
                >
                  {type.sample}
                </span>
              </span>
            </label>
          ))
        }
      </div>
      <p id="pwg-types-hint" data-types-hint hidden class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
        At least one type must stay selected.
      </p>
    </fieldset>

    <fieldset class="min-w-0">
      <legend class={legendClass}>Advanced</legend>
      <div class="clear-both flex flex-col gap-1 pt-1">
        {
          advanced.map((item) => (
            <label class="-mx-2 flex min-h-11 cursor-pointer items-start gap-3 rounded-lg px-2 py-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50">
              <input
                type="checkbox"
                data-option={item.option}
                checked={item.checked}
                class:list={[checkboxClass, 'mt-0.5']}
              />
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="text-sm font-medium text-zinc-900 sm:text-base dark:text-zinc-100">{item.label}</span>
                <span class="text-sm text-zinc-600 dark:text-zinc-400">{item.detail}</span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>
</section>

<script>
  import { initPasswordGenerator } from '../../scripts/tools/password-generator/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-password-generator]').forEach(initPasswordGenerator);
</script>
