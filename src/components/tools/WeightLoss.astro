---
/**
 * Weight-loss calculator UI. Behaviour lives in src/scripts/tools/weight-loss/controller.ts;
 * every hook is a data-* attribute scoped to the root section. Text comes from
 * src/i18n/tools/weight-loss.ts through the presenter (src/scripts/tools/weight-loss/present.ts),
 * which the controller uses too.
 *
 * The plan depends on today's date, which the build cannot know, so the fields are filled in
 * here with the defaults and the controller computes the first plan in the browser (with the
 * visitor's saved values, if any). Until then the result shows placeholders of the same shape.
 */
import Icon from '../ui/Icon.astro';
import { ui } from '../ui/styles';
import { formatters } from '../../i18n/format';
import { getLocale } from '../../i18n/server';
import { weightLossMessages } from '../../i18n/tools/weight-loss';
import {
  ACTIVITY_FACTORS,
  ACTIVITY_LEVELS,
  BMR_FORMULAS,
  DEFAULTS,
  GRANULARITIES,
  PLAN_MODES,
  SEXES,
  bmrAt,
  bmrLine,
  defaultIntake,
} from '../../lib/health/weight-plan';
import { COLUMNS } from '../../scripts/tools/weight-loss/present';

const locale = getLocale(Astro);
const m = weightLossMessages[locale];
const f = formatters(locale);

const decimal = (value: number) => f.number(value, { maximumFractionDigits: 1, useGrouping: false });
const startIntake = defaultIntake(
  bmrAt(bmrLine(DEFAULTS.formula, { ...DEFAULTS, bodyFatPercent: null }), DEFAULTS.weightKg) *
    ACTIVITY_FACTORS[DEFAULTS.activity],
);

/** Text fields: id, label, unit, default value. Numbers are typed as text so "72,5" works. */
const bodyFields = [
  { name: 'age', label: m.form.age, unit: m.form.ageUnit, value: decimal(DEFAULTS.age), inputmode: 'numeric' },
  { name: 'height', label: m.form.height, unit: 'cm', value: decimal(DEFAULTS.heightCm), inputmode: 'decimal' },
  { name: 'weight', label: m.form.weight, unit: 'kg', value: decimal(DEFAULTS.weightKg), inputmode: 'decimal' },
  { name: 'target', label: m.form.target, unit: 'kg', value: decimal(DEFAULTS.targetKg), inputmode: 'decimal' },
] as const;

const labelClass = 'text-sm font-medium text-zinc-700 dark:text-zinc-300';
const legendClass = 'float-left w-full text-sm font-medium text-zinc-700 dark:text-zinc-300';
const hintClass = 'text-sm leading-relaxed text-zinc-600 dark:text-zinc-400';
const errorClass = 'text-sm text-rose-700 dark:text-rose-400';
/**
 * Numbers in mono so digits line up; room on the right for the unit. An invalid field turns
 * rose and its message says why, so colour is not the only cue.
 */
const inputClass = `${ui.field} pr-16 font-mono tabular-nums aria-invalid:border-rose-600 dark:aria-invalid:border-rose-400`;
const unitClass =
  'pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-zinc-600 dark:text-zinc-400';
/** One option of a segmented control (as in the Image compressor): a visually hidden radio inside its label. */
const segment =
  'relative flex min-h-11 min-w-12 flex-1 cursor-pointer items-center justify-center rounded-md px-3 text-center text-sm font-medium text-zinc-600 transition-colors select-none hover:text-zinc-900 has-checked:bg-white has-checked:text-zinc-900 has-checked:shadow-sm has-checked:ring-1 has-checked:ring-accent-600 has-focus-visible:outline-2 has-focus-visible:outline-offset-1 has-focus-visible:outline-accent-700 dark:text-zinc-400 dark:hover:text-zinc-100 dark:has-checked:bg-zinc-800 dark:has-checked:text-zinc-50 dark:has-checked:ring-accent-500 dark:has-focus-visible:outline-accent-400';
const segmentGroup =
  'flex rounded-lg border border-zinc-200 bg-zinc-100/80 p-0.5 dark:border-zinc-800 dark:bg-zinc-950';
const dt = 'label-mono text-zinc-600 dark:text-zinc-400';
/**
 * While a value is half-typed, the last plan stays on screen but visibly out of date: its
 * figures turn grey (zinc-500 keeps 4.8:1 on white, zinc-400 about 7:1 on zinc-900).
 */
const stale =
  'transition-colors duration-200 group-data-[state=stale]/result:text-zinc-500 dark:group-data-[state=stale]/result:text-zinc-400';
const th =
  'sticky top-0 z-10 bg-white px-3 py-2 text-right align-bottom text-xs font-semibold whitespace-nowrap text-zinc-700 shadow-[inset_0_-1px_0] shadow-zinc-200 first:text-left dark:bg-zinc-900 dark:text-zinc-300 dark:shadow-zinc-800';

const columnUnits: Record<(typeof COLUMNS)[number], string> = {
  date: '',
  day: '',
  weight: 'kg',
  lost: 'kg',
  bmr: 'kcal',
  maintenance: 'kcal',
  intake: 'kcal',
  deficit: 'kcal',
  bmi: '',
};
const placeholderCards = [m.result.bmr, m.result.maintenance, m.result.deficit, m.result.firstWeek, m.result.bmi, m.result.linear];
---

<section data-weight-loss aria-label={m.toolLabel} class="mt-8 sm:mt-10">
  <p data-announcer class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

  <noscript>
    <p
      class="mb-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100"
    >
      {m.noscript}
    </p>
  </noscript>

  {/* Phones: details, plan, chart, table. From lg the details and the plan sit side by side. */}
  <div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start">
    <!-- 1. Details -->
    <form
      data-form
      novalidate
      autocomplete="off"
      aria-labelledby="wl-form-heading"
      class:list={[ui.card, 'min-w-0 p-4 sm:p-6']}
    >
      <div class="flex items-center justify-between gap-3">
        <h2 id="wl-form-heading" class="label-mono text-zinc-600 dark:text-zinc-400">{m.form.heading}</h2>
        <button type="button" data-reset class:list={[ui.buttonGhost, '-my-2 -mr-2']}>
          <Icon name="refresh" class="size-4 shrink-0" />
          {m.form.reset}
        </button>
      </div>

      <fieldset class="mt-4 min-w-0">
        <legend class={legendClass}>{m.form.sex}</legend>
        <div class:list={[segmentGroup, 'clear-both mt-1.5']}>
          {
            SEXES.map((sex) => (
              <label class={segment}>
                <input type="radio" name="wl-sex" value={sex} data-sex class="sr-only" checked={sex === DEFAULTS.sex} />
                {m.form.sexes[sex]}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-5 grid grid-cols-1 gap-x-4 gap-y-4 min-[22rem]:grid-cols-2">
        {
          bodyFields.map((field) => (
            <div class="flex min-w-0 flex-col gap-1.5">
              <label for={`wl-${field.name}`} class={labelClass}>
                {field.label}
                <span class="sr-only"> ({field.unit})</span>
              </label>
              <div class="relative">
                <input
                  id={`wl-${field.name}`}
                  data-field={field.name}
                  type="text"
                  inputmode={field.inputmode}
                  value={field.value}
                  autocomplete="off"
                  spellcheck="false"
                  enterkeyhint="next"
                  aria-describedby={`wl-${field.name}-error`}
                  class={inputClass}
                />
                <span aria-hidden="true" class={unitClass}>
                  {field.unit}
                </span>
              </div>
              <p id={`wl-${field.name}-error`} data-error-for={field.name} hidden class={errorClass} />
            </div>
          ))
        }
      </div>

      <div class="mt-5 flex min-w-0 flex-col gap-1.5">
        <label for="wl-activity" class={labelClass}>{m.form.activity}</label>
        <select id="wl-activity" data-activity aria-describedby="wl-activity-detail" class:list={[ui.field, 'cursor-pointer']}>
          {
            ACTIVITY_LEVELS.map((level) => (
              <option value={level} selected={level === DEFAULTS.activity}>
                {m.form.activities[level].label} (×{f.number(ACTIVITY_FACTORS[level], { maximumFractionDigits: 3 })})
              </option>
            ))
          }
        </select>
        <p id="wl-activity-detail" data-activity-detail class={hintClass}>
          {m.form.activities[DEFAULTS.activity].detail}
        </p>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-[minmax(0,1fr)_9rem]">
        <div class="flex min-w-0 flex-col gap-1.5">
          <label for="wl-formula" class={labelClass}>{m.form.formula}</label>
          <select id="wl-formula" data-formula aria-describedby="wl-formula-detail" class:list={[ui.field, 'cursor-pointer']}>
            {
              BMR_FORMULAS.map((formula) => (
                <option value={formula} selected={formula === DEFAULTS.formula} disabled={formula === 'katch'}>
                  {m.form.formulas[formula].label}
                  {formula === 'katch' && ` (${m.form.needsBodyFat})`}
                </option>
              ))
            }
          </select>
          <p id="wl-formula-detail" data-formula-detail class={hintClass}>{m.form.formulas[DEFAULTS.formula].detail}</p>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5">
          <label for="wl-bodyFat" class={labelClass}>
            {m.form.bodyFat}{' '}
            <span class="font-normal text-zinc-600 dark:text-zinc-400">({m.form.optional})</span>
          </label>
          <div class="relative">
            <input
              id="wl-bodyFat"
              data-field="bodyFat"
              type="text"
              inputmode="decimal"
              value=""
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="next"
              aria-describedby="wl-bodyFat-hint wl-bodyFat-error"
              class={inputClass}
            />
            <span aria-hidden="true" class={unitClass}>%</span>
          </div>
          <p id="wl-bodyFat-hint" class="sr-only">{m.form.bodyFatHint}</p>
          <p id="wl-bodyFat-error" data-error-for="bodyFat" hidden class={errorClass}></p>
        </div>
      </div>

      <fieldset class="mt-6 min-w-0 border-t border-zinc-200 pt-5 dark:border-zinc-800">
        <legend class={legendClass}>{m.form.planBy}</legend>
        <div class:list={[segmentGroup, 'clear-both mt-1.5']}>
          {
            PLAN_MODES.map((mode) => (
              <label class={segment}>
                <input type="radio" name="wl-mode" value={mode} data-mode class="sr-only" checked={mode === DEFAULTS.mode} />
                {m.form.modes[mode]}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div data-mode-field="intake" class="mt-4 flex min-w-0 flex-col gap-1.5">
        <label for="wl-intake" class={labelClass}>
          {m.form.intake}
          <span class="sr-only"> (kcal)</span>
        </label>
        <div class="relative">
          <input
            id="wl-intake"
            data-field="intake"
            type="text"
            inputmode="numeric"
            value={f.number(startIntake, { useGrouping: false })}
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="next"
            aria-describedby="wl-intake-hint wl-intake-auto wl-intake-error"
            class={inputClass}
          />
          <span aria-hidden="true" class={unitClass}>{m.form.perDay}</span>
        </div>
        <p id="wl-intake-error" data-error-for="intake" hidden class={errorClass}></p>
        <p id="wl-intake-hint" data-intake-hint class={hintClass}></p>
        <p id="wl-intake-auto" data-intake-auto class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
          {m.form.intakeAuto}
        </p>
      </div>

      <div data-mode-field="deficit" hidden class="mt-4 flex min-w-0 flex-col gap-1.5">
        <label for="wl-deficit" class={labelClass}>
          {m.form.deficit}
          <span class="sr-only"> (kcal)</span>
        </label>
        <div class="relative">
          <input
            id="wl-deficit"
            data-field="deficit"
            type="text"
            inputmode="numeric"
            value={f.number(DEFAULTS.deficitKcal, { useGrouping: false })}
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="next"
            aria-describedby="wl-deficit-hint wl-deficit-error"
            class={inputClass}
          />
          <span aria-hidden="true" class={unitClass}>{m.form.perDay}</span>
        </div>
        <p id="wl-deficit-error" data-error-for="deficit" hidden class={errorClass}></p>
        <p id="wl-deficit-hint" data-deficit-hint class={hintClass}></p>
      </div>

      <div class="mt-5 flex min-w-0 flex-col gap-1.5 sm:max-w-[16rem]">
        <label for="wl-start" class={labelClass}>{m.form.start}</label>
        <input
          id="wl-start"
          data-field="start"
          type="date"
          min="2000-01-01"
          max="2100-12-31"
          aria-describedby="wl-start-error"
          class:list={[ui.field, 'font-mono tabular-nums aria-invalid:border-rose-600 dark:aria-invalid:border-rose-400']}
        />
        <p id="wl-start-error" data-error-for="start" hidden class={errorClass}></p>
      </div>
    </form>

    <!-- 2. Plan -->
    <section
      data-result
      data-state="ready"
      aria-labelledby="wl-result-heading"
      class:list={[ui.card, 'group/result min-w-0 p-4 sm:p-6']}
    >
      <h2 id="wl-result-heading" class="label-mono text-zinc-600 dark:text-zinc-400">{m.result.heading}</h2>

      <p
        data-status
        hidden
        class="mt-4 border-l-2 border-zinc-300 pl-3 text-sm leading-relaxed text-zinc-700 dark:border-zinc-600 dark:text-zinc-300"
      >
      </p>

      <p data-headline class="mt-4 text-sm font-medium text-zinc-700 dark:text-zinc-300">{m.result.targetDate}</p>
      <p
        data-date
        class:list={[
          'mt-1 font-serif text-3xl leading-tight font-medium tracking-tight text-balance text-zinc-900 sm:text-4xl dark:text-zinc-50',
          stale,
        ]}
      >
        {m.result.none}
      </p>
      <p data-duration class:list={['mt-2 min-h-5 font-mono text-sm text-zinc-600 tabular-nums dark:text-zinc-400', stale]}>
      </p>
      <p data-message hidden class:list={['mt-3 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300', stale]}></p>

      <dl
        data-cards
        class="mt-5 grid grid-cols-1 gap-x-6 gap-y-5 border-t border-zinc-200 pt-5 min-[22rem]:grid-cols-2 dark:border-zinc-800"
      >
        {
          placeholderCards.map((label) => (
            <div class="min-w-0">
              <dt class={dt}>{label}</dt>
              <dd class="mt-1">
                <span class:list={['block font-mono text-base text-zinc-900 tabular-nums dark:text-zinc-100', stale]}>
                  {m.result.none}
                </span>
                <span class="block text-sm text-zinc-600 dark:text-zinc-400">&nbsp;</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div data-warnings-box hidden class="mt-5">
        <h3 class="sr-only">{m.result.warningsLabel}</h3>
        <ul
          data-warnings
          class="space-y-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300 [&>li]:border-l-2 [&>li]:border-amber-500 [&>li]:pl-3 dark:[&>li]:border-amber-400"
        >
        </ul>
      </div>

      <p class="mt-5 border-t border-zinc-200 pt-4 text-xs leading-relaxed text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
        {m.result.disclaimer}
      </p>
    </section>
  </div>

  <!-- 3. Chart -->
  <figure data-chart class:list={[ui.card, 'group/figure relative isolate mt-6 min-w-0 overflow-hidden p-4 sm:p-6']}>
    <div class="bg-graph-fine mask-fade-radial pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <span class="label-mono text-accent-700 dark:text-accent-400">{m.chart.label} · {m.chart.title}</span>
    </div>
    <div data-chart-host class="mt-4 min-w-0 touch-pan-y transition-opacity duration-300 group-data-[stale]/figure:opacity-40">
      <svg
        data-chart-svg
        role="img"
        aria-label={m.chart.title}
        viewBox="0 0 640 248"
        height="248"
        class="block w-full cursor-crosshair overflow-visible select-none"
        focusable="false"
      >
      </svg>
    </div>
    <p
      data-readout
      aria-hidden="true"
      class="mt-3 min-h-10 text-sm leading-relaxed text-zinc-700 tabular-nums sm:min-h-5 dark:text-zinc-300"
    >
      {m.chart.readoutIdle}
    </p>
    <figcaption class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600 dark:text-zinc-400">
      <span class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 8" class="h-2 w-6 shrink-0 text-accent-600 dark:text-accent-400" aria-hidden="true">
          <path d="M1 4h22" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        {m.chart.weight}
      </span>
      <span class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 8" class="h-2 w-6 shrink-0 text-zinc-900 dark:text-zinc-100" aria-hidden="true">
          <path d="M1 4h22" stroke="currentColor" stroke-width="1" stroke-dasharray="5 4" stroke-opacity="0.75"></path>
        </svg>
        {m.chart.target}
      </span>
      <span data-legend="linear" class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 8" class="h-2 w-6 shrink-0 text-zinc-500 dark:text-zinc-400" aria-hidden="true">
          <path d="M1 4h22" stroke="currentColor" stroke-width="1.25" stroke-dasharray="3 4"></path>
        </svg>
        {m.chart.linear}
      </span>
      <span data-legend="level" hidden class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 8" class="h-2 w-6 shrink-0 text-zinc-500 dark:text-zinc-400" aria-hidden="true">
          <path d="M1 4h22" stroke="currentColor" stroke-width="1" stroke-dasharray="1 4" stroke-linecap="round"></path>
        </svg>
        {m.chart.level}
      </span>
    </figcaption>
  </figure>

  <!-- 4. Table -->
  <section data-table aria-labelledby="wl-table-heading" class:list={[ui.card, 'mt-6 min-w-0 p-4 sm:p-6']}>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="wl-table-heading" class="label-mono text-zinc-600 dark:text-zinc-400">{m.table.heading}</h2>
      <fieldset>
        <legend class="sr-only">{m.table.show}</legend>
        <div class={segmentGroup}>
          {
            GRANULARITIES.map((granularity) => (
              <label class={segment}>
                <input
                  type="radio"
                  name="wl-granularity"
                  value={granularity}
                  data-granularity
                  class="sr-only"
                  checked={granularity === 'weekly'}
                />
                {m.table.granularity[granularity]}
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>

    <div
      data-table-scroll
      role="region"
      aria-labelledby="wl-table-heading"
      tabindex="0"
      class="mt-4 max-h-[30rem] overflow-auto rounded-lg border border-zinc-200 transition-opacity duration-300 focus-visible:outline-offset-2 data-[stale]:opacity-40 dark:border-zinc-800"
    >
      <table class="w-full border-collapse text-sm">
        <caption data-caption class="sr-only"></caption>
        <thead>
          <tr>
            {
              COLUMNS.map((column) => (
                <th scope="col" class={th}>
                  {m.table.columns[column]}
                  {columnUnits[column] && (
                    <span class="block font-mono text-[0.6875rem] font-normal text-zinc-600 dark:text-zinc-400">
                      {columnUnits[column]}
                    </span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody data-table-body></tbody>
      </table>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <button type="button" data-download class={ui.buttonSecondary}>
        <Icon name="download" class="size-4 shrink-0" />
        {m.table.download}
      </button>
      <p class={hintClass}>{m.table.downloadHint}</p>
    </div>
  </section>
</section>

<script>
  import { initWeightLoss } from '../../scripts/tools/weight-loss/controller.ts';

  document.querySelectorAll<HTMLElement>('[data-weight-loss]').forEach(initWeightLoss);
</script>
