---
/** Small status pill ("Open source", "Private", "Coming soon"). */
interface Props {
  variant?: 'accent' | 'muted';
  class?: string;
}

const { variant = 'muted', class: className } = Astro.props;

const variants = {
  accent:
    'bg-accent-50 text-accent-800 ring-accent-600/20 dark:bg-accent-500/10 dark:text-accent-300 dark:ring-accent-500/25',
  muted: 'bg-zinc-100 text-zinc-600 ring-zinc-500/15 dark:bg-zinc-800 dark:text-zinc-400 dark:ring-zinc-400/15',
} as const;
---

<span
  class:list={[
    'inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
