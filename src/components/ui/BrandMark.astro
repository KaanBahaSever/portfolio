---
/**
 * The site's mark: a geometric lambda whose two strokes meet at an accent node — λ for
 * eigenvalues and for lambda calculus, the meeting point of mathematics and computing.
 * Same geometry as public/favicon.svg. Decorative: pair it with the site name.
 */
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path d="M9 5.5 23 26.5" stroke="currentColor" stroke-width="3.25" stroke-linecap="round"></path>
  <path d="M16 16 9 26.5" stroke="currentColor" stroke-width="3.25" stroke-linecap="round"></path>
  <circle cx="16" cy="16" r="3.1" class="fill-accent-600 dark:fill-accent-400"></circle>
</svg>
