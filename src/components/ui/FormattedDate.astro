---
/**
 * Renders a <time> element, formatted for the page's locale ("March 1, 2020" / "1 Mart 2020")
 * through formatters(). Dates from frontmatter are parsed as UTC midnight, and formatters()
 * formats in UTC, so other build time zones cannot shift the day.
 */
import { formatters, type DateStyle } from '../../i18n/format';
import type { Locale } from '../../i18n/config';
import { getLocale } from '../../i18n/server';

interface Props {
  date: Date;
  /** 'long' (default), 'short', 'year', 'monthYear' ("Mar 2020") or 'monthYearLong' ("March 2020"). */
  format?: DateStyle;
  class?: string;
  /** Format in another locale than the page's (rarely needed). */
  locale?: Locale;
}

const { date, format = 'long', class: className, locale = getLocale(Astro) } = Astro.props;

const label = formatters(locale).date(date, format);
// Machine-readable value at the precision that is shown.
const iso = date.toISOString();
const datetime = format === 'year' ? iso.slice(0, 4) : format.startsWith('monthYear') ? iso.slice(0, 7) : iso.slice(0, 10);
---

<time datetime={datetime} class={className}>{label}</time>
