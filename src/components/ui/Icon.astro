---
/**
 * Small inline SVG icon set (stroke icons, 24x24 grid). Decorative by default:
 * always pair with visible or screen-reader text.
 */
export type IconName =
  | 'download'
  | 'menu'
  | 'close'
  | 'external'
  | 'arrow-left'
  | 'arrow-right'
  | 'mail'
  | 'lock'
  | 'map-pin';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<IconName, string[]> = {
  download: ['M12 4v11', 'm7 10 5 5 5-5', 'M5 20h14'],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  close: ['M6 6l12 12', 'M18 6 6 18'],
  external: ['M14 4h6v6', 'M20 4 10 14', 'M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5'],
  'arrow-left': ['M19 12H5', 'm11 18-6-6 6-6'],
  'arrow-right': ['M5 12h14', 'm13 6 6 6-6 6'],
  mail: ['M4 6h16v12H4z', 'm4 7 8 6 8-6'],
  lock: ['M6 11h12v9H6z', 'M8.5 11V8a3.5 3.5 0 0 1 7 0v3'],
  'map-pin': ['M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z', 'M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z'],
};
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
