---
/**
 * A list of blog posts: date, reading time, serif title (a stretched link), description and tags.
 * Pass posts listed for the page's locale (getPublishedPosts(locale) or getPostsForProject()):
 * each of them has a page under that locale. Every post shows a small badge with the language it
 * is written in (TR or EN), so readers know before they click (the owner asked for it), and a
 * dashed badge for each other language it can be read in, linking to that version. A post in
 * the other language also carries `lang` on its title and description (plus `hreflang` on the
 * link), so screen readers switch pronunciation.
 */
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';
import { readingMinutes } from '../blog/reading-time';
import { LOCALE_META, localizePath } from '../../i18n/config';
import { blogMessages } from '../../i18n/messages/blog';
import { common } from '../../i18n/messages/common';
import { getLocale } from '../../i18n/server';
import { getAllPosts, type BlogPost } from '../../utils/content';

interface Props {
  posts: BlogPost[];
  headingLevel?: 'h2' | 'h3';
  showDescription?: boolean;
  showTags?: boolean;
  /** "6 min read" after the date. */
  showReadingTime?: boolean;
}

const {
  posts,
  headingLevel: Heading = 'h2',
  showDescription = true,
  showTags = false,
  showReadingTime = true,
} = Astro.props;

const locale = getLocale(Astro);
const m = blogMessages[locale];
const t = common[locale];

// Every language a post can be read in: its own, then its translations (same translationKey).
const allPosts = await getAllPosts();
const translationsOf = (post: BlogPost) =>
  post.data.translationKey
    ? allPosts.filter((other) => other.id !== post.id && other.data.translationKey === post.data.translationKey)
    : [];

const items = posts.map((post) => {
  const foreign = post.data.lang !== locale;
  return {
    post,
    href: localizePath(`/blog/${post.id}/`, locale),
    minutes: readingMinutes(post.body),
    // Only set where it differs from the page, so the markup stays quiet in the common case.
    lang: foreign ? LOCALE_META[post.data.lang].htmlLang : undefined,
    badge: { short: LOCALE_META[post.data.lang].short, name: m.languageName[post.data.lang] },
    // The other language versions link straight to their own page.
    translations: translationsOf(post).map((other) => ({
      short: LOCALE_META[other.data.lang].short,
      label: m.list.readIn(m.languageName[other.data.lang]),
      href: localizePath(`/blog/${other.id}/`, other.data.lang),
      hreflang: LOCALE_META[other.data.lang].htmlLang,
    })),
  };
});
---

<ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
  {
    items.map(({ post, href, minutes, lang, badge, translations }) => (
      <li class="py-6 first:pt-0 last:pb-0">
        <article class="group relative">
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-zinc-600 tabular-nums dark:text-zinc-400">
            <FormattedDate date={post.data.pubDate} format="short" />
            {showReadingTime && (
              <>
                <span aria-hidden="true" class="text-zinc-400 dark:text-zinc-600">
                  ·
                </span>
                <span>{m.list.readingTime(minutes)}</span>
              </>
            )}
            <span class="ms-1 inline-flex items-center rounded border border-zinc-300 px-1.5 py-px text-[0.6875rem] leading-4 font-medium tracking-wider text-zinc-700 dark:border-zinc-700 dark:text-zinc-300">
              <span aria-hidden="true">{badge.short}</span>
              <span class="sr-only"> {m.list.writtenIn(badge.name)}</span>
            </span>
            {/* Above the title's stretched link (relative z-10), so each badge is its own link. */}
            {translations.map((translation) => (
              <a
                href={translation.href}
                hreflang={translation.hreflang}
                title={translation.label}
                class="relative z-10 inline-flex items-center rounded border border-dashed border-zinc-300 px-1.5 py-px text-[0.6875rem] leading-4 font-medium tracking-wider text-zinc-600 transition-colors hover:border-accent-600 hover:text-accent-700 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-400 dark:hover:text-accent-400"
              >
                <span aria-hidden="true">{translation.short}</span>
                <span class="sr-only">{translation.label}</span>
              </a>
            ))}
          </p>
          <Heading class="mt-2 font-serif text-xl leading-snug font-medium tracking-tight text-balance text-zinc-900 sm:text-[1.375rem] dark:text-zinc-100">
            <a
              href={href}
              hreflang={lang}
              lang={lang}
              class="rounded-sm transition-colors group-hover:text-accent-700 after:absolute after:-inset-y-3 after:inset-x-0 dark:group-hover:text-accent-400"
            >
              {post.data.title}
              <span
                aria-hidden="true"
                class="ms-1 inline-block text-accent-700 opacity-0 transition duration-200 group-hover:translate-x-1 group-hover:opacity-100 dark:text-accent-400"
              >
                →
              </span>
            </a>
          </Heading>
          {showDescription && (
            <p lang={lang} class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-zinc-600 dark:text-zinc-400">
              {post.data.description}
            </p>
          )}
          {/* Tags are words in the post's language; the list's label is interface text. */}
          {showTags && post.data.tags.length > 0 && (
            <ul aria-label={t.labels.tags} class="mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <li lang={lang}>
                  <Tag label={tag} />
                </li>
              ))}
            </ul>
          )}
        </article>
      </li>
    ))
  }
</ul>
