---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import TagList from './TagList.astro';
import { isInternalHref, type Project } from '../../utils/content';

interface Props {
  project: Project;
  /** Heading level used for the card title. */
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h2' } = Astro.props;
const { title, shortDescription, techStack, isOpenSource, repositoryUrl, liveUrl } = project.data;
const href = `/projects/${project.id}/`;
const liveIsInternal = liveUrl ? isInternalHref(liveUrl) : false;

const cardLink =
  'relative z-10 -mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-emerald-700 hover:text-emerald-800 hover:underline dark:text-emerald-400 dark:hover:text-emerald-300';
---

{/*
  "Stretched link" pattern: the title link covers the whole card via ::after,
  and the live/repository links sit above it (relative z-10). No nested <a> elements.
*/}
<article
  class="group relative flex h-full flex-col gap-4 rounded-xl border border-zinc-200 bg-white p-5 transition-colors hover:border-zinc-300 sm:p-6 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
>
  <div class="flex items-start justify-between gap-3">
    <Heading class="min-w-0 text-lg leading-snug font-semibold text-zinc-900 dark:text-zinc-100">
      <a
        href={href}
        class="rounded-sm group-hover:text-emerald-700 after:absolute after:inset-0 after:rounded-xl dark:group-hover:text-emerald-400"
      >
        {title}
      </a>
    </Heading>
    {isOpenSource ? <Badge variant="accent">Open source</Badge> : <Badge>Private</Badge>}
  </div>

  <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{shortDescription}</p>

  <TagList items={techStack} label="Tech stack" class="mt-auto" />

  {
    (liveUrl || repositoryUrl) && (
      <div class="-mb-2 flex flex-wrap gap-x-4">
        {liveUrl &&
          (liveIsInternal ? (
            <a href={liveUrl} class={cardLink}>
              Open
              <Icon name="arrow-right" class="size-4" />
              <span class="sr-only">{title}</span>
            </a>
          ) : (
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class={cardLink}>
              Live site
              <Icon name="external" class="size-4" />
              <span class="sr-only">of {title} (opens in a new tab)</span>
            </a>
          ))}
        {repositoryUrl && (
          <a href={repositoryUrl} target="_blank" rel="noopener noreferrer" class={cardLink}>
            Repository
            <Icon name="external" class="size-4" />
            <span class="sr-only">for {title} (opens in a new tab)</span>
          </a>
        )}
      </div>
    )
  }
</article>
