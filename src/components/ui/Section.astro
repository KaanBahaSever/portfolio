---
/**
 * A titled page section (<section> + <h2>) with an optional mono index ("§ 02") and an
 * optional "see all" link. The index is decorative (aria-hidden).
 */
import { ui } from './styles';

interface Props {
  /** Section id (also the fragment for in-page links); the heading gets `${id}-heading`. */
  id: string;
  title: string;
  /** Two-digit section number shown before the title, e.g. '02'. */
  index?: string;
  link?: { href: string; label: string };
  class?: string;
}

const { id, title, index, link, class: className } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class:list={['mt-16 sm:mt-24', className]}>
  <div
    class="flex min-h-11 flex-wrap items-end justify-between gap-x-4 gap-y-1 border-b border-zinc-200 pb-3 dark:border-zinc-800"
  >
    <h2 id={headingId} class="flex items-baseline gap-3 font-serif text-2xl font-medium tracking-tight sm:text-3xl">
      {index && <span class="label-mono text-accent-700 dark:text-accent-400" aria-hidden="true">§ {index}</span>}
      <span>{title}</span>
    </h2>
    {
      link && (
        <a href={link.href} class={ui.accentLink}>
          {link.label}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  <div class="mt-6 sm:mt-8">
    <slot />
  </div>
</section>
