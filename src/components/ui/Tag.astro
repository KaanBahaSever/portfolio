---
/**
 * Neutral chip for tags and tech-stack items, in mono: names such as "gRPC" or "C++" keep their
 * exact spelling (no uppercase transform).
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="inline-flex items-center rounded-md bg-zinc-50 px-2 py-1 font-mono text-xs leading-none text-zinc-700 ring-1 ring-zinc-200 ring-inset dark:bg-zinc-900 dark:text-zinc-300 dark:ring-zinc-700/70"
>
  {label}
</span>
