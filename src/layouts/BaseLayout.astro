---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Use a wider content column (max-w-5xl) for grids and tools. */
  wide?: boolean;
}

const { title, description = SITE.description, wide = false } = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
// Canonical/og:url need an absolute origin: only emitted once `site` is set in astro.config.mjs.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-lg bg-emerald-700 px-4 py-3 text-sm font-medium text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 dark:bg-emerald-500 dark:text-zinc-950"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class:list={['px-safe mx-auto w-full flex-1 py-8 sm:py-12', wide ? 'max-w-5xl' : 'max-w-3xl']}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
