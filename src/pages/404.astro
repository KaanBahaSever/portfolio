---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="flex flex-col items-start pt-6 sm:pt-12">
    <p class="font-mono text-sm font-medium text-emerald-700 dark:text-emerald-400">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      Sorry, this page doesn't exist or has moved. Let's get you back on track.
    </p>
    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-lg bg-emerald-700 px-6 text-base font-semibold text-white hover:bg-emerald-800 dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400"
      >
        Go to the homepage
      </a>
      <a
        href="/tools/"
        class="inline-flex min-h-12 items-center justify-center rounded-lg border border-zinc-200 bg-white px-6 text-base font-medium text-zinc-900 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
      >
        Browse tools
      </a>
    </div>
  </section>
</BaseLayout>
