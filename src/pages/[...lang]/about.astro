---
/**
 * About: who I am (intro and key facts), the engineering journey in five chapters (#journey,
 * linked from the home page), then the dated milestones beside a résumé card.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Section from '../../components/ui/Section.astro';
import AtAGlance from '../../components/about/AtAGlance.astro';
import Journey from '../../components/about/Journey.astro';
import ResumeAside from '../../components/about/ResumeAside.astro';
import Timeline from '../../components/about/Timeline.astro';
import Intro from '../../components/about/prose/Intro.astro';
import { aboutMessages } from '../../i18n/messages/about';
import { getLocale, localeStaticPaths } from '../../i18n/server';
import { getTimeline } from '../../utils/content';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const m = aboutMessages[locale];
const entries = await getTimeline(locale);
---

<BaseLayout title={m.meta.title} description={m.meta.description} width="wide">
  <PageHeader eyebrow={m.header.eyebrow} title={m.header.title}>
    <Intro />
  </PageHeader>

  <AtAGlance />

  <Journey index="01" />

  {/* On wide screens the résumé card sits beside the milestones and stays in view (sticky). */}
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14 xl:grid-cols-[minmax(0,1fr)_22rem]">
    {
      entries.length > 0 && (
        <Section id="milestones" title={m.milestones.title} index="02">
          <p class="mb-8 max-w-2xl text-base leading-7 text-zinc-600 sm:mb-10 dark:text-zinc-400">
            {m.milestones.intro}
          </p>
          <Timeline entries={entries} />
        </Section>
      )
    }
    <div class="mt-16 sm:mt-24">
      <ResumeAside class="lg:sticky lg:top-24" />
    </div>
  </div>
</BaseLayout>
