---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsolePrefs from '../../components/console/ConsolePrefs.astro';
import Terminal from '../../components/console/Terminal.astro';
import { SITE } from '../../config/site';
import { GAMES } from '../../data/games';
import { consoleContent } from '../../i18n/console/content';
import { consoleMessages } from '../../i18n/console/messages';
import { pick } from '../../i18n/config';
import { getLocale, localeStaticPaths } from '../../i18n/server';
import { buildConsoleData } from '../../lib/console/data';
import { getProjects } from '../../utils/content';

export const getStaticPaths = () => localeStaticPaths();

// Reached from the header's terminal button. Kept out of search engines with a robots meta tag
// (noindex below) and an X-Robots-Tag header (public/_headers): it repeats content that is
// indexed elsewhere on the site.
const locale = getLocale(Astro);
const m = consoleMessages[locale];

// Everything the console can show is built here, at build time, in this page's language.
const projects = await getProjects(locale);
const data = buildConsoleData({
  locale,
  copy: consoleContent[locale],
  projects: projects.map(({ id, data: project, lang }) => ({
    id,
    title: project.title,
    summary: project.shortDescription,
    lang,
    stack: project.techStack,
    isOpenSource: project.isOpenSource,
    stage: project.stage,
    since: project.since,
    liveUrl: project.liveUrl,
    repositoryUrl: project.repositoryUrl,
  })),
  games: GAMES.map((game) => ({
    title: pick(game.title, locale),
    algorithm: pick(game.algorithm, locale),
    href: game.href,
  })),
  contact: {
    email: SITE.email,
    socials: SITE.socials,
    location: pick(SITE.location, locale),
    cvPath: SITE.cvPath,
  },
});
---

<BaseLayout title={m.title} description={m.description} noindex bare themeColor="#000000">
  <ConsolePrefs slot="head" />
  <Terminal data={data} />
</BaseLayout>
