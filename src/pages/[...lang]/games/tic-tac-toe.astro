---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import TicTacToe from '../../../components/games/TicTacToe.astro';
import TicTacToeGuide from '../../../components/games/TicTacToeGuide.astro';
import { GAMES } from '../../../data/games';
import { localizePath, pick } from '../../../i18n/config';
import { gamesHubMessages } from '../../../i18n/games/hub';
import { ticTacToeMessages } from '../../../i18n/games/tictactoe';
import { getLocale, localeStaticPaths } from '../../../i18n/server';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const m = ticTacToeMessages[locale];
const hub = gamesHubMessages[locale];
const game = GAMES.find((g) => g.slug === 'tic-tac-toe');
---

<BaseLayout title={m.meta.title} description={m.meta.description} width="wide">
  <PageHeader
    eyebrow={game ? pick(game.algorithm, locale) : undefined}
    title={game ? pick(game.title, locale) : m.meta.title}
    lead={m.lead}
    back={{ href: localizePath('/games/', locale), label: hub.backToGames }}
  />
  <TicTacToe />
  <TicTacToeGuide />
</BaseLayout>
