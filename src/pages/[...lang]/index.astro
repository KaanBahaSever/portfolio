---
/**
 * Home page (/ and /tr/): hero with Fig. 1, then numbered sections — experience, selected
 * work, the engineering-journey teaser, the playground, recent writing (only when there are
 * posts) and the rest of the résumé. Section numbers are assigned in order of the sections
 * actually shown, so hiding one never leaves a gap ("§ 04" is never followed by "§ 06").
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Background from '../../components/home/Background.astro';
import Hero from '../../components/home/Hero.astro';
import JourneyTeaser from '../../components/home/JourneyTeaser.astro';
import Playground from '../../components/home/Playground.astro';
import PostList from '../../components/ui/PostList.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import ResumeEntry from '../../components/ui/ResumeEntry.astro';
import Section from '../../components/ui/Section.astro';
import { SITE } from '../../config/site';
import { EDUCATION, EXPERIENCE, resumeText } from '../../data/resume';
import { localizePath, pick } from '../../i18n/config';
import { homeMessages } from '../../i18n/messages/home';
import { getLocale, localeStaticPaths } from '../../i18n/server';
import { getProjects, getPublishedPosts } from '../../utils/content';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const h = homeMessages[locale];
const featuredProjects = (await getProjects(locale)).filter((project) => project.data.featured);
const recentPosts = (await getPublishedPosts(locale)).slice(0, 3);

const shown = [
  'experience',
  featuredProjects.length > 0 && 'work',
  'journey',
  'playground',
  recentPosts.length > 0 && 'writing',
  'background',
].filter((id): id is string => Boolean(id));
const sectionIndex = (id: string) => String(shown.indexOf(id) + 1).padStart(2, '0');

// schema.org Person for search engines, in the page's language. `<` is escaped so the JSON can
// never close the <script> element early.
const school = EDUCATION[0];
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: new URL(localizePath('/', locale), SITE.url).href,
  description: pick(SITE.description, locale),
  jobTitle: h.person.jobTitle,
  email: `mailto:${SITE.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: locale === 'tr' ? 'İstanbul' : 'Istanbul',
    addressCountry: 'TR',
  },
  alumniOf: school && {
    '@type': 'CollegeOrUniversity',
    name: pick(school.institution, locale),
    url: school.url,
  },
  knowsAbout: h.person.knowsAbout,
  knowsLanguage: ['tr', 'en'],
  sameAs: SITE.socials.map((social) => social.href),
}).replace(/</g, '\\u003c');
---

<BaseLayout title={SITE.name} description={pick(SITE.description, locale)} width="wide">
  <script slot="head" type="application/ld+json" is:inline set:html={personJsonLd} />

  <Hero />

  <Section id="experience" index={sectionIndex('experience')} title={h.experience.title}>
    <ol class="max-w-4xl space-y-10">
      {
        EXPERIENCE.map((job) => (
          <li>
            <ResumeEntry
              title={pick(job.role, locale)}
              organization={resumeText(job.organization, locale)}
              href={job.url}
              details={job.location ? [pick(job.location, locale)] : []}
              period={job}
              summary={pick(job.summary, locale)}
              highlights={pick(job.highlights, locale)}
              tags={job.stack}
            />
          </li>
        ))
      }
    </ol>
  </Section>

  {
    featuredProjects.length > 0 && (
      <Section
        id="work"
        index={sectionIndex('work')}
        title={h.work.title}
        link={{ href: localizePath('/projects/', locale), label: h.work.all }}
      >
        <ul class="grid gap-4 sm:grid-cols-2">
          {featuredProjects.map((project) => (
            <li class="min-w-0">
              <ProjectCard project={project} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <JourneyTeaser index={sectionIndex('journey')} />

  <Playground index={sectionIndex('playground')} />

  {
    recentPosts.length > 0 && (
      <Section
        id="writing"
        index={sectionIndex('writing')}
        title={h.writing.title}
        link={{ href: localizePath('/blog/', locale), label: h.writing.all }}
      >
        <div class="max-w-3xl">
          <PostList posts={recentPosts} headingLevel="h3" />
        </div>
      </Section>
    )
  }

  <Background index={sectionIndex('background')} />
</BaseLayout>
