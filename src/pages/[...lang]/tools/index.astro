---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Icon from '../../../components/ui/Icon.astro';
import { TOOLS } from '../../../data/tools';
import { localizePath, pick } from '../../../i18n/config';
import { getLocale, localeStaticPaths } from '../../../i18n/server';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);

// Ready tools first, then planned ones (stable within each group).
const tools = [...TOOLS].sort((a, b) => Number(a.status === 'planned') - Number(b.status === 'planned'));
---

<BaseLayout title="Tools" description="Small, privacy-friendly utilities that run entirely in your browser." wide>
  <header class="max-w-2xl pt-2 sm:pt-6">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Tools</h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      Small utilities for everyday tasks. No sign-up, no ads, no tracking.
    </p>
  </header>

  <aside
    aria-label="Privacy"
    class="mt-8 flex gap-3 rounded-xl border border-accent-600/20 bg-accent-50 p-4 text-sm leading-relaxed text-accent-900 sm:p-5 dark:border-accent-500/25 dark:bg-accent-500/10 dark:text-accent-200"
  >
    <Icon name="lock" class="mt-0.5 size-5 shrink-0" />
    <p>
      <strong class="font-semibold">Private by design.</strong> All tools run locally in your browser; your files and
      text never leave your device.
    </p>
  </aside>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      tools.map((tool) => (
        <li class="min-w-0">
          {tool.status === 'ready' ? (
            <a
              href={localizePath(tool.href, locale)}
              class="group flex h-full min-h-32 flex-col gap-2 rounded-xl border border-zinc-200 bg-white p-5 transition-colors hover:border-accent-600/40 sm:p-6 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-500/40"
            >
              <div class="flex items-center justify-between gap-3">
                <h2 class="min-w-0 text-lg font-semibold text-zinc-900 group-hover:text-accent-700 dark:text-zinc-100 dark:group-hover:text-accent-400">
                  {pick(tool.title, locale)}
                </h2>
                <Icon
                  name="arrow-right"
                  class="size-5 shrink-0 text-zinc-400 transition-transform group-hover:translate-x-0.5 group-hover:text-accent-600 dark:text-zinc-500 dark:group-hover:text-accent-400"
                />
              </div>
              <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{pick(tool.description, locale)}</p>
            </a>
          ) : (
            <div class="flex h-full min-h-32 flex-col gap-2 rounded-xl border border-dashed border-zinc-200 bg-zinc-50 p-5 sm:p-6 dark:border-zinc-800 dark:bg-zinc-950">
              <div class="flex items-center justify-between gap-3">
                <h2 class="min-w-0 text-lg font-semibold text-zinc-600 dark:text-zinc-400">{pick(tool.title, locale)}</h2>
                <Badge>Coming soon</Badge>
              </div>
              <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{pick(tool.description, locale)}</p>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
