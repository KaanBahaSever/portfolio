---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrivacyNote from '../../../components/tools-index/PrivacyNote.astro';
import ToolCard from '../../../components/tools-index/ToolCard.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { TOOLS } from '../../../data/tools';
import { getLocale, localeStaticPaths } from '../../../i18n/server';
import { toolsIndexMessages } from '../../../i18n/tools/index';

export const getStaticPaths = () => localeStaticPaths();

const m = toolsIndexMessages[getLocale(Astro)];

// Ready tools first, then planned ones (stable within each group).
const tools = [...TOOLS].sort((a, b) => Number(a.status === 'planned') - Number(b.status === 'planned'));
const readyCount = tools.filter((tool) => tool.status === 'ready').length;
---

<BaseLayout title={m.title} description={m.description} width="wide">
  <PageHeader eyebrow={m.eyebrow(readyCount)} title={m.title} lead={m.lead} />

  <PrivacyNote />

  <ul aria-label={m.listLabel} class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      tools.map((tool, index) => (
        <li class="min-w-0">
          <ToolCard tool={tool} index={index + 1} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
