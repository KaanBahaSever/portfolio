---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Notepad from '../../../components/tools/Notepad.astro';
import Icon from '../../../components/ui/Icon.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { ui } from '../../../components/ui/styles';
import { localizePath } from '../../../i18n/config';
import { common } from '../../../i18n/messages/common';
import { getLocale, localeStaticPaths } from '../../../i18n/server';
import { notepadMessages } from '../../../i18n/tools/notepad';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const m = notepadMessages[locale];
const t = common[locale];

// The tips are prose with inline markup, so each language has its own markup below.
const kbd = ui.kbd;
const code = ui.code;
const strong = 'font-medium text-zinc-900 dark:text-zinc-100';
const heading = 'font-serif text-lg font-medium tracking-tight text-zinc-900 dark:text-zinc-100';
const list = 'mt-2 flex list-disc flex-col gap-2 pl-5 marker:text-zinc-400 dark:marker:text-zinc-600';
---

<BaseLayout title={m.page.title} description={m.page.description} width="full">
  {/* The title and the whole tool window fill the first screen; the tips follow below. */}
  <div class="np-page flex flex-col">
    <PageHeader
      title={m.page.title}
      lead={m.page.lead}
      back={{ href: localizePath('/tools/', locale), label: t.nav.tools }}
    />
    <Notepad class="mt-4 grow sm:mt-5" />
  </div>

  <details class="group/tips mt-8 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
    <summary
      class="flex min-h-12 list-none items-center justify-between gap-3 rounded-xl px-4 font-serif text-lg font-medium tracking-tight sm:px-5 [&::-webkit-details-marker]:hidden"
    >
      {m.page.tips}
      <Icon
        name="chevron-down"
        class="size-5 shrink-0 text-zinc-500 transition-transform group-open/tips:rotate-180"
      />
    </summary>
    <div
      class="grid gap-x-12 gap-y-8 border-t border-zinc-200 px-4 py-6 text-sm leading-relaxed text-zinc-600 sm:px-5 lg:grid-cols-2 dark:border-zinc-800 dark:text-zinc-400"
    >
      {
        locale === 'tr' ? (
          <>
            <section>
              <h2 class={heading}>Metniniz bu tarayıcıda kalır</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>Otomatik kayıt</strong>, yazmayı bıraktıktan kısa bir süre sonra metni, dosya
                  adını ve satır sonu seçimini bu tarayıcının yerel depolamasına (localStorage) kaydeder. Sayfayı
                  yenilediğinizde ya da daha sonra döndüğünüzde metniniz yerinde olur. Hiçbir şey yüklenmez, hiçbir yere
                  gönderilmez.
                </li>
                <li>
                  Kopya yalnızca bu cihazdaki bu tarayıcıda durur. Gizli pencere kapatıldığında kopyayı unutur; bu sitenin
                  verilerini temizlemek de kopyayı siler.
                </li>
                <li>
                  Ortak kullanılan bir bilgisayarda işiniz bitince <strong class={strong}>Temizle</strong> düğmesine basın
                  ya da durum çubuğundaki <strong class={strong}>Otomatik kayıt</strong> anahtarını kapatın; ikisi de
                  kayıtlı kopyayı siler.
                </li>
                <li>
                  Çok uzun metinler tarayıcının depolama alanına sığmayabilir. Durum çubuğu bunu bildirir;{' '}
                  <strong class={strong}>İndir</strong> ile metni yine de dosya olarak kaydedebilirsiniz.
                </li>
                <li>Not defteri iki sekmede açıksa, boşta bekleyen sekme diğerinde yazdıklarınızı alır.</li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Dosyalar</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>İndir</strong>, metni dosya adı alanındaki adla ve dilediğiniz uzantıyla kaydeder:{' '}
                  <code class={code}>notlar.txt</code>, <code class={code}>README.md</code>,{' '}
                  <code class={code}>veri.json</code>. Uzantısız adlara <code class={code}>.txt</code> eklenir.
                </li>
                <li>
                  Satır sonu olarak CRLF bekleyen Windows programları için durum çubuğunda{' '}
                  <strong class={strong}>CRLF</strong>’yi seçin; CRLF kullanan bir dosya açtığınızda bu ayar
                  kendiliğinden seçilir.
                </li>
                <li>
                  <strong class={strong}>Aç</strong>, en fazla 20 MB boyutundaki UTF-8 ya da UTF-16 metin dosyalarını
                  okur. Dosyayı düzenleyicinin üzerine sürükleyip bırakabilirsiniz de.
                </li>
                <li>
                  <strong class={strong}>Temizle</strong> metni, dosya adını ve kayıtlı kopyayı silerek baştan başlar.
                  Önce onayınızı ister; hemen ardından <strong class={strong}>Geri al</strong> ile her şeyi geri
                  getirebilirsiniz.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Odak modu</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>Odak modu</strong> ekranı yalnızca metne ayırır: araç çubuğu gizlenir, sade bir
                  durum satırında satır ve kelime sayısı görünmeye devam eder. Tarayıcı izin veriyorsa tam ekrana da
                  geçer.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>Enter</kbd> (Mac’te{' '}
                  <kbd class={kbd}>⌘</kbd> + <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>Return</kbd>) odak modunu
                  sayfanın her yerinden açıp kapatır. Bu birleşimi tarayıcılar ve ekran okuyucular kullanmaz ve hiçbir
                  klavye düzeninde bir karakter yazmaz; <kbd class={kbd}>F11</kbd> de tarayıcınızın kendi tam ekran tuşu
                  olarak kalır.
                </li>
                <li>
                  <kbd class={kbd}>Esc</kbd> tuşu odak modunu kapatır. Bul paneli açıksa ilk <kbd class={kbd}>Esc</kbd>{' '}
                  paneli, ikincisi odak modunu kapatır.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Klavye kısayolları</h2>
              <ul class={list}>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>F</kbd> (Mac’te <kbd class={kbd}>⌘</kbd> +{' '}
                  <kbd class={kbd}>F</kbd>): bul. Seçili bir kelime aranan metin olur.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>H</kbd> (Mac’te <kbd class={kbd}>⌘</kbd> +{' '}
                  <kbd class={kbd}>⌥</kbd> + <kbd class={kbd}>F</kbd>): bul ve değiştir.
                </li>
                <li>
                  Arama alanında <kbd class={kbd}>Enter</kbd> / <kbd class={kbd}>Shift</kbd> +{' '}
                  <kbd class={kbd}>Enter</kbd>, <kbd class={kbd}>F3</kbd> / <kbd class={kbd}>Shift</kbd> +{' '}
                  <kbd class={kbd}>F3</kbd> ya da{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>G</kbd> / <kbd class={kbd}>Shift</kbd> +{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>G</kbd>: sonraki / önceki eşleşme.
                </li>
                <li>
                  Yeni metin alanında <kbd class={kbd}>Enter</kbd> geçerli eşleşmeyi değiştirir,{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Enter</kbd> tümünü değiştirir.{' '}
                  <kbd class={kbd}>Esc</kbd> paneli kapatıp metne döner.
                </li>
                <li>
                  Panel açıkken <kbd class={kbd}>Alt</kbd> + <kbd class={kbd}>C</kbd>, <kbd class={kbd}>W</kbd>,{' '}
                  <kbd class={kbd}>R</kbd>: büyük/küçük harf duyarlılığı, tam kelime, düzenli ifade. Mac’te{' '}
                  <kbd class={kbd}>⌥</kbd> + harf, panel düğmelerinden biri odaktayken çalışır; böylece arama alanlarına ç
                  gibi karakterler yazılabilir.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>S</kbd>: indir. <kbd class={kbd}>Ctrl</kbd> +{' '}
                  <kbd class={kbd}>O</kbd>: dosya aç.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Z</kbd> yazdıklarınızı, tek tek yapılan değiştirmeleri ve
                  temizlemeyi (dosya adıyla birlikte) geri alır. Tümünü değiştir ya da Temizle sonrasında hemen beliren{' '}
                  <strong class={strong}>Geri al</strong> düğmesi uzun metinlerde de çalışır.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Düzenli ifadeler</h2>
              <p class="mt-2">
                JavaScript düzenli ifadeleriyle aramak için <code class={code}>.*</code> seçeneğini açın. Birkaç örnek:
              </p>
              <ul class={list}>
                <li>
                  <code class={code}>\d+</code> — art arda gelen rakamlar.
                </li>
                <li>
                  <code class={code}>^[ \t]+$</code> — yalnızca boşluk ya da sekme içeren satırlar (<code class={code}>^$</code>{' '}
                  açıkken).
                </li>
                <li>
                  <code class={code}>[ \t]+$</code> — satır sonlarındaki boşluk ve sekmeler; silmek için yeni metni boş
                  bırakın.
                </li>
                <li>
                  <code class={code}>kitap(lar)?</code> — “kitap” ya da “kitaplar”.
                </li>
                <li>
                  <code class={code}>\p&#123;Lu&#125;\p&#123;Ll&#125;+</code> — Türkçe dahil her dilde büyük harfle
                  başlayan kelimeler (Çağrı, İstanbul).
                </li>
                <li>
                  <code class={code}>^</code> ve yeni metin olarak <code class={code}>&gt; </code> — her satırın başına
                  bir önek ekler.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Değiştirme kalıpları</h2>
              <p class="mt-2">Düzenli ifade modunda yeni metin, bulunan metne başvurabilir:</p>
              <ul class={list}>
                <li>
                  <code class={code}>$&amp;</code> — eşleşmenin tamamı; ör. <code class={code}>"$&amp;"</code> onu
                  tırnak içine alır.
                </li>
                <li>
                  <code class={code}>$1</code>, <code class={code}>$2</code>… — yakalama grupları.{' '}
                  <code class={code}>(\w+) (\w+)</code> arayıp <code class={code}>$2, $1</code> ile değiştirirseniz “Ada
                  Lovelace”, “Lovelace, Ada” olur.
                </li>
                <li>
                  <code class={code}>$&lt;ad&gt;</code> — <code class={code}>(?&lt;yıl&gt;\d&#123;4&#125;)</code> gibi
                  adlandırılmış bir grup.
                </li>
                <li>
                  <code class={code}>$`</code> ve <code class={code}>$'</code> — eşleşmeden önceki ve sonraki metin;{' '}
                  <code class={code}>$$</code> — dolar işaretinin kendisi.
                </li>
                <li>Düzenli ifade kapalıyken yeni metin, dolar işaretleri dahil, yazdığınız gibi eklenir.</li>
              </ul>
            </section>
          </>
        ) : (
          <>
            <section>
              <h2 class={heading}>Your text stays in this browser</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>Autosave</strong> keeps the text, its file name and the line-ending choice in this
                  browser’s local storage, a moment after you stop typing. Reload the page or come back later and it is
                  still here. Nothing is uploaded or sent anywhere.
                </li>
                <li>
                  The copy exists only in this browser on this device. A private window forgets it when you close the
                  window, and clearing this site’s data removes it.
                </li>
                <li>
                  On a shared computer, press <strong class={strong}>Clear</strong> when you’re done, or switch{' '}
                  <strong class={strong}>Autosave</strong> off in the status bar: both remove the stored copy.
                </li>
                <li>
                  Very long texts may not fit in the browser’s storage. The status bar tells you when that happens, and{' '}
                  <strong class={strong}>Download</strong> still saves them as a file.
                </li>
                <li>With the notepad open in two tabs, an idle tab picks up what you type in the other one.</li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Files</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>Download</strong> saves the text under the name in the file name field, with any
                  extension: <code class={code}>notes.txt</code>, <code class={code}>README.md</code>,{' '}
                  <code class={code}>data.json</code>. Names without an extension get <code class={code}>.txt</code>.
                </li>
                <li>
                  Choose <strong class={strong}>CRLF</strong> in the status bar for Windows programs that expect it;
                  opening a CRLF file selects it for you.
                </li>
                <li>
                  <strong class={strong}>Open</strong> reads UTF-8 and UTF-16 text files of up to 20 MB. You can also drop
                  a file onto the editor.
                </li>
                <li>
                  <strong class={strong}>Clear</strong> starts over: it removes the text, its file name and the stored
                  copy. It asks first, and <strong class={strong}>Undo</strong> brings everything back right afterwards.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Zen mode</h2>
              <ul class={list}>
                <li>
                  <strong class={strong}>Zen mode</strong> gives the whole screen to the text: the toolbar steps aside and
                  a quiet status line keeps the line and word counts. Where the browser allows it, the page also goes
                  full screen.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>Enter</kbd>{' '}
                  (<kbd class={kbd}>⌘</kbd> + <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>Return</kbd> on a Mac) turns
                  it on and off from anywhere on the page. Browsers and screen readers leave this combination alone, it
                  never types a character on any keyboard layout, and <kbd class={kbd}>F11</kbd> stays your browser’s own
                  full screen.
                </li>
                <li>
                  <kbd class={kbd}>Esc</kbd> leaves zen mode. With the find panel open, the first{' '}
                  <kbd class={kbd}>Esc</kbd> closes the panel and the second leaves zen mode.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Keyboard shortcuts</h2>
              <ul class={list}>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>F</kbd> (<kbd class={kbd}>⌘</kbd> +{' '}
                  <kbd class={kbd}>F</kbd> on a Mac): find. A selected word becomes the search.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>H</kbd> (<kbd class={kbd}>⌘</kbd> +{' '}
                  <kbd class={kbd}>⌥</kbd> + <kbd class={kbd}>F</kbd> on a Mac): find and replace.
                </li>
                <li>
                  <kbd class={kbd}>Enter</kbd> / <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>Enter</kbd> in the search
                  field, <kbd class={kbd}>F3</kbd> / <kbd class={kbd}>Shift</kbd> + <kbd class={kbd}>F3</kbd> or{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>G</kbd> / <kbd class={kbd}>Shift</kbd> +{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>G</kbd>: next / previous match.
                </li>
                <li>
                  <kbd class={kbd}>Enter</kbd> in the replace field replaces the current match;{' '}
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Enter</kbd> replaces all. <kbd class={kbd}>Esc</kbd>{' '}
                  closes the panel and returns to the text.
                </li>
                <li>
                  <kbd class={kbd}>Alt</kbd> + <kbd class={kbd}>C</kbd>, <kbd class={kbd}>W</kbd>,{' '}
                  <kbd class={kbd}>R</kbd> while in the panel: match case, whole word, regular expression. On a Mac,{' '}
                  <kbd class={kbd}>⌥</kbd> + the letter works while one of the panel’s buttons has focus, so you can
                  still type characters such as ç in the search fields.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>S</kbd>: download. <kbd class={kbd}>Ctrl</kbd> +{' '}
                  <kbd class={kbd}>O</kbd>: open a file.
                </li>
                <li>
                  <kbd class={kbd}>Ctrl</kbd> + <kbd class={kbd}>Z</kbd> undoes typing, single replacements and Clear
                  (file name included). The <strong class={strong}>Undo</strong> button that appears after Replace all
                  or Clear works for long texts too.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Regular expressions</h2>
              <p class="mt-2">
                Turn on <code class={code}>.*</code> to search with JavaScript regular expressions. Some examples:
              </p>
              <ul class={list}>
                <li>
                  <code class={code}>\d+</code> — any run of digits.
                </li>
                <li>
                  <code class={code}>^[ \t]+$</code> — lines that contain only spaces or tabs (with{' '}
                  <code class={code}>^$</code> on).
                </li>
                <li>
                  <code class={code}>[ \t]+$</code> — trailing spaces and tabs at the end of each line; replace with
                  nothing to remove them.
                </li>
                <li>
                  <code class={code}>colou?r</code> — “color” or “colour”.
                </li>
                <li>
                  <code class={code}>\p&#123;Lu&#125;\p&#123;Ll&#125;+</code> — capitalised words in any language,
                  including Turkish (Çağrı, İstanbul).
                </li>
                <li>
                  <code class={code}>^</code> with the replacement <code class={code}>&gt; </code> — adds a prefix to
                  every line.
                </li>
              </ul>
            </section>

            <section>
              <h2 class={heading}>Replacement patterns</h2>
              <p class="mt-2">In regular-expression mode the replacement can refer to what was found:</p>
              <ul class={list}>
                <li>
                  <code class={code}>$&amp;</code> — the whole match, e.g. <code class={code}>"$&amp;"</code> puts quotes
                  around it.
                </li>
                <li>
                  <code class={code}>$1</code>, <code class={code}>$2</code>… — capture groups. Find{' '}
                  <code class={code}>(\w+) (\w+)</code> and replace with <code class={code}>$2, $1</code> to turn “Ada
                  Lovelace” into “Lovelace, Ada”.
                </li>
                <li>
                  <code class={code}>$&lt;name&gt;</code> — a named group such as{' '}
                  <code class={code}>(?&lt;year&gt;\d&#123;4&#125;)</code>.
                </li>
                <li>
                  <code class={code}>$`</code> and <code class={code}>$'</code> — the text before and after the match;{' '}
                  <code class={code}>$$</code> — a literal dollar sign.
                </li>
                <li>Without regular expressions the replacement is inserted exactly as typed, dollar signs included.</li>
              </ul>
            </section>
          </>
        )
      }
    </div>
  </details>
</BaseLayout>

<style>
  /*
   * The title and the tool window share a column as tall as the first screen, and the window
   * (`grow`) takes whatever the title leaves, however the lead wraps. The numbers mirror
   * BaseLayout: the sticky site header (h-14 plus its 1px border, h-16 from sm) and main's top
   * padding (pt-8, pt-12 from sm), of which a tool page takes some back for the editor. The tail
   * is what follows the window inside the tool (gap-3 and the closed "More stats" row: min-h-11
   * plus its border): the column reaches that far past the fold, so the window itself ends just
   * above the bottom of the screen. The air under the window equals that gap, so no sliver of the
   * row below shows at the bottom edge. svh (the viewport with the browser bars shown) keeps the
   * height from jumping while mobile browsers slide their address bar; vh is the fallback.
   */
  .np-page {
    --site-top: calc(3.5rem + 1px);
    --main-top: 2rem;
    --pull: 1rem;
    --air: 0.75rem;
    --tail: calc(0.75rem + 2.75rem + 2px);
    margin-top: calc(-1 * var(--pull));
    min-height: calc(100vh - var(--site-top) - var(--main-top) + var(--pull) - var(--air) + var(--tail));
    min-height: calc(100svh - var(--site-top) - var(--main-top) + var(--pull) - var(--air) + var(--tail));
  }

  @media (width >= 40rem) {
    .np-page {
      --site-top: calc(4rem + 1px);
      --main-top: 3rem;
      --pull: 2rem;
    }
  }
</style>
