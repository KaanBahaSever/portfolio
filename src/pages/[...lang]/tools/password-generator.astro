---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PasswordGenerator from '../../../components/tools/PasswordGenerator.astro';
import ToolTips from '../../../components/tools-index/ToolTips.astro';
import type { ToolTip } from '../../../components/tools-index/types';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { localizePath, type Localized } from '../../../i18n/config';
import { common } from '../../../i18n/messages/common';
import { getLocale, localeStaticPaths } from '../../../i18n/server';
import { passwordMessages } from '../../../i18n/tools/password-generator';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const m = passwordMessages[locale];

// Page-only prose: kept here rather than in the catalogue, which also ships to the browser.
const tips: Localized<ToolTip[]> = {
  en: [
    {
      lead: 'Length matters most.',
      body: 'Every extra character multiplies the number of guesses needed, far more than adding symbols does. Aim for 16 characters or more; if a site rejects symbols, turn them off and make the password a few characters longer instead.',
    },
    {
      lead: 'Use a password manager.',
      body: 'It remembers a different password for every account, so each one can be long and random, and a leak on one site never exposes another.',
    },
    {
      lead: 'Typing it by hand?',
      body: `Turn on “${passwordMessages.en.lookAlikes.label}”. Digits are shown in green and symbols in grey to make reading easier.`,
    },
    {
      lead: 'Nothing is kept.',
      body: 'The password exists only in this tab: leaving or reloading the page makes a new one, so save it in your password manager before you go.',
    },
  ],
  tr: [
    {
      lead: 'En önemlisi uzunluk.',
      body: 'Her yeni karakter, parolayı bulmak için gereken tahmin sayısını katlar. Bunun etkisi sembol eklemekten çok daha büyüktür. En az 16 karakter kullanmaya çalışın. Bir site sembol kabul etmiyorsa sembolleri kapatın, parolayı da birkaç karakter uzatın.',
    },
    {
      lead: 'Bir parola yöneticisi kullanın.',
      body: 'Parola yöneticisi her hesabın ayrı parolasını sizin yerinize hatırlar. Böylece her parola uzun ve rastgele olabilir. Bir sitede sızıntı olsa bile diğer hesaplarınız tehlikeye girmez.',
    },
    {
      lead: 'Parolayı elle mi yazacaksınız?',
      body: `“${passwordMessages.tr.lookAlikes.label}” seçeneğini açın. Okumayı kolaylaştırmak için rakamlar yeşil, semboller gri gösterilir.`,
    },
    {
      lead: 'Hiçbir şey saklanmaz.',
      body: 'Parola yalnızca bu sekmede durur. Sayfadan ayrılır ya da sayfayı yenilerseniz yeni bir parola üretilir. Bu yüzden ayrılmadan önce parolayı parola yöneticinize kaydedin.',
    },
  ],
};
---

<BaseLayout title={m.title} description={m.description}>
  <PageHeader
    title={m.title}
    lead={m.lead}
    back={{ href: localizePath('/tools/', locale), label: common[locale].nav.tools }}
  />

  <PasswordGenerator />

  <ToolTips title={m.tipsTitle} tips={tips[locale]} />
</BaseLayout>
