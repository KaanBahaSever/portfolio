---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PdfCompress from '../../../components/tools/PdfCompress.astro';
import ToolTips from '../../../components/tools-index/ToolTips.astro';
import type { ToolTip } from '../../../components/tools-index/types';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { localizePath, type Locale, type Localized } from '../../../i18n/config';
import { formatters } from '../../../i18n/format';
import { common } from '../../../i18n/messages/common';
import { getLocale, localeStaticPaths } from '../../../i18n/server';
import { pdfCompressMessages } from '../../../i18n/tools/pdf-compress';
import { LEVELS, MIN_IMAGE_SAVING, type CompressionLevel } from '../../../lib/pdf/compress/plan.ts';

export const getStaticPaths = () => localeStaticPaths();

const locale = getLocale(Astro);
const m = pdfCompressMessages[locale];

// The figures come from the compression settings, so the tips cannot fall out of date.
const px = (l: Locale, level: CompressionLevel) => formatters(l).number(LEVELS[level].maxDimension);
const minSaving = (l: Locale) => formatters(l).percent(MIN_IMAGE_SAVING);
const names = (l: Locale) => pdfCompressMessages[l].levelNames;

// Page-only prose: kept here rather than in the catalogue, which also ships to the browser.
const tips: Localized<ToolTip[]> = {
  en: [
    {
      lead: 'How the levels work.',
      body: `${names('en').light} recompresses JPEG photos gently and only shrinks images larger than ${px('en', 'light')} pixels. ${names('en').balanced} reduces images to at most ${px('en', 'balanced')} pixels and also turns other large images, such as scans stored without compression, into JPEG. ${names('en').strong} goes down to ${px('en', 'strong')} pixels with stronger compression: good for email, but small print in scans can get harder to read.`,
    },
    {
      lead: 'Try another level.',
      body: `Each run starts again from your original file, so you can compare levels without choosing the file again. An image is only replaced when that makes it at least ${minSaving('en')} smaller.`,
    },
    {
      lead: 'Why text PDFs barely shrink.',
      body: 'Text, fonts and vector drawings are already stored compactly, and they are kept exactly as they are so the document looks the same. The tool can still remove unused data and duplicates, but most of the gain comes from images.',
    },
    {
      lead: 'Forms and signatures.',
      body: 'The compressed file is a new file, so digital signatures will no longer be valid. Fillable forms keep their fields, but check them before you send the file. Keep your original.',
    },
    {
      lead: 'Password-protected PDFs aren’t supported.',
      body: 'Remove the password or editing restrictions in a PDF app first.',
    },
    {
      lead: 'Large files on a phone.',
      body: 'Compressing needs several times the file’s size in memory. If the page reloads, close other tabs and apps, or use a computer.',
    },
  ],
  tr: [
    {
      lead: 'Düzeyler nasıl çalışır?',
      body: `${names('tr').light} düzey JPEG fotoğrafları hafifçe yeniden sıkıştırır ve yalnızca ${px('tr', 'light')} pikselden büyük görselleri küçültür. ${names('tr').balanced} düzey görselleri en fazla ${px('tr', 'balanced')} piksele indirir. Sıkıştırılmadan saklanmış taramalar gibi diğer büyük görselleri de JPEG’e çevirir. ${names('tr').strong} düzey görselleri ${px('tr', 'strong')} piksele kadar küçültür ve daha sıkı sıkıştırır. E-posta için uygundur, ama taramalardaki küçük yazılar zor okunabilir.`,
    },
    {
      lead: 'Başka bir düzey deneyin.',
      body: `Her sıkıştırma orijinal dosyanızdan başlar. Böylece dosyayı yeniden seçmeden düzeyleri karşılaştırabilirsiniz. Bir görsel ancak en az ${minSaving('tr')} küçülecekse değiştirilir.`,
    },
    {
      lead: 'Metin ağırlıklı PDF’ler neden pek küçülmez?',
      body: 'Metin, yazı tipleri ve vektör çizimler zaten az yer kaplar. Belge aynı görünsün diye bunlara hiç dokunulmaz. Araç yine de kullanılmayan verileri ve kopyaları temizleyebilir, ama asıl kazanç görsellerden gelir.',
    },
    {
      lead: 'Formlar ve imzalar.',
      body: 'Sıkıştırılmış dosya yeni bir dosyadır, bu yüzden içindeki dijital imzalar artık geçerli olmaz. Doldurulabilir formların alanları korunur, ama dosyayı göndermeden önce yine de kontrol edin. Orijinal dosyanızı saklayın.',
    },
    {
      lead: 'Parola korumalı PDF’ler desteklenmez.',
      body: 'Önce parolayı ya da düzenleme kısıtlamalarını bir PDF uygulamasında kaldırın.',
    },
    {
      lead: 'Telefonda büyük dosyalar.',
      body: 'Sıkıştırmak için dosya boyutunun birkaç katı bellek gerekir. Sayfa yeniden yüklenirse diğer sekmeleri ve uygulamaları kapatın ya da bilgisayar kullanın.',
    },
  ],
};
---

<BaseLayout title={m.title} description={m.description} width="wide">
  <PageHeader
    title={m.title}
    lead={m.lead}
    back={{ href: localizePath('/tools/', locale), label: common[locale].nav.tools }}
  />

  <PdfCompress />

  <ToolTips title={m.tipsTitle} tips={tips[locale]} columns={3} />
</BaseLayout>
