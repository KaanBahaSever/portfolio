---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PdfCompress from '../../../components/tools/PdfCompress.astro';
import { LEVELS } from '../../../lib/pdf/compress/plan.ts';
import { localeStaticPaths } from '../../../i18n/server';

export const getStaticPaths = () => localeStaticPaths();
---

<BaseLayout
  title="Compress PDF"
  description="Make a PDF smaller right in your browser by recompressing its images. Best for scans and photo-heavy files. Nothing is uploaded."
  wide
>
  <nav aria-label="Breadcrumb" class="pt-2 sm:pt-6">
    <a
      href="/tools/"
      class="-mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-accent-700 dark:text-zinc-400 dark:hover:text-accent-400"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Tools
    </a>
  </nav>

  <header class="mt-2 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Compress PDF</h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      Make a PDF smaller by recompressing its images. Everything is processed on your device — nothing is uploaded.
      Scans and photo-heavy PDFs shrink the most; text-only documents usually shrink very little.
    </p>
  </header>

  <PdfCompress />

  <details
    class="group mt-10 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
    <summary
      class="flex min-h-12 list-none items-center justify-between gap-3 rounded-xl px-4 text-base font-semibold sm:px-5 [&::-webkit-details-marker]:hidden"
    >
      Tips
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <ul
      class="flex list-disc flex-col gap-3 px-4 pb-5 pl-9 text-sm leading-relaxed text-zinc-600 sm:px-5 sm:pl-10 dark:text-zinc-400"
    >
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">How the levels work:</strong> Light recompresses
        JPEG photos gently and only shrinks images larger than {LEVELS.light.maxDimension} pixels. Balanced reduces
        images to at most {LEVELS.balanced.maxDimension} pixels and also turns other large images, such as scans stored
        without compression, into JPEG. Strong goes down to {LEVELS.strong.maxDimension} pixels with stronger
        compression: good for email, but small print in scans can get harder to read.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Try another level:</strong> each run starts again
        from your original file, so you can compare levels without choosing the file again. An image is only replaced
        when that makes it at least 10% smaller.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Why text PDFs barely shrink:</strong> text, fonts
        and vector drawings are already stored compactly, and they are kept exactly as they are so the document looks the
        same. The tool can still remove unused data and duplicates, but most of the gain comes from images.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Forms and signatures:</strong> the compressed file
        is a new file, so digital signatures will no longer be valid. Fillable forms keep their fields, but check them
        before you send the file. Keep your original.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Password-protected PDFs</strong> aren’t supported.
        Remove the password or editing restrictions in a PDF app first.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Large files on a phone:</strong> compressing needs
        several times the file’s size in memory. If the page reloads, close other tabs and apps, or use a computer.
      </li>
    </ul>
  </details>
</BaseLayout>
