---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PdfSplit from '../../../components/tools/PdfSplit.astro';
import { localeStaticPaths } from '../../../i18n/server';

export const getStaticPaths = () => localeStaticPaths();
---

<BaseLayout
  title="Split PDF"
  description="Extract pages from a PDF or split it into several files right in your browser. Page ranges, equal parts or one file per page. Nothing is uploaded."
  wide
>
  <nav aria-label="Breadcrumb" class="pt-2 sm:pt-6">
    <a
      href="/tools/"
      class="-mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-accent-700 dark:text-zinc-400 dark:hover:text-accent-400"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Tools
    </a>
  </nav>

  <header class="mt-2 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Split PDF</h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      Pull out the pages you need or split a PDF into several files. Everything is processed on your device — nothing
      is uploaded.
    </p>
  </header>

  <PdfSplit />

  <details
    class="group mt-10 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
    <summary
      class="flex min-h-12 list-none items-center justify-between gap-3 rounded-xl px-4 text-base font-semibold sm:px-5 [&::-webkit-details-marker]:hidden"
    >
      Tips
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <ul
      class="flex list-disc flex-col gap-3 px-4 pb-5 pl-9 text-sm leading-relaxed text-zinc-600 sm:px-5 sm:pl-10 dark:text-zinc-400"
    >
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Writing pages:</strong> separate pages and ranges
        with commas, like <span class="whitespace-nowrap">1-3, 5, 8-</span>. “8-” runs to the last page, “-4” starts at
        page 1, and “end” means the last page.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Reordering:</strong> “Extract pages” keeps the
        order you type, so “3, 1, 2” moves page 3 to the front and “10-1” reverses the pages.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Several files</strong> are downloaded together as
        one ZIP. Most phones and computers open ZIP files without extra apps.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">What isn’t kept:</strong> bookmarks, fillable form
        fields and links that jump to other pages. The pages themselves look the same, and web links still work.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Password-protected PDFs</strong> aren’t supported,
        including files that only restrict editing or printing. Open the file in a PDF app, save an unprotected copy,
        and split that instead.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Very large PDFs</strong> need a lot of memory. If
        the page reloads on a phone, try on a computer.
      </li>
    </ul>
  </details>
</BaseLayout>
