---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import Icon from '../../components/ui/Icon.astro';
import TagList from '../../components/ui/TagList.astro';
import { getPublishedPosts, type BlogPost } from '../../utils/content';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, heroImageAlt, relatedProject } = post.data;
const { Content } = await render(post);

// Resolve the project reference; skip it if it is a draft (no page exists in production).
const project = relatedProject ? await getEntry(relatedProject) : undefined;
if (relatedProject && !project) {
  throw new Error(
    `Post "${post.id}": relatedProject "${relatedProject.id}" does not exist in src/content/projects/`,
  );
}
const linkedProject = project && !(import.meta.env.PROD && project.data.draft) ? project : undefined;
---

<BaseLayout title={title} description={description}>
  <a
    href="/blog/"
    class="-mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-emerald-700 dark:text-zinc-400 dark:hover:text-emerald-400"
  >
    <Icon name="arrow-left" class="size-4" />
    All posts
  </a>

  <article class="mt-4">
    <header class="space-y-4">
      <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
      <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <span>Published <FormattedDate date={pubDate} /></span>
        {
          updatedDate && (
            <span>
              Updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
      <TagList items={tags} label="Tags" />
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="eager"
          class="mt-8 h-auto w-full rounded-xl border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900"
        />
      )
    }

    <div class="prose prose-zinc mt-8 max-w-none dark:prose-invert prose-a:text-emerald-700 dark:prose-a:text-emerald-400">
      <Content />
    </div>

    {
      linkedProject && (
        <aside
          aria-label="Related project"
          class="relative mt-12 rounded-xl border border-zinc-200 bg-white p-5 hover:border-zinc-300 sm:p-6 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
        >
          <p class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Related project</p>
          <p class="mt-1 text-lg font-semibold">
            <a
              href={`/projects/${linkedProject.id}/`}
              class="text-zinc-900 after:absolute after:inset-0 after:rounded-xl hover:text-emerald-700 dark:text-zinc-100 dark:hover:text-emerald-400"
            >
              {linkedProject.data.title}
            </a>
          </p>
          <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {linkedProject.data.shortDescription}
          </p>
        </aside>
      )
    }
  </article>

  <a
    href="/blog/"
    class="-mx-2 mt-10 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-emerald-700 dark:text-zinc-400 dark:hover:text-emerald-400"
  >
    <Icon name="arrow-left" class="size-4" />
    Back to all posts
  </a>
</BaseLayout>
