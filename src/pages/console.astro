---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../config/site';

// Hidden route: not linked anywhere, kept out of search engines with a robots meta tag
// (noindex below) and an X-Robots-Tag header (public/_headers).
const promptUser =
  SITE.name
    .toLowerCase()
    .replace(/ı/g, 'i') // dotless i has no decomposition
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '') // combining accents
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '') || 'guest';
---

<BaseLayout title="Console" description="An interactive console for exploring this site. Coming soon." noindex>
  <header class="pt-2 sm:pt-6">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Console</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      A small command-line way to explore this site is on its way.
    </p>
  </header>

  <figure class="mt-10">
    <div
      class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-sm dark:border-zinc-800"
      role="img"
      aria-label="Terminal preview: the console is coming soon."
    >
      <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-3" aria-hidden="true">
        <span class="size-3 rounded-full bg-zinc-700"></span>
        <span class="size-3 rounded-full bg-zinc-700"></span>
        <span class="size-3 rounded-full bg-zinc-700"></span>
        <span class="ms-2 truncate font-mono text-xs text-zinc-500">console</span>
      </div>
      <pre
        class="overflow-x-auto p-4 font-mono text-sm leading-relaxed text-zinc-300 sm:p-5"
        aria-hidden="true"><code><span class="text-emerald-400">{promptUser}@site</span>:<span class="text-zinc-500">~</span>$ help
Console is coming soon.
Try the tools in the meantime: /tools/
<span class="text-emerald-400">{promptUser}@site</span>:<span class="text-zinc-500">~</span>$ <span class="inline-block h-4 w-2 translate-y-0.5 bg-zinc-300 motion-safe:animate-pulse"></span></code></pre>
    </div>
    <figcaption class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
      Preview only: the console is not interactive yet.
    </figcaption>
  </figure>

  <a
    href="/tools/"
    class="mt-8 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 text-sm font-medium text-zinc-900 hover:bg-zinc-100 sm:w-auto dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
  >
    Browse the tools
    <Icon name="arrow-right" class="size-4" />
  </a>
</BaseLayout>
