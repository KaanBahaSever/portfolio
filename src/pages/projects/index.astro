---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { getProjects } from '../../utils/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Selected projects: open-source work and private client projects." wide>
  <header class="max-w-2xl pt-2 sm:pt-6">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      A selection of things I have built. Open-source projects link to their code; private ones describe the problem
      and the approach.
    </p>
  </header>

  {
    projects.length > 0 ? (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6">
        {projects.map((project) => (
          <li class="min-w-0">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-10 text-zinc-600 dark:text-zinc-400">No projects published yet.</p>
    )
  }
</BaseLayout>
