---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagesToPdf from '../../components/tools/ImagesToPdf.astro';
---

<BaseLayout
  title="Images to PDF"
  description="Combine photos and images into one PDF right in your browser. Reorder pages, pick a page size, download. Nothing is uploaded."
  wide
>
  <nav aria-label="Breadcrumb" class="pt-2 sm:pt-6">
    <a
      href="/tools/"
      class="-mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-emerald-700 dark:text-zinc-400 dark:hover:text-emerald-400"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Tools
    </a>
  </nav>

  <header class="mt-2 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Images to PDF</h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      Turn photos, scans and screenshots into a single PDF. Everything is processed on your device — nothing is
      uploaded.
    </p>
  </header>

  <ImagesToPdf />

  <details
    class="group mt-10 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
    <summary
      class="flex min-h-12 list-none items-center justify-between gap-3 rounded-xl px-4 text-base font-semibold sm:px-5 [&::-webkit-details-marker]:hidden"
    >
      Tips
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <ul
      class="flex list-disc flex-col gap-3 px-4 pb-5 pl-9 text-sm leading-relaxed text-zinc-600 sm:px-5 sm:pl-10 dark:text-zinc-400"
    >
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Reordering on a phone:</strong> press and hold a
        card for a moment, then drag it. A quick swipe scrolls the page as usual. The arrow buttons on each card move it
        one place at a time.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Original quality</strong> keeps the image data of
        JPEG photos unchanged, with no re-compression; camera metadata such as location is left out. Other formats are
        converted without visible loss.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Smaller file</strong> resizes images to at most
        2000 pixels and compresses them. Use it for email attachments, or if creating the PDF fails on a phone with many
        large photos.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">iPhone photos (HEIC):</strong> Safari converts them
        to JPEG automatically when you pick them from Photos. Other browsers may not read HEIC files; in that case set
        Settings → Camera → Formats → Most Compatible, or export the photos as JPEG first.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Fit to image</strong> makes every page the size of
        its image plus the chosen margin (set Margin to None for no border); A4 and US Letter keep all pages the same
        size.
      </li>
    </ul>
  </details>
</BaseLayout>
