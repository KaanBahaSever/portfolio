---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PasswordGenerator from '../../components/tools/PasswordGenerator.astro';
---

<BaseLayout
  title="Password generator"
  description="Generate strong, random passwords right in your browser with the Web Crypto API. Choose the length and character types; nothing is sent or stored."
>
  <nav aria-label="Breadcrumb" class="sm:pt-6">
    <a
      href="/tools/"
      class="-mx-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-zinc-600 hover:text-emerald-700 dark:text-zinc-400 dark:hover:text-emerald-400"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Tools
    </a>
  </nav>

  <header class="mt-1 max-w-2xl sm:mt-2">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Password generator</h1>
    <p class="mt-3 text-base leading-relaxed text-zinc-600 sm:mt-4 sm:text-lg dark:text-zinc-400">
      Strong, random passwords generated on your device with the Web Crypto API. They are never sent anywhere or
      stored.
    </p>
  </header>

  <PasswordGenerator />

  <details
    class="group mt-10 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
    <summary
      class="flex min-h-12 list-none items-center justify-between gap-3 rounded-xl px-4 text-base font-semibold sm:px-5 [&::-webkit-details-marker]:hidden"
    >
      Tips
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <ul
      class="flex list-disc flex-col gap-3 px-4 pb-5 pl-9 text-sm leading-relaxed text-zinc-600 sm:px-5 sm:pl-10 dark:text-zinc-400"
    >
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Length matters most.</strong> Every extra character
        multiplies the number of guesses needed, far more than adding symbols does. Aim for 16 characters or more; if a
        site rejects symbols, turn them off and make the password a few characters longer instead.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Use a password manager.</strong> It remembers a
        different password for every account, so each one can be long and random, and a leak on one site never unlocks
        another.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Typing it by hand?</strong> Turn on “Avoid
        look-alike characters”. Digits are shown in green and symbols in red to make reading easier.
      </li>
      <li>
        <strong class="font-medium text-zinc-900 dark:text-zinc-100">Nothing is kept.</strong> The password exists only in
        this tab: leaving or reloading the page makes a new one, so save it in your password manager before you go.
      </li>
    </ul>
  </details>
</BaseLayout>
